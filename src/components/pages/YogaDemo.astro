</style>

<script>
  // ------------------------------------------------------------------
  //  Tracé des figures à l'entrée dans le champ de vision
  // ------------------------------------------------------------------
  const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const postures = Array.from(document.querySelectorAll<HTMLElement>('[data-posture]'));

  if (postures.length > 0) {
    if (mouvementReduit || !('IntersectionObserver' in window)) {
      postures.forEach((p) => p.classList.add('est-dessinee'));
    } else {
      const observateur = new IntersectionObserver(
        (entrees) => {
          for (const entree of entrees) {
            if (entree.isIntersecting) {
              entree.target.classList.add('est-dessinee');
              observateur.unobserve(entree.target);
            }
          }
        },
        { threshold: 0.35 }
      );
      postures.forEach((p) => observateur.observe(p));
    }
  }

  // ------------------------------------------------------------------
  //  L'enchaînement : les postures s'éclairent l'une après l'autre
  // ------------------------------------------------------------------
  const bouton = document.querySelector<HTMLButtonElement>('[data-flow-bouton]');
  const liste = document.querySelector<HTMLElement>('[data-flow-liste]');
  const libelle = document.querySelector<HTMLElement>('[data-flow-libelle]');

  if (bouton && liste && libelle && postures.length > 0) {
    const texteLancer = libelle.textContent ?? '';
    const texteArreter = bouton.dataset.arreter ?? '';
    // Une posture toutes les 2,6 s : le temps d'un cycle respiratoire complet.
    const DUREE = 2600;
    let minuteur = 0;
    let index = 0;

    const eteindre = (): void => {
      postures.forEach((p) => p.classList.remove('est-active'));
    };

    const arreter = (): void => {
      window.clearInterval(minuteur);
      minuteur = 0;
      eteindre();
      liste.classList.remove('flow-en-cours');
      bouton.setAttribute('aria-pressed', 'false');
      libelle.textContent = texteLancer;
    };

    const avancer = (): void => {
      eteindre();
      postures[index].classList.add('est-active');
      index = (index + 1) % postures.length;
    };

    bouton.setAttribute('aria-pressed', 'false');

    bouton.addEventListener('click', () => {
      if (minuteur) {
        arreter();
        return;
      }
      index = 0;
      liste.classList.add('flow-en-cours');
      bouton.setAttribute('aria-pressed', 'true');
      if (texteArreter) libelle.textContent = texteArreter;
      avancer();
      minuteur = window.setInterval(avancer, DUREE);
    });

    // L'enchaînement s'arrête s'il sort de l'écran : inutile de faire
    // travailler la page pour une animation que personne ne regarde.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          if (minuteur && entrees.some((e) => !e.isIntersecting)) arreter();
        },
        { threshold: 0 }
      ).observe(liste);
    }
  }
</script>
