---
// Modèle « Souffle » — studio de yoga. Noir et blanc strict : le Yin et le
// Yang. Les sections alternent fond noir et fond blanc, et les photos sont
// désaturées en CSS pour que le parti pris tienne quelles que soient les
// images déposées.
import Base from '../../layouts/Base.astro';
import DemoBar from '../DemoBar.astro';
import MenuMobile from '../MenuMobile.astro';
import { splitPath, localePath } from '../../lib/i18n';
import { withBase } from '../../lib/paths';
import { common } from '../../i18n/common';
import { yoga } from '../../i18n/yoga';

const { lang } = splitPath(Astro.url.pathname);
const t = yoga[lang];
const c = common[lang];

const photo = (nom: string) => withBase(`modeles/yoga/${nom}`);

/**
 * Vidéos des postures, dans l'ordre de l'enchaînement défini par le
 * dictionnaire. Une case vide signifie « pas encore filmée » : la posture
 * n'apparaît alors pas sur la scène.
 *
 * Ajouter une posture = déposer la vidéo dans public/modeles/yoga/postures/
 * et renseigner son nom à la bonne place ci-dessous. Rien d'autre.
 */
const VIDEOS: (string | undefined)[] = [
  undefined,        // 1 · La Montagne
  'guerrier.mp4',   // 2 · Le Guerrier
  'triangle.mp4',   // 3 · Le Triangle
  undefined,        // 4 · Le Chien tête en bas
  undefined,        // 5 · La Pince assise
  'enfant.mp4',     // 6 · L'Enfant
  'cobra.mp4',      // 7 · Le Cobra
  undefined,        // 8 · Le Pont
];

/**
 * Seules les postures filmées sont montrées : mieux vaut quatre vidéos
 * abouties qu'un enchaînement à trous. La numérotation affichée suit donc
 * la scène, pas la table ci-dessus.
 */
const postures = t.flow.postures
  .map((p, i) => ({ ...p, video: VIDEOS[i] }))
  .filter((p): p is typeof p & { video: string } => Boolean(p.video));


const liensMenu = [
  { href: '#flow', label: t.nav.flow },
  { href: '#cours', label: t.nav.cours },
  { href: '#prof', label: t.nav.prof },
  { href: '#infos', label: t.nav.infos },
];
---

<Base title={t.title} description={t.description}>
  <DemoBar label={t.demoLabel} />
  <div class="yoga">
    <!-- ============================= EN-TÊTE ============================ -->
    <header class="y-header">
      <div class="y-wrap y-header-inner">
        <a class="y-logo" href="#haut" aria-label="Souffle">
          <svg class="y-taijitu" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path
              d="M20 1a9.5 9.5 0 0 0 0 19 9.5 9.5 0 0 1 0 19 19 19 0 0 0 0-38Z"
              fill="currentColor"
            />
            <circle cx="20" cy="10.5" r="2.4" fill="currentColor" />
            <circle cx="20" cy="29.5" r="2.4" fill="var(--y-noir)" />
          </svg>
          Souffle
        </a>
        <nav aria-label={lang === 'fr' ? 'Navigation du studio' : 'Studio navigation'}>
          <ul class="y-nav">
            <li><a href="#flow">{t.nav.flow}</a></li>
            <li><a href="#cours">{t.nav.cours}</a></li>
            <li><a href="#prof">{t.nav.prof}</a></li>
            <li><a href="#infos">{t.nav.infos}</a></li>
          </ul>
        </nav>
        <a class="y-btn y-btn-clair" href="#infos">{t.nav.cta}</a>
        <MenuMobile variante="yoga" lang={lang} liens={liensMenu} cta={{ href: '#infos', label: t.nav.cta }} />
      </div>
    </header>

    <main id="haut">
      <!-- ============================== HERO ============================= -->
      <section class="y-hero">
        <img class="y-hero-photo" src={photo('prof-1.webp')} alt="" width="1600" height="2136" />
        <div class="y-hero-voile" aria-hidden="true"></div>
        <div class="y-wrap y-hero-inner">
          <p class="y-kicker">{t.hero.kicker}</p>
          <h1 class="y-hero-titre">
            {t.hero.titleLine}<br /><em>{t.hero.titleEm}</em>
          </h1>
          <p class="y-hero-lede">{t.hero.lede}</p>
          <div class="y-hero-actions">
            <a class="y-btn y-btn-clair" href="#infos">{t.hero.ctaPrimaire}</a>
            <a class="y-btn y-btn-ligne" href="#flow">{t.hero.ctaSecondaire}</a>
          </div>
        </div>
        <span class="y-souffle" aria-hidden="true"></span>
      </section>

      <!-- ====================== BANDEAU YIN / YANG ====================== -->
      <section class="y-duo" aria-hidden="true">
        <div class="y-wrap y-duo-inner">
          {t.hero.duo.map((d) => (
            <p class="y-duo-paire">
              <span class="y-duo-yin">{d.yin}</span>
              <span class="y-duo-trait"></span>
              <span class="y-duo-yang">{d.yang}</span>
            </p>
          ))}
        </div>
      </section>

      <!-- ============================== FLOW ============================= -->
      <section id="flow" class="y-section y-section-noire">
        <div class="y-wrap">
          <div class="y-tete reveal">
            <p class="y-kicker">{t.flow.eyebrow}</p>
            <h2 class="y-titre">{t.flow.title}</h2>
            <p class="y-lede">{t.flow.lede}</p>
            <button
              class="y-btn y-btn-ligne y-flow-bouton"
              type="button"
              data-flow-bouton
              data-suspendre={t.flow.suspendre}
              data-reprendre={t.flow.reprendre}
              aria-pressed="true"
            >
              <span data-flow-libelle>{t.flow.suspendre}</span>
              <span class="y-flow-point" aria-hidden="true"></span>
            </button>
          </div>

          <div class="y-scene-bloc reveal" data-flow-liste>
            <!-- La scène : une seule posture montrée à la fois, en fondu. -->
            <div class="y-scene">
              {postures.map((p, i) => (
                <figure class="y-vue" data-vue data-index={i} aria-hidden={i === 0 ? undefined : 'true'}>
                  <video
                    class="y-vue-video"
                    data-video
                    src={photo(`postures/${p.video}`)}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={p.nom}
                  />
                  <figcaption class="y-vue-legende">
                    <span class="y-vue-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="y-vue-nom">{p.nom}</span>
                    <span class="y-vue-sanskrit">{p.sanskrit}</span>
                    <span class="y-vue-intention">{p.intention}</span>
                  </figcaption>
                </figure>
              ))}
            </div>

            <!-- L'enchaînement complet, cliquable. -->
            <ol class="y-sommaire">
              {postures.map((p, i) => (
                <li>
                  <button class="y-sommaire-item" type="button" data-choisir={i} aria-current={i === 0 ? 'true' : undefined}>
                    <span class="y-sommaire-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    <span class="y-sommaire-nom">{p.nom}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>

      <!-- ========================= BANDE PHOTO ========================== -->
      <section class="y-bande" aria-hidden="true">
        <img src={photo('prof-3.webp')} alt="" width="1600" height="2136" loading="lazy" decoding="async" />
      </section>

      <!-- ============================= COURS ============================= -->
      <section id="cours" class="y-section">
        <div class="y-wrap">
          <div class="y-tete reveal">
            <p class="y-kicker">{t.cours.eyebrow}</p>
            <h2 class="y-titre">{t.cours.title}</h2>
          </div>

          <div class="y-cours">
            {t.cours.items.map((co, i) => (
              <article class="y-cours-carte reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <h3 class="y-cours-nom">{co.nom}</h3>
                <p class="y-cours-meta">{co.duree} · {co.niveau}</p>
                <p class="y-cours-desc">{co.desc}</p>
              </article>
            ))}
          </div>

          <div class="y-horaires reveal">
            <h3 class="y-horaires-titre">{t.cours.horairesTitre}</h3>
            <table>
              <tbody>
                {t.cours.horaires.map((h) => (
                  <tr>
                    <th scope="row">{h.jour}</th>
                    <td>{h.cours}</td>
                    <td class="y-horaires-heure">{h.heure}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ============================== PROF ============================= -->
      <section id="prof" class="y-section y-section-noire">
        <div class="y-wrap y-prof">
          <div class="y-prof-photo reveal">
            <img src={photo('prof-2.webp')} alt="Léa Vasseur" width="1600" height="2136" loading="lazy" decoding="async" />
          </div>
          <div class="y-prof-texte reveal" style="--reveal-delay: 0.12s">
            <p class="y-kicker">{t.prof.eyebrow}</p>
            <h2 class="y-titre">{t.prof.title}</h2>
            <p class="y-lede">{t.prof.texte}</p>
            <blockquote class="y-citation">
              <p>{t.prof.citation}</p>
              <footer>{t.prof.signature}</footer>
            </blockquote>
          </div>
        </div>
      </section>

      <!-- ============================= INFOS ============================= -->
      <section id="infos" class="y-section">
        <div class="y-wrap">
          <div class="y-tete reveal">
            <p class="y-kicker">{t.infos.eyebrow}</p>
            <h2 class="y-titre">{t.infos.title}</h2>
          </div>

          <div class="y-infos">
            <div class="y-infos-bloc reveal">
              <h3>{t.infos.tarifsTitre}</h3>
              <ul class="y-tarifs">
                {t.infos.tarifs.map((tf) => (
                  <li><span>{tf.nom}</span><span class="y-tarifs-prix">{tf.prix}</span></li>
                ))}
              </ul>
            </div>

            <div class="y-infos-bloc reveal" style="--reveal-delay: 0.08s">
              <h3>{t.infos.lieuTitre}</h3>
              <p class="y-adresse">{t.infos.adresse}</p>
              <p class="y-infos-note">{t.infos.lieuNote}</p>
            </div>

            <div class="y-infos-bloc y-infos-contact reveal" style="--reveal-delay: 0.16s">
              <h3>{t.infos.contactTitre}</h3>
              <p class="y-infos-note">{t.infos.contactNote}</p>
              <a class="y-btn y-btn-sombre" href="tel:+33400000000">{t.infos.telephone}</a>
              <a class="y-lien" href={`mailto:${t.infos.email}`}>{t.infos.email}</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="y-footer">
      <div class="y-wrap y-footer-inner">
        <p>© 2026 Souffle — {t.footer.baseline}</p>
        <p>{c.demo.madeBy} <a href={localePath(lang, '')}>Atelier Web</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* ------------------------------------------------------------------ */
  /*  Palette : deux valeurs, rien d'autre. Le Yin et le Yang.           */
  /* ------------------------------------------------------------------ */

  .yoga {
    --y-noir: #0b0b0b;
    --y-noir-doux: #17171a;
    --y-blanc: #f6f5f2;
    --y-blanc-pur: #fff;
    /* Deux gris, pas un : le même ne peut pas être lisible à la fois sur
       blanc et sur noir. Celui-ci vaut pour les sections claires ; les
       sections sombres le redéfinissent plus bas. */
    --y-gris: #6b6b6b;
    --y-gris-clair: #c9c9c9;
    font-family: var(--font-sans);
    color: var(--y-noir);
    background: var(--y-blanc);
    letter-spacing: 0.01em;
  }

  .y-wrap {
    width: min(68rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  /* Toutes les photos passent en noir et blanc : le parti pris du modèle ne
     dépend pas des images fournies. */
  .yoga img {
    filter: grayscale(1) contrast(1.06);
  }

  /* ------------------------------- En-tête --------------------------- */

  .y-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(11 11 11 / 0.72);
    backdrop-filter: blur(14px);
    color: var(--y-blanc);
  }

  .y-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .y-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-decoration: none;
    color: inherit;
  }

  .y-taijitu {
    width: 1.5rem;
    height: 1.5rem;
    animation: y-tourne 24s linear infinite;
  }

  @keyframes y-tourne {
    to {
      transform: rotate(360deg);
    }
  }

  .y-header nav {
    margin-left: auto;
  }

  .y-nav {
    display: flex;
    gap: 1.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .y-nav a {
    text-decoration: none;
    color: var(--y-gris-clair);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    transition: color 0.3s;
  }

  .y-nav a:hover,
  .y-nav a[aria-current] {
    color: var(--y-blanc);
  }

  /* Pas de gras ici : le modèle vit de sa retenue. Une lettre plus espacée
     suffit à désigner la section courante. */
  .y-nav a[aria-current] {
    letter-spacing: 0.24em;
  }

  /* ------------------------------- Boutons --------------------------- */

  .y-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.4s,
      color 0.4s,
      border-color 0.4s,
      transform 0.4s var(--ease-out);
  }

  .y-btn:hover {
    transform: translateY(-2px);
  }

  .y-btn-clair {
    background: var(--y-blanc);
    color: var(--y-noir);
  }

  .y-btn-clair:hover {
    background: var(--y-blanc-pur);
  }

  .y-btn-sombre {
    background: var(--y-noir);
    color: var(--y-blanc);
  }

  .y-btn-ligne {
    border-color: currentColor;
    background: transparent;
    color: inherit;
  }

  .y-btn-ligne:hover {
    background: currentColor;
    /* Le texte prend la couleur du fond de la section : inversion Yin/Yang. */
    color: var(--y-noir);
  }

  .y-section-noire .y-btn-ligne:hover {
    color: var(--y-noir);
  }

  .y-lien {
    color: inherit;
    font-size: 0.95rem;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
    padding-bottom: 2px;
    transition: opacity 0.3s;
  }

  .y-lien:hover {
    opacity: 0.6;
  }

  /* -------------------------------- Hero ----------------------------- */

  .y-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(92vh, 46rem);
    padding-block: clamp(4rem, 10vw, 7rem);
    background: var(--y-noir);
    color: var(--y-blanc);
    overflow: hidden;
  }

  /* Sélecteur renforcé : `.yoga img` (deux composantes) l'emportait sur une
     simple classe et effaçait l'assombrissement — or le texte du hero repose
     sur cette photo. */
  .yoga img.y-hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 55 % et non 30 % : les photos étant en portrait dans un cadre large,
       seuls 39 % de la hauteur sont visibles — mesuré, le sujet se trouve
       autour de 58 %, pas dans le ciel. */
    object-position: 50% 55%;
    /* Contraste poussé : on cherche le tirage argentique, pas la photo. */
    filter: grayscale(1) contrast(1.15) brightness(0.72);
    animation: y-approche 24s ease-in-out infinite alternate;
  }

  @keyframes y-approche {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }

  .y-hero-voile {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(11 11 11 / 0.55) 0%,
      rgb(11 11 11 / 0.25) 40%,
      rgb(11 11 11 / 0.92) 100%
    );
  }

  .y-hero-inner {
    position: relative;
    max-width: 40rem;
  }

  .y-kicker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--y-gris);
  }

  .y-section-noire .y-kicker,
  .y-hero .y-kicker {
    color: var(--y-gris-clair);
  }

  .y-hero-titre {
    margin-top: 1.6rem;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .y-hero-titre em {
    font-style: italic;
    color: var(--y-gris-clair);
  }

  .y-hero-lede {
    margin-top: 1.6rem;
    max-width: 32rem;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--y-gris-clair);
  }

  .y-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.4rem;
  }

  /* Un trait qui monte et redescend, comme une respiration. */
  .y-souffle {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 4.5rem;
    background: linear-gradient(to bottom, transparent, var(--y-gris-clair));
    transform-origin: bottom;
    animation: y-respire 6s ease-in-out infinite;
  }

  @keyframes y-respire {
    0%,
    100% {
      transform: scaleY(0.3);
      opacity: 0.25;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.9;
    }
  }

  /* --------------------------- Bandeau Yin/Yang ----------------------- */

  .y-duo {
    background: var(--y-blanc);
    border-block: 1px solid rgb(11 11 11 / 0.12);
    padding-block: 1.6rem;
  }

  .y-duo-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }

  .y-duo-paire {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-serif);
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    letter-spacing: 0.06em;
  }

  .y-duo-yin {
    color: var(--y-noir);
  }

  .y-duo-yang {
    color: var(--y-gris);
    font-style: italic;
  }

  /* Le trait bascule doucement d'un côté à l'autre : l'équilibre n'est
     jamais figé. */
  .y-duo-trait {
    width: 2.5rem;
    height: 1px;
    background: var(--y-noir);
    opacity: 0.4;
    transform-origin: center;
    animation: y-bascule 8s ease-in-out infinite;
  }

  @keyframes y-bascule {
    0%,
    100% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(4deg);
    }
  }

  /* ------------------------------ Sections --------------------------- */

  .y-section {
    padding-block: clamp(4rem, 9vw, 7.5rem);
  }

  .y-section-noire,
  .y-hero,
  .y-header,
  .y-footer {
    /* Sur fond noir, le gris doit au contraire s'éclaircir pour rester
       lisible : 8:1 au lieu des 3:1 qu'aurait donné le gris clair. */
    --y-gris: #a5a5a5;
  }

  .y-section-noire {
    background: var(--y-noir);
    color: var(--y-blanc);
  }

  .y-tete {
    max-width: 42rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .y-titre {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 300;
    line-height: 1.12;
  }

  .y-lede {
    margin-top: 1.2rem;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--y-gris);
  }

  .y-section-noire .y-lede {
    color: var(--y-gris-clair);
  }

  /* ------------------------------ Postures --------------------------- */

  .y-flow-bouton {
    margin-top: 1.8rem;
  }

  .y-flow-point {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.35;
    transition: opacity 0.3s;
  }

  [data-flow-bouton][aria-pressed='true'] .y-flow-point {
    opacity: 1;
    animation: y-pulse 1.6s ease-in-out infinite;
  }

  @keyframes y-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  /* La scène et son sommaire : deux colonnes sur grand écran. */
  .y-scene-bloc {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .y-scene {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgb(246 245 242 / 0.18);
    background: var(--y-noir-doux);
  }

  /* Les vues se superposent et se relaient en fondu — aucun à-coup, comme
     le passage d'une posture à l'autre en cours. */
  .y-vue {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.9s ease,
      visibility 0.9s;
  }

  .y-vue.est-visible {
    opacity: 1;
    visibility: visible;
  }

  .y-vue-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Le noir et blanc s'applique aussi aux vidéos : le parti pris tient
       quelle que soit la source déposée. */
    filter: grayscale(1) contrast(1.08);
  }


  .y-vue-legende {
    position: absolute;
    left: 0;
