</style>

<script>
  // ------------------------------------------------------------------
  //  La scène : les vidéos des postures s'enchaînent d'elles-mêmes, en
  //  boucle. Chaque plan est joué jusqu'au bout, puis cède la place au
  //  suivant ; après la dernière, on revient à la première.
  // ------------------------------------------------------------------
  const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const vues = Array.from(document.querySelectorAll<HTMLElement>('[data-vue]'));
  const choix = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-choisir]'));
  const bloc = document.querySelector<HTMLElement>('[data-flow-liste]');
  const bouton = document.querySelector<HTMLButtonElement>('[data-flow-bouton]');
  const libelle = document.querySelector<HTMLElement>('[data-flow-libelle]');

  if (vues.length > 0 && bloc) {
    const texteSuspendre = bouton?.dataset.suspendre ?? '';
    const texteReprendre = bouton?.dataset.reprendre ?? '';

    let courante = 0;
    // Le mouvement réduit démarre en pause : on ne lance pas de vidéo à
    // quelqu'un qui a demandé moins d'animation, il la déclenchera s'il veut.
    let enPause = mouvementReduit;
    // On part du principe que la scène est visible : si l'observateur ne
    // répond pas (navigateur ancien, onglet non composité…), les vidéos
    // tournent au lieu de rester figées. L'observateur ne fait que mettre en
    // pause quand la section sort du champ — un repli qui échoue du bon côté.
    let aLEcran = true;

    const videoDe = (i: number): HTMLVideoElement | null =>
      vues[i]?.querySelector<HTMLVideoElement>('[data-video]') ?? null;

    const suivante = (): void => montrer((courante + 1) % vues.length);

    /** Lance la vidéo courante si les conditions sont réunies. */
    const jouer = (): void => {
      const video = videoDe(courante);
      if (!video || enPause || !aLEcran) return;
      // `play()` rejette si le navigateur refuse : on silence pour ne pas
      // polluer la console.
      void video.play().catch(() => {});
    };

    function montrer(i: number): void {
      const sortante = videoDe(courante);
      if (sortante) {
        sortante.pause();
        sortante.currentTime = 0;
      }

      courante = i;

      vues.forEach((v, n) => {
        const active = n === i;
        v.classList.toggle('est-visible', active);
        if (active) v.removeAttribute('aria-hidden');
        else v.setAttribute('aria-hidden', 'true');
      });

      choix.forEach((b, n) => {
        if (n === i) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });

      jouer();
    }

    // Chaque vidéo passe la main à la suivante. `loop` reste désactivé : c'est
    // l'enchaînement qui boucle, pas le plan.
    vues.forEach((_, i) => {
      const video = videoDe(i);
      if (!video) return;
      video.loop = false;
      video.addEventListener('ended', () => {
        // Seule la vidéo affichée a le droit de faire avancer la suite.
        if (i === courante) suivante();
      });
    });

    choix.forEach((b, i) => b.addEventListener('click', () => montrer(i)));

    const majBouton = (): void => {
      if (!bouton || !libelle) return;
      bouton.setAttribute('aria-pressed', enPause ? 'false' : 'true');
      libelle.textContent = enPause ? texteReprendre : texteSuspendre;
    };

    bouton?.addEventListener('click', () => {
      enPause = !enPause;
      if (enPause) videoDe(courante)?.pause();
      else jouer();
      majBouton();
    });

    majBouton();

    // Hors écran, rien ne tourne : ni décodage vidéo, ni bande passante.
    if ('IntersectionObserver' in window) {
      // L'observateur est conservé dans une variable : sans référence
      // retenue, il peut être ramassé par le GC et cesser de notifier.
      const veille = new IntersectionObserver(
        (entrees) => {
          aLEcran = entrees.some((e) => e.isIntersecting);
          if (aLEcran) jouer();
          else vues.forEach((_, i) => videoDe(i)?.pause());
        },
        { threshold: 0.25 }
      );
      veille.observe(bloc);
    } else {
      aLEcran = true;
      jouer();
    }

    montrer(0);
  }
</script>
