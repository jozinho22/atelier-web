---
// Gabarit bilingue de la page d'accueil — la langue est déduite de l'URL.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import AuroraBackdrop from '../AuroraBackdrop.astro';
import { withBase } from '../../lib/paths';
import { splitPath, localePath } from '../../lib/i18n';
import { home } from '../../i18n/home';

const { lang } = splitPath(Astro.url.pathname);
const t = home[lang];

// Données structurées schema.org pour le référencement local.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Atelier Web',
  description: t.description,
  url: new URL(localePath(lang, ''), Astro.site).href,
  email: 'contact@atelier-web.example',
  telephone: '+33600000000',
  priceRange: '€€',
  areaServed: 'France',
  serviceType: t.hero.kicker,
  inLanguage: lang,
};

// Visuels et couleurs des cartes modèles (identiques dans les deux langues).
const serviceIcons = ['🔍', '📱', '✨', '⚡'];

const modeleMeta = [
  { path: 'modeles/association', image: 'association.webp', accent: '#7fe0a8' },
  { path: 'modeles/batiment', image: 'batiment.webp', accent: '#f2b705' },
  { path: 'modeles/esthetique', image: 'esthetique.webp', accent: '#f3c9bd' },
  { path: 'modeles/artiste', image: 'artiste.webp', accent: '#b9a8ff' },
];
const modeles = modeleMeta.map((m, i) => ({
  ...m,
  ...t.modeles.items[i],
  href: localePath(lang, m.path),
}));

const etapeDeco = [
  { num: '01', icon: '☕' },
  { num: '02', icon: '🎨' },
  { num: '03', icon: '✏️' },
  { num: '04', icon: '🚀' },
];
const etapes = etapeDeco.map((e, i) => ({ ...e, ...t.methode.steps[i] }));
---

<Base title={t.title} description={t.description} jsonLd={jsonLd}>
  <Header />
  <main>
    <!-- ============================== HERO ============================== -->
    <section class="hero" aria-label={t.hero.ariaLabel}>
      <div class="hero-bg" aria-hidden="true">
        <AuroraBackdrop
          colors={['#5352d1', '#8a5cf5', '#ff6b57', '#f2b705', '#2f6fdb']}
          background="#12131f"
          speed={1.3}
        />
        <span class="hero-grid"></span>
      </div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker">{t.hero.kicker}</p>
          <h1 class="hero-title">
            {t.hero.titleLine}<br />
            <em>{t.hero.titleEm}</em>
          </h1>
          <p class="hero-lede">{t.hero.lede}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#modeles">{t.hero.ctaModels}</a>
            <a class="btn btn-ghost hero-ghost" href="#contact">{t.hero.ctaQuote}</a>
          </div>
          <ul class="hero-proof" aria-label={t.hero.proofAria}>
            {t.hero.proof.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="mock-browser">
            <div class="mock-chrome">
              <span></span><span></span><span></span>
            </div>
            <div class="mock-body">
              <div class="mock-hero"></div>
              <div class="mock-row">
                <div class="mock-card"></div>
                <div class="mock-card"></div>
                <div class="mock-card"></div>
              </div>
              <div class="mock-lines">
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
          <div class="float-chip chip-call">📞 {t.hero.chipCall}</div>
          <div class="float-chip chip-seo" set:html={t.hero.chipSeo} />
          <div class="float-chip chip-star">★★★★★</div>
        </div>
      </div>
    </section>

    <!-- ============================ MARQUEE ============================= -->
    <section class="marquee-strip" aria-hidden="true">
      <div class="marquee-track">
        {[...t.metiers, ...t.metiers].map((m) => <span class="marquee-item">{m}</span>)}
      </div>
    </section>

    <!-- =========================== SERVICES ============================ -->
    <section id="services" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.services.eyebrow}</p>
          <h2 class="section-title">{t.services.title}</h2>
          <p class="section-lede">{t.services.lede}</p>
        </div>
        <div class="service-grid">
          {t.services.items.map((s, i) => (
            <article class="service-card reveal" style={`--reveal-delay: ${i * 0.1}s`}>
              <div class="service-icon" aria-hidden="true">{serviceIcons[i]}</div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================ MODÈLES ============================ -->
    <section id="modeles" class="section modeles-section">
      <div class="section-backdrop" aria-hidden="true">
        <AuroraBackdrop
          colors={['#dcdcf8', '#ffe0d8', '#f9ecc2']}
          background="#f2f1eb"
          blend="normal"
          speed={0.6}
          grain={0.04}
        />
      </div>
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.modeles.eyebrow}</p>
          <h2 class="section-title">{t.modeles.title}</h2>
          <p class="section-lede">{t.modeles.lede}</p>
        </div>
        <div class="modele-grid">
          {modeles.map((m, i) => (
            <a
              class="modele-card reveal"
              href={m.href}
              style={`--reveal-delay: ${i * 0.08}s; --accent-card: ${m.accent}`}
            >
              <img
                class="modele-photo"
                src={withBase(`modeles/${m.image}`)}
                alt=""
                width="1600"
                height="873"
                loading="lazy"
                decoding="async"
              />
              <div class="modele-overlay" aria-hidden="true"></div>
              <div class="modele-info">
                <p class="modele-tag">{m.tag}</p>
                <h3 class="modele-name">{m.name}</h3>
                <p class="modele-desc">{m.desc}</p>
                <span class="modele-link">{t.modeles.viewDemo} <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>
        <p class="modele-note reveal">
          {t.modeles.note.before}
          <a href="#contact">{t.modeles.note.link}</a>{t.modeles.note.after}
        </p>
      </div>
    </section>

    <!-- ============================ MÉTHODE ============================ -->
    <section id="methode" class="section methode-section">
      <div class="section-backdrop" aria-hidden="true">
        <AuroraBackdrop
          colors={['#4a49c9', '#d84f9a', '#1f6fae']}
          background="#12131f"
          speed={0.7}
          grain={0.05}
        />
      </div>
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.methode.eyebrow}</p>
          <h2 class="section-title">{t.methode.title}</h2>
        </div>
        <ol class="etapes">
          {etapes.map((e, i) => (
            <li class="etape reveal" style={`--reveal-delay: ${i * 0.1}s`}>
              <span class="etape-icon" aria-hidden="true">{e.icon}</span>
              <span class="etape-num" aria-hidden="true">{e.num}</span>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============================ TARIFS ============================= -->
    <section id="tarifs" class="section">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.tarifs.eyebrow}</p>
          <h2 class="section-title">{t.tarifs.title}</h2>
          <p class="section-lede">{t.tarifs.lede}</p>
        </div>
        <div class="tarif-grid">
          <article class="tarif-card reveal">
            <h3 class="tarif-name">{t.tarifs.essentiel.name}</h3>
            <p class="tarif-price"><span>{t.tarifs.essentiel.price}</span></p>
            <ul class="tarif-list">
              {t.tarifs.essentiel.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn-ghost tarif-btn" href="#contact">{t.tarifs.essentiel.cta}</a>
          </article>
          <article class="tarif-card tarif-featured reveal" style="--reveal-delay: 0.12s">
            <p class="tarif-badge">{t.tarifs.surMesure.badge}</p>
            <h3 class="tarif-name">{t.tarifs.surMesure.name}</h3>
            <p class="tarif-price"><span>{t.tarifs.surMesure.price}</span></p>
            <ul class="tarif-list">
              {t.tarifs.surMesure.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn-primary tarif-btn" href="#contact">{t.tarifs.surMesure.cta}</a>
          </article>
        </div>
        <p class="tarif-note reveal">{t.tarifs.note}</p>
      </div>
    </section>

    <!-- ============================ CONTACT ============================ -->
    <section id="contact" class="section contact-section">
      <div class="section-backdrop" aria-hidden="true">
        <AuroraBackdrop
          colors={['#b9b8f0', '#ffc9be', '#f6e3a1']}
          background="#efeee8"
          blend="normal"
          speed={0.8}
          grain={0.05}
        />
      </div>
      <div class="container contact-inner reveal">
        <h2 class="contact-title">
          {t.contact.titleBefore} <em>{t.contact.titleEm}</em> {t.contact.titleAfter}
        </h2>
        <p class="contact-lede">{t.contact.lede}</p>
        <div class="contact-actions">
          <a class="btn btn-primary contact-btn" href={`mailto:${t.contact.email}`}>
            ✉️ {t.contact.email}
          </a>
          <a class="btn btn-ghost contact-btn contact-tel" href="tel:+33600000000">
            📞 {t.contact.phone}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* ------------------------------- Hero -------------------------------- */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Conteneur des fonds animés de section (AuroraBackdrop). */
  .section-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 30%, transparent 75%);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d8cf0;
    animation: hero-in 0.8s var(--ease-out) both;
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    animation: hero-in 0.8s var(--ease-out) 0.12s both;
  }

  .hero-title em {
    font-style: normal;
    background: linear-gradient(100deg, #8d8cf0, #ff8a76 55%, #f2b705);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: 1.15rem;
    color: #b9bacd;
    animation: hero-in 0.8s var(--ease-out) 0.24s both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
    animation: hero-in 0.8s var(--ease-out) 0.36s both;
  }

  .hero-ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }

  .hero-ghost:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.06);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    font-size: 0.9rem;
    color: #8f90ab;
    animation: hero-in 0.8s var(--ease-out) 0.48s both;
  }

  .hero-proof li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-proof li::before {
    content: '✓';
    color: #6ee7a0;
    font-weight: 700;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Maquette flottante du hero */

  .hero-visual {
    position: relative;
    animation: hero-in 1s var(--ease-out) 0.4s both;
  }

  .mock-browser {
    background: #1c1e30;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45);
    transform: rotate(2deg);
    animation: float 9s ease-in-out infinite;
  }

  .mock-chrome {
    display: flex;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .mock-chrome span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }

  .mock-chrome span:first-child {
    background: #ff6b57;
  }

  .mock-body {
    padding: 1rem;
    display: grid;
    gap: 0.8rem;
  }

  .mock-hero {
    height: 5.2rem;
    border-radius: 10px;
    background: linear-gradient(120deg, #5352d1, #7a5cd6 55%, #ff6b57);
    background-size: 200% 200%;
    animation: mock-gradient 8s ease-in-out infinite;
  }

  @keyframes mock-gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .mock-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }

  .mock-card {
    height: 3.4rem;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.07);
  }

  .mock-lines {
    display: grid;
    gap: 0.45rem;
  }

  .mock-lines span {
    height: 0.5rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.12);
  }

  .mock-lines span:nth-child(2) {
    width: 80%;
  }

  .mock-lines span:nth-child(3) {
    width: 55%;
  }

  .float-chip {
    position: absolute;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: var(--shadow-m);
    white-space: nowrap;
  }

  .chip-call {
    top: -1.2rem;
    left: -1.6rem;
    animation: float 7s ease-in-out infinite;
  }

  .chip-seo {
    bottom: 22%;
    right: -1.8rem;
    background: #6ee7a0;
    animation: float 8s ease-in-out 1s infinite;
  }

  .chip-star {
    bottom: -1.1rem;
    left: 18%;
    color: var(--gold);
    animation: float 9s ease-in-out 0.5s infinite;
  }

  /* ------------------------------ Marquee ------------------------------- */

  .marquee-strip {
    overflow: hidden;
    background: var(--accent);
    color: #fff;
    padding-block: 0.85rem;
  }

  .marquee-track {
    display: flex;
    gap: 2.6rem;
    width: max-content;
    animation: marquee 36s linear infinite;
  }

  .marquee-item {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 2.6rem;
  }

  .marquee-item::after {
    content: '✳';
    font-size: 0.7rem;
    opacity: 0.6;
  }

  /* ------------------------------ Services ------------------------------ */

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.4rem;
  }

  .service-card {
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.06);
    border-radius: var(--radius-m);
    padding: 1.8rem 1.6rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  .service-icon {
    font-size: 1.7rem;
    width: 3.2rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--accent-soft);
    margin-bottom: 1.1rem;
  }

  .service-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
  }

  .service-card p {
    font-size: 0.97rem;
    color: var(--muted);
  }

  /* ------------------------------ Modèles ------------------------------- */

  .modeles-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(var(--paper), #efeee8);
  }

  .modeles-section .container {
    position: relative;
  }

  .modele-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
  }

  .modele-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 24rem;
    text-decoration: none;
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .modele-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-m);
  }

  /* Photo du métier en fond de carte, léger zoom au survol */

  .modele-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .modele-card:hover .modele-photo {
    transform: scale(1.06);
  }

  /* Voile dégradé sombre pour la lisibilité du texte sur la photo */

  .modele-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(18 19 31 / 0.02) 35%,
      rgb(18 19 31 / 0.55) 65%,
      rgb(18 19 31 / 0.93)
    );
  }

  .modele-info {
    position: relative;
    padding: 1.6rem 1.7rem 1.8rem;
    color: #fff;
  }

  .modele-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent-card, var(--accent-soft));
  }

  .modele-name {
    font-size: 1.4rem;
    font-weight: 700;
    margin-top: 0.4rem;
    letter-spacing: -0.01em;
  }

  .modele-desc {
    margin-top: 0.55rem;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.98rem;
  }

  .modele-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-weight: 600;
    color: #fff;
  }

  .modele-link .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  .modele-card:hover .modele-link .arrow {
    transform: translateX(5px);
  }

  .modele-note {
    margin-top: 2.2rem;
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .modele-note a {
    color: var(--accent);
    font-weight: 600;
  }

  /* ------------------------------ Méthode ------------------------------- */

  .methode-section {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
  }

  .methode-section .container {
    position: relative;
  }

  .methode-section .section-title {
    color: #fff;
  }

  .etapes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: etape;
  }

  .etape {
    position: relative;
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-m);
    padding: 1.7rem 1.5rem;
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.35s;
  }

  .etape:hover {
    transform: translateY(-5px);
    background: rgb(255 255 255 / 0.09);
  }

  .etape-icon {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: grid;
    place-items: center;
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.08);
    font-size: 1.4rem;
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.35s;
  }

  .etape:hover .etape-icon {
    transform: scale(1.15) rotate(-6deg);
    background: rgb(255 255 255 / 0.14);
  }

  .etape-num {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(120deg, #8d8cf0, #ff8a76);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .etape h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 700;
  }

  .etape p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: #b9bacd;
  }

  /* ------------------------------- Tarifs ------------------------------- */

  .tarif-grid {
    display: grid;
