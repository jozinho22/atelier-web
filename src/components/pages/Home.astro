---
// Gabarit bilingue de la page d'accueil — la langue est déduite de l'URL.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import AuroraBackdrop from '../AuroraBackdrop.astro';
import { withBase } from '../../lib/paths';
import { splitPath, localePath } from '../../lib/i18n';
import { home } from '../../i18n/home';
import { prixPack, prixHebergement } from '../../data/tarifs';

const { lang } = splitPath(Astro.url.pathname);
const t = home[lang];

// Données structurées schema.org pour le référencement local.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Atelier Web',
  description: t.description,
  url: new URL(localePath(lang, ''), Astro.site).href,
  email: 'contact@atelier-web.example',
  telephone: '+33600000000',
  priceRange: '€€',
  areaServed: 'France',
  serviceType: t.hero.kicker,
  inLanguage: lang,
};

// Visuels et couleurs des cartes modèles (identiques dans les deux langues).
const modeleMeta = [
  { path: 'modeles/association', image: 'association.webp', accent: '#7fe0a8' },
  { path: 'modeles/batiment', image: 'batiment.webp', accent: '#f2b705' },
  { path: 'modeles/esthetique', image: 'esthetique.webp', accent: '#f3c9bd' },
  // La vignette reprend la photographie de la galerie visible sur le modèle :
  // le visiteur retrouve exactement l'image qui l'attend derrière le lien.
  { path: 'modeles/artiste', image: 'artiste/photographie-de-la-galerie.webp', accent: '#b9a8ff' },
  // Le modèle yoga est en noir et blanc : son accent est un gris, pas une
  // couleur, et sa vignette est désaturée — sans quoi elle trahirait le parti
  // pris du site qu'elle annonce.
  { path: 'modeles/yoga', image: 'yoga/prof-4.webp', accent: '#d7d7d7', monochrome: true },
  { path: 'modeles/restaurant', image: 'restaurant/four.webp', accent: '#d9ae5f' },
];
// L'inversion se fait APRÈS l'appariement : modeleMeta[i] et items[i] restent
// alignés, seul l'ordre d'affichage change (et avec lui l'échelonnement des
// animations, qui suit l'index du tableau final).
const modeles = modeleMeta
  .map((m, i) => ({
    ...m,
    ...t.modeles.items[i],
    href: localePath(lang, m.path),
  }))
  .reverse();

/**
 * Packs « Sur mesure » et « Signature » : ce ne sont pas des pages de
 * démonstration comme les six vitrines, mais des sites complets, chacun dans
 * son propre dépôt et déployé seul. D'où des URL absolues et une ouverture
 * dans un nouvel onglet — le visiteur quitte l'atelier pour un vrai site.
 *
 * Le texte du pack (chapô, titre, liste des points) est commun : il décrit ce
 * que contient un site de ce niveau, pas un site en particulier. Seules
 * l'identité et la vignette changent d'un modèle à l'autre.
 *
 * `accent` colore le liseré de la vignette ET l'étiquette de secteur : il doit
 * donc tenir 4,5:1 sur blanc — c'est pourquoi il reprend la teinte la plus
 * sombre de la palette du site, jamais celle qui domine son hero.
 *
 * Les vignettes sont des captures du hero de chaque site, prises depuis le
 * dépôt local (`npm run build`, `astro preview`, puis Chrome en
 * `--headless --window-size=1600,873 --screenshot`). Un build local n'active
 * pas `SITE_DEMO`, donc le bandeau de démonstration n'y apparaît pas.
 *
 * ⚠️ Les adresses ne répondront qu'une fois les dépôts publiés et GitHub Pages
 * activé dessus (Settings → Pages → Source = « GitHub Actions »).
 */
const surMesureModeles = [
  { depot: 'modele-salon-de-the', image: 'salon-de-the.webp', accent: '#c0202e' },
  { depot: 'modele-hotel-de-luxe', image: 'hotel-de-luxe.webp', accent: '#8d6d2c' },
];

const signatureModeles = [
  { depot: 'modele-golf', image: 'golf.webp', accent: '#2b7350' },
  { depot: 'modele-centre-equestre', image: 'centre-equestre.webp', accent: '#96581f' },
];

/** Assemble un modèle de pack avec ses textes traduits, dans l'ordre du tableau. */
const packModeles = (metas: { depot: string; image: string; accent: string }[],
                     textes: readonly { tag: string; name: string; desc: string }[]) =>
  metas.map((m, i) => ({
    ...m,
    ...textes[i],
    url: `https://jozinho22.github.io/${m.depot}/`,
  }));

const surMesure = packModeles(surMesureModeles, t.surMesure.modeles);
const signature = packModeles(signatureModeles, t.signature.modeles);

/**
 * Portfolio : sites réellement livrés. Les favicons sont copiés dans
 * public/portfolio/ plutôt que chargés depuis les domaines distants — le site
 * ne fait aucune requête externe, et une icône ne peut pas disparaître si le
 * site du client change. `icon` absent ⇒ monogramme dessiné en CSS.
 */
const portfolioMeta = [
  // `accent` colore le liseré et le monogramme ; `accentText` est sa variante
  // assombrie, seule autorisée à porter le domaine en toutes lettres.
  { url: 'https://api-jawa.fr', icon: 'api-jawa.png', accent: '#c98a3f', accentText: '#9b682c' },
  { url: 'https://expert-maths-lycee.fr', accent: '#2f6fdb', accentText: '#2f6fdb' },
  { url: 'https://xn--monmtr-evac.com', icon: 'monmetre.svg', accent: '#1f8a70', accentText: '#1d8169' },
];
const portfolio = portfolioMeta.map((p, i) => ({
  ...p,
  ...t.portfolio.items[i],
  // Domaine lisible : on retire le protocole et on décode le punycode.
  domaine: p.url.replace(/^https?:\/\//, '').replace('xn--monmtr-evac.com', 'monmétré.com'),
}));

/**
 * Les quatre étapes forment un circuit fermé : la mise en ligne d'un site
 * ramène au premier échange du suivant. Le numéro suffit à les ordonner —
 * les pictogrammes n'ajoutaient rien que le titre ne dise déjà.
 */
const etapes = t.methode.steps.map((e, i) => ({ ...e, num: String(i + 1).padStart(2, '0') }));
---

<Base title={t.title} description={t.description} jsonLd={jsonLd}>
  <Header />
  <main>
    <!-- ============================== HERO ============================== -->
    <section class="hero" aria-label={t.hero.ariaLabel}>
      <div class="hero-bg" aria-hidden="true">
        <video
          class="hero-video"
          src={withBase('accueil/dark-coder.mp4')}
          poster={withBase('accueil/dark-coder-affiche.webp')}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          data-boucle
        ></video>
        <!-- Voile indispensable : la vidéo comporte des zones très claires —
             l'écran, la lampe — sur lesquelles le texte blanc du hero se
             perdrait. Il est plus dense à gauche, là où le texte se trouve. -->
        <span class="hero-voile"></span>
      </div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-kicker">{t.hero.kicker}</p>
          <h1 class="hero-title">
            {t.hero.titleLine}<br />
            <em>{t.hero.titleEm}</em>
          </h1>
          <p class="hero-lede">{t.hero.lede}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#modeles">{t.hero.ctaModels}</a>
            <a class="btn btn-ghost hero-ghost" href="#contact">{t.hero.ctaQuote}</a>
          </div>
          <ul class="hero-proof" aria-label={t.hero.proofAria}>
            {t.hero.proof.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============================ MARQUEE ============================= -->
    <section class="marquee-strip" aria-hidden="true">
      <div class="marquee-track">
        {[...t.metiers, ...t.metiers].map((m) => <span class="marquee-item">{m}</span>)}
      </div>
    </section>

    <!-- =========================== SERVICES ============================ -->
    <section id="services" class="section surface rupture" style="--ton: var(--mur-1)">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.services.eyebrow}</p>
          <h2 class="section-title">{t.services.title}</h2>
          <p class="section-lede">{t.services.lede}</p>
        </div>
        <div class="service-grid">
          {t.services.items.map((s, i) => (
            <article class="service-card reveal" style={`--reveal-delay: ${i * 0.1}s`}>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <ul class="service-points">
                {s.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <!-- La méthode, dans la même section : elle répond au « comment »
             quand ce qui précède répond au « pourquoi ». -->
        <div id="methode" class="section-head methode-head reveal">
          <p class="eyebrow">{t.methode.eyebrow}</p>
          <h2 class="section-title">{t.methode.title}</h2>
        </div>

        <ol class="circuit reveal">
          {etapes.map((e, i) => (
            <li class={`circuit-etape etape-${i + 1}`}>
              <span class="circuit-num" aria-hidden="true">{e.num}</span>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
            </li>
          ))}
          <span class="circuit-fleche fleche-1" aria-hidden="true"><svg viewBox="0 0 72 12"><path d="M1 6h62m-7-5 7 5-7 5"/></svg></span>
          <span class="circuit-fleche fleche-2" aria-hidden="true"><svg viewBox="0 0 72 12"><path d="M1 6h62m-7-5 7 5-7 5"/></svg></span>
          <span class="circuit-fleche fleche-3" aria-hidden="true"><svg viewBox="0 0 72 12"><path d="M1 6h62m-7-5 7 5-7 5"/></svg></span>
          <span class="circuit-fleche fleche-4" aria-hidden="true"><svg viewBox="0 0 72 12"><path d="M1 6h62m-7-5 7 5-7 5"/></svg></span>
        </ol>
      </div>

    </section>

    <!-- ============================ MODÈLES ============================ -->
    <section id="modeles" class="section modeles-section surface rupture" style="--ton: var(--mur-2)">
      <div class="section-backdrop" aria-hidden="true">
        <AuroraBackdrop
          colors={['#dcdcf8', '#ffe0d8', '#f9ecc2']}
          background="#f2f1eb"
          blend="normal"
          speed={0.6}
          grain={0.04}
        />
      </div>
      <div class="container">
        <div class="section-head section-head-nue reveal">
          <p class="eyebrow">{t.modeles.eyebrow}</p>
        </div>

        <!-- ------------------------- Pack Essentiel --------------------- -->
        <div class="pack-bloc reveal">
          <p class="pack-chip pack-essentiel">
            <span class="pack-dot" aria-hidden="true"></span>{t.modeles.packBadge}
          </p>
          <p class="eyebrow signature-eyebrow">{t.modeles.eyebrow2}</p>
          <h2 class="signature-title">{t.modeles.title}</h2>
          <p class="pack-note">{t.modeles.packNote}</p>
          <div class="modele-grid">
          {modeles.map((m, i) => (
            <a
              class="modele-card reveal"
              href={m.href}
              style={`--reveal-delay: ${i * 0.08}s; --accent-card: ${m.accent}`}
            >
              <img
                class:list={['modele-photo', { 'modele-photo-nb': m.monochrome }]}
                src={withBase(`modeles/${m.image}`)}
                alt=""
                width="1600"
                height="873"
                loading="lazy"
                decoding="async"
              />
              <span class="modele-pack pack-essentiel">{t.modeles.packBadge}</span>
              <div class="modele-info">
                <p class="modele-tag">{m.tag}</p>
                <h3 class="modele-name">{m.name}</h3>
                <p class="modele-desc">{m.desc}</p>
                <ul class="modele-points">
                  {m.points.map((p) => <li>{p}</li>)}
                </ul>
                <span class="modele-link">{t.modeles.viewDemo} <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
          </div>
          <p class="modele-note">
            {t.modeles.note.before}
            <a href="#contact">{t.modeles.note.link}</a>{t.modeles.note.after}
          </p>
        </div>

        <!-- ------------------------- Pack Sur mesure -------------------- -->
        <div class="pack-bloc signature pack-surmesure reveal">
          <div class="signature-texte">
            <p class="pack-chip pack-surmesure">
              <span class="pack-dot" aria-hidden="true"></span>{t.surMesure.packBadge}
            </p>
            <p class="eyebrow signature-eyebrow">{t.surMesure.eyebrow}</p>
            <h2 class="signature-title">{t.surMesure.title}</h2>
            <p class="signature-desc">{t.surMesure.desc}</p>

            <ul class="signature-points">
              {t.surMesure.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>

          <!-- Un modèle par vignette ; le texte ci-dessus vaut pour les deux. -->
          <ul class="signature-vitrines">
            {surMesure.map((m) => (
              <li class="vitrine" style={`--accent-card: ${m.accent}`}>
                <a
                  class="signature-visuel"
                  href={m.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.surMesure.cta} — ${m.name}`}
                >
                  <img
                    src={withBase(`modeles/${m.image}`)}
                    alt=""
                    width="1600"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="signature-loupe" aria-hidden="true">{t.surMesure.cta} ↗</span>
                </a>
                <p class="vitrine-tag">{m.tag}</p>
                <p class="vitrine-nom">{m.name}</p>
                <p class="vitrine-desc">{m.desc}</p>
                <a class="vitrine-lien" href={m.url} target="_blank" rel="noopener noreferrer">
                  {t.surMesure.cta} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>

          <p class="signature-note">{t.surMesure.note}</p>
        </div>

        <!-- ------------------------- Pack Signature --------------------- -->
        <div class="pack-bloc signature pack-signature reveal">
          <div class="signature-texte">
            <p class="pack-chip pack-signature">
              <span class="pack-dot" aria-hidden="true"></span>{t.signature.packBadge}
            </p>
            <p class="eyebrow signature-eyebrow">{t.signature.eyebrow}</p>
            <h2 class="signature-title">{t.signature.title}</h2>
            <p class="signature-desc">{t.signature.desc}</p>

            <ul class="signature-points">
              {t.signature.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>

          <!-- Un modèle par vignette ; le texte ci-dessus vaut pour les deux. -->
          <ul class="signature-vitrines">
            {signature.map((m) => (
              <li class="vitrine" style={`--accent-card: ${m.accent}`}>
                <a
                  class="signature-visuel"
                  href={m.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.signature.cta} — ${m.name}`}
                >
                  <img
                    src={withBase(`modeles/${m.image}`)}
                    alt=""
                    width="1600"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="signature-loupe" aria-hidden="true">{t.signature.cta} ↗</span>
                </a>
                <p class="vitrine-tag">{m.tag}</p>
                <p class="vitrine-nom">{m.name}</p>
                <p class="vitrine-desc">{m.desc}</p>
                <a class="vitrine-lien" href={m.url} target="_blank" rel="noopener noreferrer">
                  {t.signature.cta} <span class="arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>

          <p class="signature-note">{t.signature.note}</p>
        </div>
      </div>
    </section>

    <!-- =========================== PORTFOLIO =========================== -->
    <section id="portfolio" class="section portfolio-section surface rupture" style="--ton: var(--mur-3)">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.portfolio.eyebrow}</p>
          <h2 class="section-title">{t.portfolio.title}</h2>
          <p class="section-lede">{t.portfolio.lede}</p>
        </div>

        <div class="carrousel reveal" data-carrousel>
          <button class="carrousel-fleche" type="button" data-carrousel-prec aria-label={t.portfolio.precedent}>
            <span aria-hidden="true">←</span>
          </button>

          <ul class="carrousel-piste" data-carrousel-piste>
            {portfolio.map((p) => (
              <li class="carrousel-item" style={`--accent-card: ${p.accent}; --accent-card-text: ${p.accentText}`}>
                <a class="projet" href={p.url} target="_blank" rel="noopener noreferrer">
                  {p.icon ? (
                    <img
                      class="projet-icone"
                      src={withBase(`portfolio/${p.icon}`)}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="projet-icone projet-monogramme" aria-hidden="true">
                      {p.name.charAt(0)}
                    </span>
                  )}
                  <p class="projet-nom">{p.name}</p>
                  <p class="projet-domaine">{p.domaine}</p>
                  <p class="projet-desc">{p.desc}</p>
                  <span class="projet-lien">
                    {t.portfolio.visiter} <span class="arrow" aria-hidden="true">↗</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <button class="carrousel-fleche" type="button" data-carrousel-suiv aria-label={t.portfolio.suivant}>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ============================ TARIFS ============================= -->
    <section id="tarifs" class="section surface rupture" style="--ton: var(--mur-4)">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">{t.tarifs.eyebrow}</p>
          <h2 class="section-title">{t.tarifs.title}</h2>
          <p class="section-lede">{t.tarifs.lede}</p>
        </div>
        <div class="tarif-grid">
          <article class="tarif-card pack-essentiel reveal">
            <h3 class="tarif-name">{t.tarifs.essentiel.name}</h3>
            <p class="tarif-price"><span>{prixPack('essentiel', lang)}</span></p>
            <ul class="tarif-list">
              {t.tarifs.essentiel.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn-ghost tarif-btn" href="#contact">{t.tarifs.essentiel.cta}</a>
            <a class="tarif-demo" href="#modeles">
              {t.tarifs.essentiel.demo} <span class="arrow" aria-hidden="true">↓</span>
            </a>
          </article>
          <article class="tarif-card pack-surmesure tarif-featured reveal" style="--reveal-delay: 0.12s">
            <p class="tarif-badge">{t.tarifs.surMesure.badge}</p>
            <h3 class="tarif-name">{t.tarifs.surMesure.name}</h3>
            <p class="tarif-price"><span>{prixPack('surMesure', lang)}</span></p>
            <ul class="tarif-list">
              {t.tarifs.surMesure.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn-primary tarif-btn" href="#contact">{t.tarifs.surMesure.cta}</a>
            <a
              class="tarif-demo"
              href={surMesure[0].url}
              target="_blank"
              rel="noopener noreferrer">{t.tarifs.surMesure.demo} <span class="arrow" aria-hidden="true">↗</span></a
            >
          </article>
          <article class="tarif-card pack-signature reveal" style="--reveal-delay: 0.24s">
            <h3 class="tarif-name">{t.tarifs.signature.name}</h3>
            <p class="tarif-price"><span>{prixPack('signature', lang)}</span></p>
            <ul class="tarif-list">
              {t.tarifs.signature.features.map((f) => <li>{f}</li>)}
            </ul>
            <a class="btn btn-ghost tarif-btn" href="#contact">{t.tarifs.signature.cta}</a>
            <a
              class="tarif-demo"
              href={signature[0].url}
              target="_blank"
              rel="noopener noreferrer">{t.tarifs.signature.demo} <span class="arrow" aria-hidden="true">↗</span></a
            >
          </article>
        </div>
        <p class="tarif-note reveal">
          {t.tarifs.note.avant}<strong>{prixHebergement(lang)}</strong>{t.tarifs.note.apres}
        </p>
      </div>
    </section>

    <!-- ============================ CONTACT ============================ -->
    <section id="contact" class="section contact-section rupture">
      <div class="section-backdrop" aria-hidden="true">
        <AuroraBackdrop
          colors={['#b9b8f0', '#ffc9be', '#f6e3a1']}
          background="#efeee8"
          blend="normal"
          speed={0.8}
          grain={0.05}
        />
      </div>
      <div class="container contact-inner reveal">
        <h2 class="contact-title">
          {t.contact.titleBefore} <em>{t.contact.titleEm}</em> {t.contact.titleAfter}
        </h2>
        <p class="contact-lede">{t.contact.lede}</p>
        <div class="contact-actions">
          <a class="btn btn-primary contact-btn" href={`mailto:${t.contact.email}`}>
            ✉️ {t.contact.email}
          </a>
          <a class="btn btn-ghost contact-btn contact-tel" href="tel:+33600000000">
            📞 {t.contact.phone}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* ------------------------------- Hero -------------------------------- */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La vidéo est monochrome : un rien de contraste la raccorde à l'encre. */
    filter: contrast(1.08);
  }

  /* Dégradé plus dense à gauche : c'est là que vit le texte, et c'est là que
     la vidéo est la plus claire (l'écran et la lampe du personnage). */
  .hero-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgb(18 19 31 / 0.94) 0%, rgb(18 19 31 / 0.82) 42%, rgb(18 19 31 / 0.5) 100%),
      linear-gradient(rgb(18 19 31 / 0.55), rgb(18 19 31 / 0.2) 45%, rgb(18 19 31 / 0.7));
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ---------------------- Cassures entre sections ----------------------- */

  /* Deux surfaces qui alternent : le crème porte, le blanc se pose. Le
     changement d'aplat est ce qui dit « vous avez changé de partie » — un
     dégradé, lui, dissout justement la frontière. */
  /* Chaque section reçoit son palier de la rampe par `--ton`. */
  .surface {
    background: var(--ton, var(--paper));
  }

  .rupture {
    position: relative;
    /* Un ressaut plutôt qu'un simple filet : l'écart crème/blanc ne vaut que
       1,08 de rapport de luminance — assez pour distinguer deux surfaces
       côte à côte, pas pour signaler qu'on a changé de partie. L'ombre courte
       au bord haut donne la marche. */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 14px 22px -18px rgb(18 19 31 / 0.28);
  }

  /* La cimaise : un filet sur toute la largeur, et le crochet d'accrochage à
     l'aplomb du texte. Il reprend le liseré de 3 px des cartes modèles. */
  .rupture::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: rgb(18 19 31 / 0.09);
  }

  .rupture::after {
    content: '';
    position: absolute;
    top: 0;
    left: max(1.25rem, calc(50% - var(--container) / 2));
    width: 5rem;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--accent);
  }

  /* Conteneur des fonds animés de section (AuroraBackdrop). */
  .section-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }


  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d8cf0;
    animation: hero-in 0.8s var(--ease-out) both;
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    animation: hero-in 0.8s var(--ease-out) 0.12s both;
  }

  /* Le titre porte l'emphase de la page : il reste dans le seul accent
     structurel. Le dégradé garde le relief, sans convoquer corail ni or —
     qui ponctuent le site mais n'y portent jamais de sens. */
  .hero-title em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent-on-ink-soft), var(--accent-on-ink-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: 1.15rem;
    color: #b9bacd;
    animation: hero-in 0.8s var(--ease-out) 0.24s both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
    animation: hero-in 0.8s var(--ease-out) 0.36s both;
  }

  .hero-ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }

  .hero-ghost:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.06);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    font-size: 0.95rem;
    color: #8f90ab;
    animation: hero-in 0.8s var(--ease-out) 0.48s both;
  }

  .hero-proof li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-proof li::before {
    content: '✓';
    color: #6ee7a0;
    font-weight: 700;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Maquette flottante du hero */



















  /* ------------------------------ Marquee ------------------------------- */

  .marquee-strip {
    overflow: hidden;
    background: var(--accent);
    color: #fff;
    padding-block: 0.85rem;
  }

  .marquee-track {
    display: flex;
    gap: 2.6rem;
    width: max-content;
    animation: marquee 36s linear infinite;
  }

  .marquee-item {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 2.6rem;
  }

  .marquee-item::after {
    content: '✳';
    font-size: 0.72rem;
    opacity: 0.6;
  }

  /* ------------------------------ Services ------------------------------ */

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.4rem;
  }

  .service-card {
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.06);
    border-radius: var(--radius-m);
    padding: 1.8rem 1.6rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  .service-points {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .service-points li {
    position: relative;
    padding-left: 1.15rem;
  }

  .service-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }


  .service-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
  }

  .service-card p {
    font-size: 0.95rem;
    color: var(--muted);
  }

  /* ------------------------------ Modèles ------------------------------- */

  .modeles-section {
    position: relative;
    overflow: hidden;
  }

  .modeles-section .container {
    position: relative;
  }

  .modele-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
    margin-top: 1.4rem;
  }

  /* Comme les deux autres packs : la photo est un bloc à part entière, posé
     au-dessus du texte, et non un fond sur lequel on écrirait. */
  .modele-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .modele-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  .modele-photo {
    width: 100%;
    /* `height: auto` est indispensable : sans lui, l'attribut height="873" de
       la balise fait loi et `aspect-ratio` est ignoré. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* Liseré aux couleurs du métier, comme le visuel des deux autres packs. */
    border-bottom: 3px solid var(--accent-card);
    transition: transform 0.6s var(--ease-out);
  }

  /* Désaturation complète, y compris au survol : le noir et blanc n'est pas
     un effet, c'est le sujet du modèle. */
  .modele-photo-nb {
    filter: saturate(0);
  }

  .modele-card:hover .modele-photo {
    transform: scale(1.04);
  }

  .modele-info {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .modele-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent-card, var(--accent));
  }

  /* Dans les 4 cartes vitrines, l'accent métier est pastel : illisible en
     texte sur blanc, il devient le fond d'une pastille au texte encre. Les
     blocs Sur mesure et Signature, eux, ont des accents sombres : ils restent
     en texte coloré (règle ci-dessus). */
  .modele-card .modele-tag {
    align-self: flex-start;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-card);
    color: var(--ink);
  }

  .modele-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0.3rem;
    letter-spacing: -0.01em;
  }

  .modele-desc {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  /* Contenu du site, en une ligne : les sections que le modèle comporte.
     Séparateur en ::before plutôt qu'une puce, pour rester discret. */
  .modele-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .modele-points li + li::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .modele-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.7rem;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .modele-link .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  .modele-card:hover .modele-link .arrow {
    transform: translateX(5px);
  }

  .modele-note {
    margin-top: 2.2rem;
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .modele-note a {
    color: var(--accent);
    font-weight: 600;
  }

  /* ------------------------- Méthode : le circuit ------------------------ */

  .methode-head {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* Quatre étapes aux angles d'un carré, quatre flèches sur les côtés : le
     circuit se referme, la mise en ligne d'un site ramène au premier échange
     du suivant. La grille explicite garantit que flèches et étapes restent
     alignées quelle que soit la hauteur des textes. */
  .circuit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas:
      'e1 f1 e2'
      'f4 .  f2'
      'e4 f3 e3';
    align-items: stretch;
    gap: 1.1rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: etape;
  }

  .etape-1 { grid-area: e1; }
  .etape-2 { grid-area: e2; }
  .etape-3 { grid-area: e3; }
  .etape-4 { grid-area: e4; }

  .circuit-etape {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-m);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .circuit-etape:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-m);
  }

  .circuit-num {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  .circuit-etape h3 {
    margin-top: 0.6rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .circuit-etape p {
    margin-top: 0.45rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .circuit-fleche {
    display: grid;
    place-items: center;
    color: var(--accent);
    /* 0,55 ne donnait que 2,35:1 sur le papier — sous le seuil de 3:1 des
       éléments graphiques porteurs de sens, et une flèche qui relie deux
       étapes en porte. */
    opacity: 0.8;
  }

  .circuit-fleche svg {
    width: 4.5rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Sens horaire : 1 → 2 en haut, 2 → 3 à droite, 3 → 4 en bas, 4 → 1 à
     gauche. La rotation dispense de dessiner quatre tracés distincts. */
  .fleche-1 { grid-area: f1; }
  .fleche-2 { grid-area: f2; }
  .fleche-3 { grid-area: f3; }
  .fleche-4 { grid-area: f4; }
  .fleche-2 svg { transform: rotate(90deg); }
  .fleche-3 svg { transform: rotate(180deg); }
  .fleche-4 svg { transform: rotate(270deg); }

  /* Une fois pivotées, les flèches verticales occupent leur largeur en
     hauteur : à 4,5 rem elles mordaient sur les cartes du dessus et du
     dessous, dont l'interstice ne fait que 47 px. */
  .fleche-2 svg,
  .fleche-4 svg {
    width: 2.4rem;
  }

  /* Sous 760 px, le carré se déplie en colonne : les quatre flèches pointent
     vers le bas, la dernière remontant vers la première n'aurait plus de sens
     et disparaît. */
  @media (max-width: 760px) {
    .circuit {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'e1' 'f1' 'e2' 'f2' 'e3' 'f3' 'e4';
      gap: 0.9rem;
    }

    .fleche-1 svg,
    .fleche-2 svg,
    .fleche-3 svg {
      transform: rotate(90deg);
    }

    .fleche-4 {
      display: none;
    }
  }

  /* ------------------------------- Tarifs ------------------------------- */

  .tarif-grid {
    display: grid;
    /* Trois paliers depuis l'ajout de « Signature » : la largeur maximale doit
       suivre, sans quoi la troisième carte passe seule à la ligne. */
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.8rem;
    max-width: 68rem;
    margin-inline: auto;
  }

  /* --------------------- Code couleur des trois packs -------------------- */

  /* Une couleur par offre, reprise partout où l'offre est évoquée : pastille
     de section, badge sur les cartes de démonstration, carte tarifaire. Le
     libellé écrit accompagne toujours la couleur — jamais de couleur seule. */

  .pack-essentiel {
    --pack: #5352d1;
    --pack-soft: #e6e6fb;
  }

  /* Teintes volontairement sombres : elles servent aussi de couleur de texte,
     et doivent tenir le contraste AA (4,5:1) sur blanc comme sur --pack-soft. */

  .pack-surmesure {
    --pack: #b83a24;
    --pack-soft: #ffe6e1;
  }

  .pack-signature {
    --pack: #7d5a06;
    --pack-soft: #f8ecc9;
  }

  .pack-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background: var(--pack-soft);
    color: var(--pack);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .pack-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--pack);
    flex-shrink: 0;
  }

  .pack-note {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 38rem;
  }

  /* Pastille d'offre posée sur la photo des cartes de démonstration */

  .modele-pack {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--pack);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    box-shadow: 0 2px 10px rgb(18 19 31 / 0.25);
  }

  .tarif-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.85rem;
    align-self: center;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pack, var(--accent));
    text-decoration: none;
  }

  .tarif-demo:hover {
    text-decoration: underline;
  }

  /* ------------------- Modèles complets (Sur mesure, Signature) --------- */

  /* Ces deux paliers ne se démontrent pas par une page hébergée ici mais par un
     site entier, dans son propre dépôt. Ils partagent donc le même bloc : une
     capture qui s'ouvre dans un nouvel onglet, et ce qu'il faut retenir à côté.
     Seul l'accent change, passé en variable sur l'élément. */

  /* L'en-tête de la section ne porte plus que son intitulé : les titres sont
     descendus dans les cadres. On supprime donc sa marge basse, l'espacement
     étant assuré par le margin-top du premier cadre. */
  .section-head-nue {
    margin-bottom: 0;
  }

  /* Habillage commun aux trois offres : chaque pack est présenté dans le même
     cadre, pour qu'on comprenne d'un coup d'œil qu'ils sont de même nature. */
  .pack-bloc {
    max-width: 54rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    box-shadow: var(--shadow-m);
  }

  .pack-bloc > .pack-chip {
    margin-top: 0;
  }

  /* Dans un cadre, le titre suit directement la pastille du pack. */
  .pack-bloc > .signature-title {
    margin-top: 0.7rem;
  }

  /* Le visuel flotte à gauche et le texte l'habille : la capture reste en
     paysage, de taille modeste, et le paragraphe reprend toute la largeur
     dès qu'il descend sous l'image. */
  .signature {
    display: block;
  }

  /* Le flottant doit être contenu, sinon la bordure de la carte remonte. */
  .signature::after {
    content: '';
    display: block;
    clear: both;
  }

  /* Les deux modèles d'un pack, côte à côte sous le texte qui vaut pour les
     deux. auto-fit plutôt qu'un nombre fixe : un troisième modèle s'ajouterait
     sans toucher au CSS. */
  .signature-vitrines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.6rem;
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
  }

  .vitrine-tag {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-card);
  }

  .vitrine-nom {
    margin-top: 0.15rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .vitrine-desc {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .vitrine-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-strong);
    text-decoration: none;
  }

  .vitrine-lien:hover {
    text-decoration: underline;
  }

  .vitrine:hover .signature-visuel,
  .vitrine-lien:hover ~ .signature-visuel {
    transform: translateY(-4px);
    box-shadow: var(--shadow-m);
  }

  .signature-visuel {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    /* Le liseré reprend l'accent du modèle, comme les cartes au-dessus. */
    outline: 2px solid var(--accent-card);
    outline-offset: -2px;
    display: block;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  @media (max-width: 40rem) {
    .signature-visuel {
      float: none;
      width: 100%;
      max-width: none;
      margin: 0 0 1.2rem;
    }
  }

  .signature-visuel:hover,
  .signature-visuel:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-m);
  }

  .signature-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 8% center;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }

  .signature-visuel:hover img,
  .signature-visuel:focus-visible img {
    transform: scale(1.03);
  }

  /* Pastille d'invitation : discrète au repos, franche au survol. */
  .signature-loupe {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%) translateY(0.4rem);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgb(18 19 31 / 0.82);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .signature-visuel:hover .signature-loupe,
  .signature-visuel:focus-visible .signature-loupe {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (hover: none) {
    /* Sans survol possible, la pastille reste visible : c'est le seul indice
       que la capture est cliquable. */
    .signature-loupe {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 54rem) {
    .signature-visuel {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }

  /* Le chapô qualifie le pack, pas un modèle : il prend la couleur du pack. */
  .signature-eyebrow {
    color: var(--pack);
  }

  .signature-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.1;
    margin-top: 0.6rem;
  }




  .signature-desc {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .signature-points {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-size: 0.95rem;
    list-style: none;
    padding: 0;
  }

  .signature-points li {
    position: relative;
    padding-left: 1.35rem;
  }

  /* Les points décrivent le pack, pas un modèle : la puce suit --pack.
     Elle utilisait --accent-card, qui ne vit plus que sur les vignettes — les
     puces étaient devenues invisibles. */
  .signature-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pack);
  }



  .signature-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .tarif-card {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-l);
    padding: 2.2rem 2rem;
    box-shadow: var(--shadow-s);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .tarif-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  /* Chaque carte tarifaire porte la couleur de son pack. */
  .tarif-card {
    border-top: 4px solid var(--pack, var(--accent));
  }

  .tarif-featured {
    border: 2px solid var(--pack, var(--accent));
    border-top-width: 4px;
  }

  .tarif-badge {
    position: absolute;
    top: -0.85rem;
    /* Coin haut droit : le nom du pack occupe le coin gauche, le bandeau ne
       doit jamais venir le serrer — surtout sur trois colonnes, où les cartes
       sont étroites. */
    right: 1.5rem;
    left: auto;
    background: var(--pack, var(--accent));
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
