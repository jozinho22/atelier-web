    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tarif-list {
    list-style: none;
    margin: 1.4rem 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .tarif-list li {
