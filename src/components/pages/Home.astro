  /* Repli quand le favicon du site n'est pas disponible. */
  .projet-monogramme {
    display: grid;
    place-items: center;
    padding: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent-card);
    border-color: transparent;
  }

  .projet-nom {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .projet-domaine {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--accent-card-text, var(--accent-card));
    font-weight: 600;
    word-break: break-all;
  }

  .projet-desc {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
    flex-grow: 1;
  }

  .projet-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .projet:hover .projet-lien .arrow {
    transform: translate(2px, -2px);
  }

  .projet-lien .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  @media (max-width: 640px) {
    .carrousel {
      grid-template-columns: 1fr;
    }

    .carrousel-fleche {
      display: none;
    }

    .carrousel-item {
      flex-basis: 80%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carrousel-piste {
      scroll-behavior: auto;
    }
  }

  /* ----------------------------- Responsive ----------------------------- */

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }


    .modele-grid {
      grid-template-columns: 1fr;
    }

    /* En colonne unique, la carte est bien plus étroite : on lui rend sa
       hauteur et sa typographie pleine taille pour rester lisible au doigt. */
    .modele-card {
      min-height: 22rem;
    }

    .modele-info {
      padding: 1.5rem 1.6rem 1.7rem;
    }

    .modele-name {
      font-size: 1.35rem;
    }

    .modele-desc,
    .modele-link {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // Carrousel du portfolio : les flèches font défiler la piste d'une fiche.
  // Le défilement natif reste la source de vérité — on se contente de le
  // piloter et de refléter son état sur les boutons.
  document.querySelectorAll<HTMLElement>('[data-carrousel]').forEach((carrousel) => {
    const piste = carrousel.querySelector<HTMLElement>('[data-carrousel-piste]');
    const prec = carrousel.querySelector<HTMLButtonElement>('[data-carrousel-prec]');
    const suiv = carrousel.querySelector<HTMLButtonElement>('[data-carrousel-suiv]');
    if (!piste || !prec || !suiv) return;

    const ecart = (): number => parseFloat(getComputedStyle(piste).columnGap) || 0;

    /**
     * Largeur cumulée des fiches. On ne se fie pas à scrollWidth : quand la
     * piste est centrée, le navigateur rend une partie du débordement
     * inatteignable et scrollWidth sous-estime le contenu réel.
     */
    const largeurContenu = (): number => {
      const fiches = Array.from(piste.children) as HTMLElement[];
      if (fiches.length === 0) return 0;
      const somme = fiches.reduce((total, f) => total + f.getBoundingClientRect().width, 0);
      return somme + ecart() * (fiches.length - 1);
    };

    const majBoutons = (): void => {
      // Tant que les fiches tiennent dans la largeur, les flèches n'ont rien
      // à piloter : on les retire plutôt que de les laisser inertes.
      carrousel.dataset.defilable = largeurContenu() - piste.clientWidth > 2 ? 'oui' : 'non';
      // 2 px de tolérance : les navigateurs arrondissent scrollLeft.
      const reste = piste.scrollWidth - piste.clientWidth;
      prec.disabled = piste.scrollLeft <= 2;
      suiv.disabled = piste.scrollLeft >= reste - 2;
    };

    const pas = (): number => {
      const fiche = piste.querySelector<HTMLElement>('li');
      return fiche ? fiche.offsetWidth + ecart() : piste.clientWidth;
    };

    // Comportement explicite plutôt qu'hérité du CSS : on veut un saut sec
    // pour qui demande moins d'animation, un défilement fluide sinon.
    const douceur = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const defiler = (sens: number): void => {
      piste.scrollBy({ left: sens * pas(), behavior: douceur });
    };

    prec.addEventListener('click', () => defiler(-1));
    suiv.addEventListener('click', () => defiler(1));
    piste.addEventListener('scroll', majBoutons, { passive: true });

    // L'observateur est conservé dans une variable : sans référence retenue,
    // il peut être ramassé par le GC et cesser silencieusement de notifier.
    const observateur = new ResizeObserver(majBoutons);
    observateur.observe(piste);
    window.addEventListener('resize', majBoutons, { passive: true });

    majBoutons();
  });
</script>
