</Base>

<style>
  /* ------------------------------- Hero -------------------------------- */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(4.5rem, 10vw, 8rem) clamp(4rem, 9vw, 7rem);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La vidéo est monochrome : un rien de contraste la raccorde à l'encre. */
    filter: contrast(1.08);
  }

  /* Dégradé plus dense à gauche : c'est là que vit le texte, et c'est là que
     la vidéo est la plus claire (l'écran et la lampe du personnage). */
  .hero-voile {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgb(18 19 31 / 0.94) 0%, rgb(18 19 31 / 0.82) 42%, rgb(18 19 31 / 0.5) 100%),
      /* Le dernier quart passe à l'encre pleine : la vidéo se dissout au lieu
         de s'arrêter sur une arête, et le hero se referme sur un aplat. */
      linear-gradient(
        rgb(18 19 31 / 0.55),
        rgb(18 19 31 / 0.2) 42%,
        rgb(18 19 31 / 0.72) 78%,
        rgb(18 19 31 / 1) 100%
      );
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fondu-bandeau {
    height: clamp(4.5rem, 9vw, 7rem);
    background: linear-gradient(var(--accent), var(--mur-1));
  }

  /* ---------------------- Cassures entre sections ----------------------- */

  /* Deux surfaces qui alternent : le crème porte, le blanc se pose. Le
     changement d'aplat est ce qui dit « vous avez changé de partie » — un
     dégradé, lui, dissout justement la frontière. */
  /* Chaque section reçoit son palier de la rampe par `--ton`. */
  .surface {
    background: var(--ton, var(--paper));
  }

  .rupture {
    position: relative;
    /* Un ressaut plutôt qu'un simple filet : l'écart crème/blanc ne vaut que
       1,08 de rapport de luminance — assez pour distinguer deux surfaces
       côte à côte, pas pour signaler qu'on a changé de partie. L'ombre courte
       au bord haut donne la marche. */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      inset 0 14px 22px -18px rgb(18 19 31 / 0.28);
  }

  /* La cimaise : un filet sur toute la largeur, et le crochet d'accrochage à
     l'aplomb du texte. Il reprend le liseré de 3 px des cartes modèles. */
  .rupture::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: rgb(18 19 31 / 0.09);
  }

  .rupture::after {
    content: '';
    position: absolute;
    top: 0;
    left: max(1.25rem, calc(50% - var(--container) / 2));
    width: 5rem;
    height: 4px;
    border-radius: 0 0 4px 4px;
    background: var(--accent);
  }

  /* Conteneur des fonds animés de section (AuroraBackdrop). */
  .section-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }


  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-kicker {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8d8cf0;
    animation: hero-in 0.8s var(--ease-out) both;
  }

  .hero-title {
    margin-top: 1.1rem;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.025em;
    animation: hero-in 0.8s var(--ease-out) 0.12s both;
  }

  /* Le titre porte l'emphase de la page : il reste dans le seul accent
     structurel. Le dégradé garde le relief, sans convoquer corail ni or —
     qui ponctuent le site mais n'y portent jamais de sens. */
  .hero-title em {
    font-style: normal;
    background: linear-gradient(100deg, var(--accent-on-ink-soft), var(--accent-on-ink-deep));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-lede {
    margin-top: 1.4rem;
    max-width: 34rem;
    font-size: 1.15rem;
    color: #b9bacd;
    animation: hero-in 0.8s var(--ease-out) 0.24s both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
    animation: hero-in 0.8s var(--ease-out) 0.36s both;
  }

  .hero-ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.35);
  }

  .hero-ghost:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.06);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    font-size: 0.95rem;
    color: #8f90ab;
    animation: hero-in 0.8s var(--ease-out) 0.48s both;
  }

  .hero-proof li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-proof li::before {
    content: '✓';
    color: #6ee7a0;
    font-weight: 700;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Maquette flottante du hero */



















  /* ------------------------------ Marquee ------------------------------- */

  .marquee-strip {
    overflow: hidden;
    background: var(--accent);
    color: #fff;
    padding-block: 0.85rem;
  }

  .marquee-track {
    display: flex;
    gap: 2.6rem;
    width: max-content;
    animation: marquee 36s linear infinite;
  }

  .marquee-item {
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 2.6rem;
  }

  .marquee-item::after {
    content: '✳';
    font-size: 0.72rem;
    opacity: 0.6;
  }

  /* ------------------------------ Services ------------------------------ */

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.4rem;
  }

  .service-card {
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.06);
    border-radius: var(--radius-m);
    padding: 1.8rem 1.6rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  .service-icone {
    display: block;
    width: 2.35rem;
    height: 2.35rem;
    margin-bottom: 1rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.4s var(--ease-out);
  }

  /* Les tracés marqués `ic-plein` sont pleins, pas en contour : le <svg>
     porte `fill: none`, hérité par ses enfants, il faut donc le reprendre.
     `:global()` est indispensable — les tracés viennent de `set:html` et ne
     reçoivent pas l'attribut de portée qu'Astro ajoute au reste. */
  .service-icone :global(.ic-plein),
  .circuit-icone :global(.ic-plein) {
    fill: var(--accent);
    stroke: none;
  }

  .service-card:hover .service-icone {
    transform: translateY(-3px);
  }

  .service-points {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .service-points li {
    position: relative;
    padding-left: 1.15rem;
  }

  .service-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }


  .service-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.55rem;
  }

  /* ------------------------------ Modèles ------------------------------- */

  .modeles-section {
    position: relative;
    overflow: hidden;
  }

  .modeles-section .container {
    position: relative;
  }

  .modele-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
    margin-top: 1.4rem;
  }

  /* Comme les deux autres packs : la photo est un bloc à part entière, posé
     au-dessus du texte, et non un fond sur lequel on écrirait. */
  .modele-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-l);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .modele-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  .modele-photo {
    width: 100%;
    /* `height: auto` est indispensable : sans lui, l'attribut height="873" de
       la balise fait loi et `aspect-ratio` est ignoré. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    /* Liseré aux couleurs du métier, comme le visuel des deux autres packs. */
    border-bottom: 3px solid var(--accent-card);
    transition: transform 0.6s var(--ease-out);
  }

  /* Désaturation complète, y compris au survol : le noir et blanc n'est pas
     un effet, c'est le sujet du modèle. */
  .modele-photo-nb {
    filter: saturate(0);
  }

  .modele-card:hover .modele-photo {
    transform: scale(1.04);
  }

  .modele-info {
    position: relative;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .modele-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--accent-card, var(--accent));
  }

  /* Dans les 4 cartes vitrines, l'accent métier est pastel : illisible en
     texte sur blanc, il devient le fond d'une pastille au texte encre. Les
     blocs Sur mesure et Signature, eux, ont des accents sombres : ils restent
     en texte coloré (règle ci-dessus). */
  .modele-card .modele-tag {
    align-self: flex-start;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-card);
    color: var(--ink);
  }

  .modele-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin-top: 0.3rem;
    letter-spacing: -0.01em;
  }

  .modele-desc {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  /* Contenu du site, en une ligne : les sections que le modèle comporte.
     Séparateur en ::before plutôt qu'une puce, pour rester discret. */
  .modele-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .modele-points li + li::before {
    content: '·';
    margin-right: 0.5rem;
    opacity: 0.6;
  }

  .modele-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.7rem;
    font-weight: 600;
    font-size: 0.85rem;
    /* La couleur de marque du site vers lequel le lien mène, relevée dans sa
       démonstration (voir ACCENTS_TEXTE). Et non l'accent de la carte : celui-ci
       est un pastel, fond de pastille, qui donnerait 1,4 à 2,4:1 en texte. */
    color: var(--accent-lien, var(--accent));
  }

  .modele-link .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  .modele-card:hover .modele-link .arrow {
    transform: translateX(5px);
  }

  .modele-note {
    margin-top: 2.2rem;
    text-align: center;
    max-width: 34rem;
    margin-inline: auto;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .modele-note a {
    color: var(--accent);
    font-weight: 600;
  }

  /* ------------------------- Méthode : le circuit ------------------------ */

  .methode-head {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
  }

  /* Quatre étapes aux angles d'un carré, quatre flèches sur les côtés : le
     circuit se referme, la mise en ligne d'un site ramène au premier échange
     du suivant. La grille explicite garantit que flèches et étapes restent
     alignées quelle que soit la hauteur des textes. */
  .circuit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas:
      'e1 f1 e2'
      '.  .  f2'
      'e4 f3 e3';
    align-items: stretch;
    gap: 1.1rem;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: etape;
  }

  .etape-1 { grid-area: e1; }
  .etape-2 { grid-area: e2; }
  .etape-3 { grid-area: e3; }
  .etape-4 { grid-area: e4; }

  .circuit-etape {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-m);
    padding: 1.5rem 1.6rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .circuit-etape:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-m);
  }

  /* L'icône se pose dans l'angle haut droit, le numéro garde l'angle gauche :
     l'œil lit d'abord l'étape, l'icône la qualifie sans la précéder. */
  .circuit-icone {
    position: absolute;
    top: 1.45rem;
    right: 1.6rem;
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* Discrète au repos, franche au survol : c'est le titre qui porte. */
    opacity: 0.55;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .circuit-etape:hover .circuit-icone {
    opacity: 1;
    transform: translateY(-2px);
  }

  .circuit-num {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  .circuit-etape h3 {
    margin-top: 0.6rem;
    padding-right: 2.6rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .circuit-etape p {
    margin-top: 0.45rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .circuit-fleche {
    display: grid;
    place-items: center;
    color: var(--accent);
    /* 0,55 ne donnait que 2,35:1 sur le papier — sous le seuil de 3:1 des
       éléments graphiques porteurs de sens, et une flèche qui relie deux
       étapes en porte. */
    opacity: 0.8;
  }

  .circuit-fleche svg {
    width: 4.5rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Sens horaire : 1 → 2 en haut, 2 → 3 à droite, 3 → 4 en bas, 4 → 1 à
     gauche. La rotation dispense de dessiner quatre tracés distincts. */
  .fleche-1 { grid-area: f1; }
  .fleche-2 { grid-area: f2; }
  .fleche-3 { grid-area: f3; }
  .fleche-2 svg { transform: rotate(90deg); }
  .fleche-3 svg { transform: rotate(180deg); }

  /* Une fois pivotées, les flèches verticales occupent leur largeur en
     hauteur : à 4,5 rem elles mordaient sur les cartes du dessus et du
     dessous, dont l'interstice ne fait que 47 px. */
  .fleche-2 svg,
  .fleche-4 svg {
    width: 2.4rem;
  }

  /* Sous 760 px, le carré se déplie en colonne : les quatre flèches pointent
     vers le bas, la dernière remontant vers la première n'aurait plus de sens
     et disparaît. */
  @media (max-width: 760px) {
    .circuit {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'e1' 'f1' 'e2' 'f2' 'e3' 'f3' 'e4';
      gap: 0.9rem;
    }

    .fleche-1 svg,
    .fleche-2 svg,
    .fleche-3 svg {
      transform: rotate(90deg);
    }
  }

  /* ------------------------------- Tarifs ------------------------------- */

  .tarif-grid {
    display: grid;
    /* Trois paliers depuis l'ajout de « Signature » : la largeur maximale doit
       suivre, sans quoi la troisième carte passe seule à la ligne. */
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.8rem;
    max-width: 68rem;
    margin-inline: auto;
  }

  /* --------------------- Code couleur des trois packs -------------------- */

  /* Une couleur par offre, reprise partout où l'offre est évoquée : pastille
     de section, badge sur les cartes de démonstration, carte tarifaire. Le
     libellé écrit accompagne toujours la couleur — jamais de couleur seule. */

  .pack-essentiel {
    --pack: var(--pack-essentiel);
    --pack-soft: #e6e6fb;
  }

  /* Teintes volontairement sombres : elles servent aussi de couleur de texte,
     et doivent tenir le contraste AA (4,5:1) sur blanc comme sur --pack-soft. */

  .pack-surmesure {
    --pack: var(--pack-surmesure);
    --pack-soft: #ffe6e1;
  }

  .pack-signature {
    --pack: var(--pack-signature);
    --pack-soft: #f8ecc9;
  }

  .pack-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
    padding: 0.35rem 0.95rem;
    border-radius: 999px;
    background: var(--pack-soft);
    color: var(--pack);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .pack-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--pack);
    flex-shrink: 0;
  }

  .pack-note {
    margin-top: 0.7rem;
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 38rem;
  }

  /* Pastille d'offre posée sur la photo des cartes de démonstration */

  .modele-pack {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--pack);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    box-shadow: 0 2px 10px rgb(18 19 31 / 0.25);
  }

  .tarif-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.85rem;
    align-self: center;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pack, var(--accent));
    text-decoration: none;
  }

  .tarif-demo:hover {
    text-decoration: underline;
  }

  /* ------------------- Modèles complets (Sur mesure, Signature) --------- */

  /* Ces deux paliers ne se démontrent pas par une page hébergée ici mais par un
     site entier, dans son propre dépôt. Ils partagent donc le même bloc : une
     capture qui s'ouvre dans un nouvel onglet, et ce qu'il faut retenir à côté.
     Seul l'accent change, passé en variable sur l'élément. */

  /* L'en-tête de la section ne porte plus que son intitulé : les titres sont
     descendus dans les cadres. On supprime donc sa marge basse, l'espacement
     étant assuré par le margin-top du premier cadre. */
  .section-head-nue {
    margin-bottom: 0;
  }

  /* Habillage commun aux trois offres : chaque pack est présenté dans le même
     cadre, pour qu'on comprenne d'un coup d'œil qu'ils sont de même nature. */
  .pack-bloc {
    max-width: 54rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    margin-inline: auto;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    box-shadow: var(--shadow-m);
  }

  .pack-bloc > .pack-chip {
    margin-top: 0;
  }

  /* Dans un cadre, le titre suit directement la pastille du pack. */
  .pack-bloc > .signature-title {
    margin-top: 0.7rem;
  }

  /* Le visuel flotte à gauche et le texte l'habille : la capture reste en
     paysage, de taille modeste, et le paragraphe reprend toute la largeur
     dès qu'il descend sous l'image. */
  .signature {
    display: block;
  }

  /* Le flottant doit être contenu, sinon la bordure de la carte remonte. */
  .signature::after {
    content: '';
    display: block;
    clear: both;
  }

  /* Les deux modèles d'un pack, côte à côte sous le texte qui vaut pour les
     deux. auto-fit plutôt qu'un nombre fixe : un troisième modèle s'ajouterait
     sans toucher au CSS. */
  .signature-vitrines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.6rem;
    list-style: none;
    margin: 1.8rem 0 0;
    padding: 0;
  }

  .vitrine-tag {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-card);
  }

  .vitrine-nom {
    margin-top: 0.15rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .vitrine-desc {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Le lien porte la couleur du site vers lequel il mène, et non celle de
     l'atelier : c'est le seul endroit de la page où l'on quitte le domaine, et
     la teinte annonce où l'on va. Les trois accents des packs sont sombres —
     ils ont été choisis pour tenir en texte — et se posent ici sur la carte
     blanche : 4,82:1 pour l'hôtel, le plus juste des trois.

     Le repli sur `--accent-strong` couvre le cas où un modèle serait ajouté
     sans accent. */
  .vitrine-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-card, var(--accent-strong));
    text-decoration: none;
  }

  .vitrine-lien:hover {
    text-decoration: underline;
  }

  .vitrine:hover .signature-visuel,
  .vitrine-lien:hover ~ .signature-visuel {
    transform: translateY(-4px);
    box-shadow: var(--shadow-m);
  }

  .signature-visuel {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow-s);
    /* Le liseré reprend l'accent du modèle, comme les cartes au-dessus. */
    outline: 2px solid var(--accent-card);
    outline-offset: -2px;
    display: block;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  @media (max-width: 40rem) {
    .signature-visuel {
      float: none;
      width: 100%;
      max-width: none;
      margin: 0 0 1.2rem;
    }
  }

  .signature-visuel:hover,
  .signature-visuel:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-m);
  }

  .signature-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 8% center;
    display: block;
    transition: transform 0.5s var(--ease-out);
  }

  .signature-visuel:hover img,
  .signature-visuel:focus-visible img {
    transform: scale(1.03);
  }

  /* Pastille d'invitation : discrète au repos, franche au survol. */
  .signature-loupe {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%) translateY(0.4rem);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgb(18 19 31 / 0.82);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }

  .signature-visuel:hover .signature-loupe,
  .signature-visuel:focus-visible .signature-loupe {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (hover: none) {
    /* Sans survol possible, la pastille reste visible : c'est le seul indice
       que la capture est cliquable. */
    .signature-loupe {
      opacity: 1;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 54rem) {
    .signature-visuel {
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }

  /* Le chapô qualifie le pack, pas un modèle : il prend la couleur du pack. */
  .signature-eyebrow {
    color: var(--pack);
  }

  .signature-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.1;
    margin-top: 0.6rem;
  }




  .signature-desc {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .signature-points {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-size: 0.95rem;
    list-style: none;
    padding: 0;
  }

  .signature-points li {
    position: relative;
    padding-left: 1.35rem;
  }

  /* Les points décrivent le pack, pas un modèle : la puce suit --pack.
     Elle utilisait --accent-card, qui ne vit plus que sur les vignettes — les
     puces étaient devenues invisibles. */
  .signature-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--pack);
  }



  .signature-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .tarif-card {
    position: relative;
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-radius: var(--radius-l);
    padding: 2.2rem 2rem;
    box-shadow: var(--shadow-s);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .tarif-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-m);
  }

  /* Chaque carte tarifaire porte la couleur de son pack. */
  .tarif-card {
    border-top: 4px solid var(--pack, var(--accent));
  }

  .tarif-featured {
    border: 2px solid var(--pack, var(--accent));
    border-top-width: 4px;
  }

  /* ------------------ Brillance des cartes au survol -------------------- */

  /**
   * Deux effets distincts, portés par les deux pseudo-éléments de la carte :
   * ::before fait tourner un anneau de lumière sur la bordure, ::after fait
   * traverser un reflet incliné.
   *
   * Aucun `overflow: hidden` sur la carte : le bandeau « Le plus choisi » est
   * en `position: absolute; top: -0.85rem` et dépasse volontairement. Le reflet
   * ne se déplace donc pas par translation — il déplace sa POSITION DE FOND,
   * qui ne peut rien faire déborder.
   *
   * Les épaisseurs de bordure sont reprises en variables : le pseudo-élément
   * est calé sur la boîte de bordure, or `inset` se mesure depuis la boîte de
   * padding. Sans ces valeurs, l'anneau se décalerait de la bordure haute de
   * 4 px, et de 1 px ailleurs.
   */
  .tarif-card {
    --bord: 1px;
    --bord-haut: 4px;
  }

  .tarif-featured {
    --bord: 2px;
  }

  .tarif-card::before,
  .tarif-card::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    /* Décoratifs : ils ne doivent jamais intercepter le clic destiné au bouton
       de la carte, ni apparaître aux outils d'accessibilité. */
    pointer-events: none;
    opacity: 0;
  }

  /* L'anneau. Le dégradé conique va de la couleur du pack au blanc de la carte,
     trois fois sur le tour : c'est cette alternance qui donne le tournoiement,
     la rotation ne faisant que la promener. */
  .tarif-card::before {
    inset: calc(var(--bord-haut) * -1) calc(var(--bord) * -1) calc(var(--bord) * -1);
    padding: 2px;
    background: conic-gradient(
      from var(--angle-brillance),
      var(--pack, var(--accent)),
      var(--paper-raised),
      var(--pack, var(--accent)),
      var(--paper-raised),
      var(--pack, var(--accent))
    );
    /* Ne garder que l'anneau : on peint la boîte entière, puis on retire la
       zone de contenu. Les deux masques se soustraient, il reste le padding —
       soit exactement les 2 px du pourtour. */
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    transition: opacity 0.35s var(--ease-out);
  }

  /* Le reflet. Teinté et non blanc : la carte EST blanche (--paper-raised),
     un reflet blanc y serait rigoureusement invisible. L'inclinaison de 105°
     donne la diagonale demandée — 90° serait une barre verticale. */
  .tarif-card::after {
    inset: 0;
    /* Bande étroite : 38 %–62 % couvraient 60 % de la largeur de la carte, ce
       qui donnait un lavis de couleur et non un éclat. 44 %–56 % la ramènent à
       30 %, soit une vraie bande de lumière qui passe. */
    background-image: linear-gradient(
      105deg,
      transparent 44%,
      var(--pack, var(--accent)) 50%,
      transparent 56%
    );
    background-repeat: no-repeat;
    /* Deux fois et demie la largeur : la bande reste fine une fois inclinée,
       et il reste de la course de part et d'autre pour entrer et sortir. */
    background-size: 250% 100%;
    background-position: -75% 0;
  }

  /* Le survol seulement là où il existe vraiment : sur un écran tactile, :hover
     reste collé après le toucher et l'animation tournerait indéfiniment. */
  @media (hover: hover) {
    .tarif-card:hover::before {
      opacity: 1;
      animation: anneau-tournoie 4s linear infinite;
    }

    /* `linear` et non `--ease-out` : cette courbe est très chargée au départ,
       la bande franchissait la carte en un quart du temps puis rampait hors
       champ pendant le reste. Un reflet traverse à vitesse constante. */
    .tarif-card:hover::after {
      animation: reflet-traverse 1.1s linear;
    }
  }

  @keyframes anneau-tournoie {
    to {
      --angle-brillance: 360deg;
    }
  }

  @keyframes reflet-traverse {
    0% {
      background-position: -75% 0;
      opacity: 0;
    }
    12% {
      opacity: 0.16;
    }
    88% {
      opacity: 0.16;
    }
    100% {
      background-position: 175% 0;
      opacity: 0;
    }
  }

  /* En mouvement réduit, l'anneau se pose sans tourner et le reflet ne part
     pas : la carte reste signalée au survol, sans rien qui bouge. */
  @media (prefers-reduced-motion: reduce) {
    .tarif-card::before {
      transition: none;
    }

    .tarif-card:hover::before {
      animation: none;
    }

    .tarif-card:hover::after {
      animation: none;
    }
  }

  .tarif-badge {
    position: absolute;
    /* Au-dessus du reflet : le bandeau chevauche le bord de la carte, or le
       reflet s'arrête à ce bord. Sans ce plan, la bande le couperait net à
       l'horizontale — un défaut de rendu, pas un effet de lumière. */
    z-index: 1;
    top: -0.85rem;
    /* Coin haut droit : le nom du pack occupe le coin gauche, le bandeau ne
       doit jamais venir le serrer — surtout sur trois colonnes, où les cartes
       sont étroites. */
    right: 1.5rem;
    left: auto;
    background: var(--pack, var(--accent));
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
  }

  .tarif-name {
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tarif-price {
    margin-top: 0.7rem;
    font-size: 2.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tarif-list {
    list-style: none;
    margin: 1.4rem 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .tarif-list li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .tarif-list li::before {
    content: '✓';
    color: var(--pack, var(--accent));
    font-weight: 700;
    flex-shrink: 0;
  }

  .tarif-btn {
    margin-top: auto;
  }

  .tarif-card .btn-ghost {
    color: var(--pack, var(--accent));
  }

  .tarif-card .btn-primary {
    background: var(--pack, var(--accent));
    box-shadow: 0 8px 22px rgb(18 19 31 / 0.18);
  }

  .tarif-card .btn-primary:hover {
    filter: brightness(0.92);
  }

  .tarif-name {
    color: var(--pack, var(--muted));
  }

  .tarif-note {
    margin-top: 1.8rem;
    font-size: 0.95rem;
    color: var(--muted);
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  /* ------------------------------- Contact ------------------------------ */

  .contact-section {
    position: relative;
    overflow: hidden;
    /* Fond statique conservé : il sert de repli si JavaScript est désactivé. */
    background:
      radial-gradient(60% 120% at 15% 0%, rgb(83 82 209 / 0.14), transparent 60%),
      radial-gradient(50% 100% at 90% 100%, rgb(255 107 87 / 0.12), transparent 60%),
      #e0dcd0;
  }

  .contact-section .container {
    position: relative;
  }

  .contact-inner {
    text-align: center;
    max-width: 46rem;
  }

  .contact-title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .contact-title em {
    font-style: normal;
    color: var(--accent);
  }

  .contact-lede {
    margin-top: 1.1rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  .contact-btn {
    font-size: 1.0625rem;
  }

  .contact-tel {
    color: var(--ink);
  }

  /* ---------------------------- Portfolio ------------------------------- */


  /* Le carrousel repose sur le défilement natif avec accroche : sans
     JavaScript, la piste reste parcourable au doigt et au clavier. Les
     flèches ne font qu'ajouter du confort. */
  .carrousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  /* Sur grand écran, la piste se resserre à 80 % : centrée, elle laisse voir
     ses voisines de part et d'autre sans courir toute la largeur de la page. */
  @media (min-width: 62rem) {
    .carrousel {
      width: 80%;
      margin-inline: auto;
    }
  }

  .carrousel-piste {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-x: auto;
    /* `proximity` et non `mandatory` : l'accroche stricte se bat avec le
       défilement programmé du minuteur, qui vise le centre au pixel près. */
    scroll-snap-type: x proximity;
    /* Aucune marge de centrage : la piste commence et finit sur une fiche, sans
       blanc d'aucun côté. La contrepartie est assumée — aux deux bouts, la fiche
       courante se cale contre le bord au lieu d'atteindre le milieu.
       Cette marge avait de surcroît un effet de bord sévère : elle rognait la
       boîte de contenu contre laquelle se calcule un `flex-basis` en
       pourcentage, et les fiches tombaient à 111 px sur mobile. */
    padding-inline: 0.4rem;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .carrousel-piste::-webkit-scrollbar {
    display: none;
  }

  .carrousel-item {
    flex: 0 0 clamp(15rem, 30%, 18rem);
    /* `center` et non `start` : c'est la fiche courante qu'on amène au milieu. */
    scroll-snap-align: center;
    transition: opacity 0.4s var(--ease-out);
  }

  /* Les voisines s'effacent légèrement : le regard sait où il doit être sans
     qu'on ait besoin d'un point ou d'un cadre en plus. */
  .carrousel[data-defilable='oui'] .carrousel-item:not([data-courante]) {
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .carrousel-item {
      transition: none;
    }
  }

  .carrousel-fleche {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(18 19 31 / 0.14);
    background: var(--paper-raised);
    color: var(--ink);
    font-size: 1.0625rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.25s var(--ease-out),
      background-color 0.25s,
      opacity 0.25s;
  }

  .carrousel-fleche:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--accent-soft);
  }

  .carrousel-fleche:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Piste entièrement visible : les flèches n'ont rien à faire défiler. On les
     masque avec `visibility` et non `display`, afin qu'elles conservent leur
     place : sinon la piste s'élargirait, la mesure changerait, et l'état
     oscillerait entre défilable et non défilable. */
  .carrousel[data-defilable='non'] .carrousel-fleche {
    visibility: hidden;
  }

  /* `justify-content` ne modifie que la position du contenu, pas la largeur de
     la piste : aucun risque de boucle, et le centrage n'ampute pas la course
     puisqu'il n'y a précisément rien à faire défiler. */
  .carrousel[data-defilable='non'] .carrousel-piste {
    justify-content: center;
  }

  /* Fiche projet */

  .projet {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.3rem 1.5rem;
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    border: 1px solid rgb(18 19 31 / 0.08);
    border-top: 3px solid var(--accent-card);
    box-shadow: var(--shadow-s);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .projet:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-m);
  }

  .projet-icone {
    width: 3rem;
    height: 3rem;
    border-radius: 10px;
    object-fit: contain;
    background: var(--paper);
    padding: 0.3rem;
    border: 1px solid rgb(18 19 31 / 0.07);
  }

  /* Repli quand le favicon du site n'est pas disponible. */
  .projet-monogramme {
    display: grid;
    place-items: center;
    padding: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent-card);
    border-color: transparent;
  }

  .projet-nom {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .projet-domaine {
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--accent-card-text, var(--accent-card));
    font-weight: 600;
    word-break: break-all;
  }

  .projet-desc {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
    flex-grow: 1;
  }

  /* Le lien porte le thème de sa fiche, comme le domaine juste au-dessus —
     c'était le dernier lien sortant de la page resté sur l'indigo de l'atelier.
     Les quatre `accentText` sont taillés pour le texte : 4,75 à 4,82:1. */
  .projet-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-card-text, var(--accent));
  }

  .projet:hover .projet-lien .arrow {
    transform: translate(2px, -2px);
  }

  .projet-lien .arrow {
    transition: transform 0.3s var(--ease-out);
  }

  @media (max-width: 640px) {
    .carrousel {
      grid-template-columns: 1fr;
    }

    .carrousel-fleche {
      display: none;
    }

    /* `clamp` et non `80 %` seul : sur les écrans les plus étroits, 80 % passe
       sous la largeur lisible. Le plancher de 15 rem est celui du grand écran. */
    .carrousel-item {
      flex-basis: clamp(15rem, 80%, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carrousel-piste {
      scroll-behavior: auto;
    }
  }

  /* ----------------------------- Responsive ----------------------------- */

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }


    .modele-grid {
      grid-template-columns: 1fr;
    }

    /* En colonne unique, la carte est bien plus étroite : on lui rend sa
       hauteur et sa typographie pleine taille pour rester lisible au doigt. */
    .modele-card {
      min-height: 22rem;
    }

    .modele-info {
      padding: 1.5rem 1.6rem 1.7rem;
    }

    .modele-name {
      font-size: 1.35rem;
    }

    .modele-desc,
    .modele-link {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  /**
   * Carrousel du portfolio.
   *
   * Il avance seul toutes les 2,5 s en amenant la fiche courante au CENTRE de la
   * piste, et il boucle : sans bouclage, la lecture automatique s'arrêterait au
   * bout de trois pas et resterait figée sur la dernière fiche.
   *
   * Les flèches ne font pas qu'avancer d'un cran, elles IMPOSENT LE SENS :
   * cliquer sur « précédent » fait repartir le défilement automatique vers la
   * gauche, et il y reste. Le minuteur redémarre à chaque clic, pour ne pas
   * enchaîner un pas manuel et un pas automatique coup sur coup.
   *
   * Le défilement natif reste la source de vérité : on le pilote, on ne le
   * remplace pas. Un glissement à la main est donc respecté, et l'index se
   * réaligne ensuite sur la fiche la plus proche du centre.
   */
  document.querySelectorAll<HTMLElement>('[data-carrousel]').forEach((carrousel) => {
    const piste = carrousel.querySelector<HTMLElement>('[data-carrousel-piste]');
    const prec = carrousel.querySelector<HTMLButtonElement>('[data-carrousel-prec]');
    const suiv = carrousel.querySelector<HTMLButtonElement>('[data-carrousel-suiv]');
    if (!piste || !prec || !suiv) return;

    const INTERVALLE = 2500;
    const mouvementReduit = window.matchMedia('(prefers-reduced-motion: reduce)');
    const fiches = (): HTMLElement[] => Array.from(piste.children) as HTMLElement[];

    /** Les fiches d'origine, avant tout clonage. */
    const originales = fiches();
    const N = originales.length;

    let index = 0;
    let sens = 1;
    let minuteur: number | undefined;
    /** Fin présumée du dernier défilement programmé (horodatage). */
    let finDuProgramme = 0;
    /** Distance parcourue par le geste en cours, cumulée sur ses `scroll`. */
    let cumulGeste = 0;
    let dernierX = 0;
    /** Vrai dès qu'un doigt, un stylet ou une molette manœuvre la piste. */
    let gesteEnCours = false;
    /** Abscisse du pointeur au début du geste, pour la voie `pointermove`. */
    let departPointeur: number | null = null;

    /**
     * Scrutabilité mesurée sur les fiches D'ORIGINE : une fois la série clonée,
     * la piste déborde toujours, et la question « y a-t-il de quoi défiler ? »
     * n'aurait plus de réponse honnête.
     */
    const defilable = (): boolean => {
      if (N < 2) return false;
      const ecart = parseFloat(getComputedStyle(piste).columnGap) || 0;
      const contenu =
        originales.reduce((t, x) => t + x.getBoundingClientRect().width, 0) + ecart * (N - 1);
      return contenu - piste.clientWidth > 2;
    };

    /**
     * Chaîne continue : la série est clonée AVANT et APRÈS l'originale, et l'on
     * se tient toujours dans le jeu du milieu. Quand un pas en fait sortir, on
     * rembobine d'une série d'un saut sec — invisible, puisqu'il retombe sur une
     * fiche identique entourée des mêmes voisines. La dernière et la première se
     * suivent donc sans rupture, dans les deux sens.
     *
     * Les copies sont créées ici et non dans le balisage : la page servie ne
     * contient que les quatre vraies fiches, et sans JavaScript le carrousel
     * reste une liste honnête de quatre projets.
     *
     * Elles sont retirées de l'arbre d'accessibilité et du parcours au clavier :
     * un lecteur d'écran annoncerait sinon douze réalisations, et la tabulation
     * traverserait trois fois les mêmes liens.
     */
    const cloner = (): void => {
      if (N < 2 || piste.dataset.clone === 'oui') return;
      const copie = (source: HTMLElement): HTMLElement => {
        const c = source.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.setAttribute('data-clone', '');
        c.querySelectorAll('a').forEach((a) => a.setAttribute('tabindex', '-1'));
        return c;
      };
      const avantSerie = originales.map(copie);
      const apresSerie = originales.map(copie);
      apresSerie.forEach((c) => piste.append(c));
      avantSerie.reverse().forEach((c) => piste.prepend(c));
      piste.dataset.clone = 'oui';
    };

    const marquer = (i: number): void => {
      fiches().forEach((f, j) => {
        if (j === i) f.setAttribute('data-courante', '');
        else f.removeAttribute('data-courante');
      });
    };

    /**
     * Le décalage est calculé en RELATIF, à partir des rectangles rendus, et
     * non depuis `offsetLeft` : celui-ci se mesure par rapport à l'`offsetParent`
     * — ici le conteneur du carrousel, pas la piste —, alors que `scrollLeft`
     * se compte dans le repère de la piste. Mélanger les deux visait à côté et
     * le défilement restait bloqué à 0.
     */
    const centrer = (i: number, doux = true): void => {
      const f = fiches()[i];
      if (!f) return;
      const rp = piste.getBoundingClientRect();
      const rf = f.getBoundingClientRect();
      const ecart = rf.left + rf.width / 2 - (rp.left + rp.width / 2);
      // On note jusqu'à quand ce défilement est le nôtre : les `scroll` émis
      // pendant ce laps ne doivent pas être lus comme un geste de l'utilisateur.
      finDuProgramme = performance.now() + (doux && !mouvementReduit.matches ? 700 : 80);
      piste.scrollTo({
        left: piste.scrollLeft + ecart,
        // `instant` et non `auto` : `auto` signifie « suis la feuille de style »,
        // et la piste y déclare `scroll-behavior: smooth`. Le repli destiné au
        // mouvement réduit animait donc quand même — exactement ce qu'il devait
        // éviter. Même remarque pour le recentrage après redimensionnement.
        behavior: doux && !mouvementReduit.matches ? 'smooth' : 'instant',
      });
      marquer(i);
    };

    /**
     * Ramène la position dans le jeu du milieu, d'un saut sec. Appelé AVANT
     * chaque pas : la correction se fait donc à l'instant précis où l'on
     * s'apprête à animer, et l'œil ne voit qu'un seul mouvement.
     */
    const rembobiner = (): void => {
      if (piste.dataset.clone !== 'oui') return;
      let corrige = false;
      while (index >= 2 * N) {
        index -= N;
        corrige = true;
      }
      while (index < N) {
        index += N;
        corrige = true;
      }
      if (corrige) centrer(index, false);
    };

    /** Avance de `pas` fiches. Sans clones, on boucle par modulo. */
    const aller = (pas: number): void => {
      const total = fiches().length;
      if (total === 0) return;
      if (piste.dataset.clone === 'oui') {
        rembobiner();
        index += pas;
      } else {
        index = (index + pas + total) % total;
      }
      centrer(index);
    };

    const arreter = (): void => {
      if (minuteur !== undefined) {
        window.clearInterval(minuteur);
        minuteur = undefined;
      }
    };

    /**
     * La lecture automatique ne démarre que si elle a un sens : jamais en
     * mouvement réduit — du contenu qui bouge tout seul y est précisément ce
     * qu'on demande d'éviter — et jamais si tout tient déjà à l'écran.
     */
    const lancer = (): void => {
      arreter();
      if (mouvementReduit.matches || !defilable()) return;
      minuteur = window.setInterval(() => aller(sens), INTERVALLE);
    };

    // Une flèche impose le sens, avance d'un cran, et remet le compteur à zéro.
    prec.addEventListener('click', () => {
      sens = -1;
      aller(-1);
      lancer();
    });
    suiv.addEventListener('click', () => {
      sens = 1;
      aller(1);
      lancer();
    });

    /**
     * Distance minimale pour qu'un mouvement compte comme un balayage. En
     * dessous, c'est une tape, un tremblement, ou l'accroche qui replace la
     * piste — rien qui doive changer le sens de lecture.
     */
    const SEUIL_BALAYAGE = 12;

    /**
     * Le doigt posé suspend le minuteur. Sur écran tactile il n'y a pas de
     * survol pour le faire, et un pas automatique en plein geste arracherait la
     * piste des doigts. C'est le seul rôle qui reste aux événements de pointeur
     * ici — la DIRECTION, elle, se lit sur le défilement, plus bas.
     */
    /**
     * Ces deux écouteurs ne mesurent rien : ils DÉCLARENT que l'utilisateur
     * manœuvre. Le garde-temps ci-dessous ne suffisait pas — il ignore les
     * défilements pendant 700 ms après chaque pas automatique, or un pas tombe
     * toutes les 2,5 s : un balayage sur quatre atterrissait dans cette fenêtre
     * et restait sans effet. C'est ce qui donnait un carrousel qui « ne change
     * pas de sens », par intermittence.
     *
     * `wheel` couvre le pavé tactile, qui n'émet aucun événement de pointeur.
     */
    const debutDuGeste = (): void => {
      gesteEnCours = true;
      cumulGeste = 0;
      arreter();
    };

    /**
     * Clôture du geste : on arrête le sens et on RELANCE le minuteur.
     *
     * Appelée par deux chemins, et il faut les deux. Le défilement s'arrête de
     * lui-même après l'inertie — mais une simple TAPE ne défile pas du tout :
     * sans la seconde voie, `pointerdown` aurait éteint le minuteur pour de
     * bon. C'est le défaut qu'avait introduit la version précédente.
     *
     * L'opération est idempotente : le premier des deux chemins qui arrive fait
     * le travail, le second ne trouve plus de geste ouvert.
     */
    const cloreLeGeste = (): void => {
      if (!gesteEnCours) return;
      if (Math.abs(cumulGeste) >= SEUIL_BALAYAGE) sens = cumulGeste > 0 ? 1 : -1;
      gesteEnCours = false;
      cumulGeste = 0;
      departPointeur = null;
      lancer();
    };

    let finGeste: number | undefined;
    const armerLaCloture = (delai: number): void => {
      window.clearTimeout(finGeste);
      finGeste = window.setTimeout(cloreLeGeste, delai);
    };

    piste.addEventListener(
      'pointerdown',
      (e) => {
        debutDuGeste();
        departPointeur = e.clientX;
      },
      { passive: true }
    );
    piste.addEventListener('wheel', debutDuGeste, { passive: true });

    /**
     * Seconde voie, indépendante de la première : le déplacement du DOIGT.
     *
     * La voie principale cumule les `scroll` du geste. Elle est juste, mais elle
     * suppose que le navigateur les émette avant que le geste ne se termine — ce
     * que je n'ai pas pu vérifier ici, aucun de mes harnais ne sachant produire
     * un vrai défilement tactile. Celle-ci ne dépend que de `pointermove`, qui
     * arrive dès les premiers pixels, avant même que la piste ait bougé.
     *
     * Le signe est inversé : un doigt qui va vers la GAUCHE tire le contenu dans
     * le même sens et fait défiler vers l'AVANT.
     *
     * La première des deux qui atteint le seuil décide ; l'autre confirmera.
     */
    piste.addEventListener(
      'pointermove',
      (e) => {
        if (!gesteEnCours || departPointeur === null) return;
        const parcouru = departPointeur - e.clientX;
        if (Math.abs(parcouru) >= SEUIL_BALAYAGE) sens = parcouru > 0 ? 1 : -1;
      },
      { passive: true }
    );
    // 350 ms après le relâchement : le temps que l'inertie retombe et que
    // l'accroche ait joué. Un défilement en cours réarmera ce délai.
    window.addEventListener('pointerup', () => armerLaCloture(350), { passive: true });
    window.addEventListener('pointercancel', () => armerLaCloture(350), { passive: true });

    // Le survol et le focus suspendent : sans cela, la fiche qu'on s'apprête à
    // cliquer se dérobe. C'est aussi la porte de sortie qu'on doit à tout
    // contenu qui bouge de lui-même.
    carrousel.addEventListener('mouseenter', arreter);
    carrousel.addEventListener('mouseleave', lancer);
    carrousel.addEventListener('focusin', arreter);
    carrousel.addEventListener('focusout', (e) => {
      if (!carrousel.contains(e.relatedTarget as Node)) lancer();
    });

    /**
     * Un glissement à la main déplace la piste sans passer par `aller` :
     * l'index se réaligne sur la fiche la plus proche du centre, sinon le pas
     * suivant repartirait d'ailleurs. Et le geste IMPOSE LE SENS, comme une
     * flèche.
     *
     * La direction se lit sur le défilement lui-même, et non sur les événements
     * de pointeur — c'était l'erreur de la première version. Sur écran tactile,
     * le navigateur émet `pointercancel` dès qu'il prend la main sur le
     * défilement, c'est-à-dire au tout début du balayage : la distance mesurée à
     * ce moment-là vaut zéro et n'atteignait jamais le seuil. Au trackpad, il
     * n'y a même pas d'événement de pointeur.
     *
     * Reste à ne pas confondre le geste avec mes propres recentrages : d'où
     * `finDuProgramme`, qui marque le laps pendant lequel le mouvement m'
     * appartient.
     */
    let ralenti: number | undefined;
    piste.addEventListener(
      'scroll',
      () => {
        const x = piste.scrollLeft;
        const delta = x - dernierX;
        dernierX = x;
        // Pendant un geste on compte tout ; hors geste, on écarte ce que le
        // minuteur vient de provoquer.
        if (gesteEnCours || performance.now() >= finDuProgramme) cumulGeste += delta;

        window.clearTimeout(ralenti);
        ralenti = window.setTimeout(() => {
          // Le défilement s'est tu : c'est l'autre voie de clôture.
          if (gesteEnCours) cloreLeGeste();
          else cumulGeste = 0;
          const rp = piste.getBoundingClientRect();
          const milieu = rp.left + rp.width / 2;
          let plusProche = 0;
          let ecartMin = Infinity;
          fiches().forEach((f, i) => {
            const rf = f.getBoundingClientRect();
            const centre = rf.left + rf.width / 2;
            const d = Math.abs(centre - milieu);
            if (d < ecartMin) {
              ecartMin = d;
              plusProche = i;
            }
          });
          if (plusProche !== index) {
            index = plusProche;
            marquer(index);
            // Un glissement à la main peut emmener loin dans un jeu cloné : on
            // y revient, faute de quoi la course finirait par s'épuiser d'un
            // côté et la chaîne se romprait.
            rembobiner();
          }
        }, 120);
      },
      { passive: true }
    );

    const remesurer = (): void => {
      const peutDefiler = defilable();
      carrousel.dataset.defilable = peutDefiler ? 'oui' : 'non';
      // Les clones n'ont d'objet que si la série déborde : à quatre fiches
      // tenant dans la largeur, il n'y a rien à enchaîner.
      if (peutDefiler && piste.dataset.clone !== 'oui') {
        cloner();
        index = N; // on se place d'emblée dans le jeu du milieu
      }
      centrer(index, false);
      dernierX = piste.scrollLeft;
      // Le minuteur n'est PAS relancé ici : un redimensionnement ne doit pas
      // repousser l'échéance. Il est démarré une fois, à l'entrée à l'écran.
    };

    /**
     * L'observateur surveille le CONTENEUR, pas la piste — et c'est la
     * différence entre un carrousel qui tourne et un qui reste sur place.
     *
     * Une version antérieure écrivait un `padding` de centrage sur la piste :
     * observer la piste revenait alors à se notifier soi-même, et le minuteur
     * repartait de zéro à chaque tour. Le padding a disparu, mais la règle
     * demeure — on n'observe pas ce que l'on modifie.
     *
     * Référence retenue par ailleurs : sans elle, l'observateur peut être
     * ramassé par le GC et cesser silencieusement de notifier.
     */
    const observateur = new ResizeObserver(remesurer);
    observateur.observe(carrousel);
    window.addEventListener('resize', remesurer, { passive: true });
    mouvementReduit.addEventListener('change', remesurer);

    // Rien ne tourne tant que la section n'est pas à l'écran.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entrees) => {
          for (const e of entrees) {
            if (e.isIntersecting) lancer();
            else arreter();
          }
        },
        { threshold: 0.2 }
      ).observe(carrousel);
    }

    remesurer();
  });
</script>
