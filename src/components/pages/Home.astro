  }

  .contact-tel {
    color: var(--ink);
  }

  /* ---------------------------- Portfolio ------------------------------- */


  /* Le carrousel repose sur le défilement natif avec accroche : sans
     JavaScript, la piste reste parcourable au doigt et au clavier. Les
     flèches ne font qu'ajouter du confort. */
  .carrousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .carrousel-piste {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-x: auto;
    /* `proximity` et non `mandatory` : quand la course restante est plus
       courte qu'une fiche, l'accroche stricte ramènerait systématiquement au
       début et le carrousel paraîtrait bloqué. */
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .carrousel-piste::-webkit-scrollbar {
    display: none;
  }

  .carrousel-item {
    flex: 0 0 clamp(15rem, 30%, 18rem);
    scroll-snap-align: start;
  }

  .carrousel-fleche {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgb(18 19 31 / 0.14);
    background: var(--paper-raised);
    color: var(--ink);
    font-size: 1.0625rem;
    box-shadow: var(--shadow-s);
    transition:
      transform 0.25s var(--ease-out),
      background-color 0.25s,
      opacity 0.25s;
  }

  .carrousel-fleche:hover:not(:disabled) {
    transform: translateY(-2px);
    background: var(--accent-soft);
  }

  .carrousel-fleche:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Piste entièrement visible : les flèches n'ont rien à faire défiler. On les
     masque avec `visibility` et non `display`, afin qu'elles conservent leur
     place : sinon la piste s'élargirait, la mesure changerait, et l'état
     oscillerait entre défilable et non défilable. */
  .carrousel[data-defilable='non'] .carrousel-fleche {
    visibility: hidden;
  }

  /* `justify-content` ne modifie que la position du contenu, pas la largeur de
     la piste : aucun risque de boucle, et le centrage n'ampute pas la course
     puisqu'il n'y a précisément rien à faire défiler. */
  .carrousel[data-defilable='non'] .carrousel-piste {
    justify-content: center;
  }

  /* Fiche projet */

  .projet {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.3rem 1.5rem;
    border-radius: var(--radius-m);
