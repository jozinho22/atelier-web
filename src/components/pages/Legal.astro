---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { splitPath } from '../../lib/i18n';
import { legal, type LegalSection } from '../../i18n/legal';

const { lang } = splitPath(Astro.url.pathname);
const t = legal[lang];
// Annotation explicite : unifie les deux variantes `as const` du
// dictionnaire pour itérer sans heurt sur les sections.
const sections: readonly LegalSection[] = t.sections;
---

<Base title={t.meta.title} description={t.meta.description}>
  <Header />
  <main class="section">
    <div class="container legal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="section-title">{t.title}</h1>

      <!-- TODO : compléter avec les informations réelles avant la mise en ligne. -->
      {
        sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>
                {paragraph.map((segment) =>
                  'br' in segment ? (
                    <br />
                  ) : 'href' in segment ? (
                    <a href={segment.href}>{segment.link}</a>
                  ) : (
                    segment.text
                  )
                )}
              </p>
            ))}
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 46rem;
  }

  .legal h1 {
    margin-bottom: 1rem;
  }

  .legal section {
    margin-top: 2.4rem;
  }

  .legal h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
  }

  .legal p {
    color: var(--ink-soft);
    line-height: 1.75;
  }

  .legal p + p {
    margin-top: 0.8rem;
  }

  .legal a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
