---
import Base from '../../layouts/Base.astro';
import DemoBar from '../DemoBar.astro';
import MenuMobile from '../MenuMobile.astro';
import AuroraBackdrop from '../AuroraBackdrop.astro';
import { splitPath, localePath } from '../../lib/i18n';
import { withBase } from '../../lib/paths';
import { common } from '../../i18n/common';
import { batiment } from '../../i18n/batiment';

const { lang } = splitPath(Astro.url.pathname);
const t = batiment[lang];
const tc = common[lang];

/**
 * Photos des chantiers, dans l'ordre des réalisations du dictionnaire.
 * Le nom du fichier ne dépend pas de la langue, il reste donc ici.
 */
const PHOTOS = ['longere.webp', 'extension.webp', 'salle-de-bain.webp'];

const liensMenu = [
  { href: '#services', label: t.header.nav.services },
  { href: '#realisations', label: t.header.nav.realisations },
  { href: '#zone', label: t.header.nav.zone },
];
---

<Base title={t.meta.title} description={t.meta.description}>
  <DemoBar label={t.demoLabel} />
  <div class="bat">
    <!-- ============================ EN-TÊTE ============================ -->
    <header class="b-header">
      <div class="wrap b-header-inner">
        <a class="b-logo" href="#top" aria-label={t.header.logoAria}>
          <span class="b-logo-mark" aria-hidden="true">M</span>
          <span>{t.header.logoName}<br /><small>{t.header.logoSub}</small></span>
        </a>
        <nav aria-label={t.header.navAria}>
          <ul class="b-nav">
            <li><a href="#services">{t.header.nav.services}</a></li>
            <li><a href="#realisations">{t.header.nav.realisations}</a></li>
            <li><a href="#zone">{t.header.nav.zone}</a></li>
          </ul>
        </nav>
        <a class="b-btn b-btn-plein" href="#devis">{t.header.cta}</a>
        <MenuMobile variante="batiment" lang={lang} liens={liensMenu} cta={{ href: '#devis', label: t.header.cta }} />
      </div>
      <div class="b-hazard" aria-hidden="true"></div>
    </header>

    <main id="top">
      <!-- ============================= HERO ============================= -->
      <section class="b-hero">
        <div class="b-hero-bg" aria-hidden="true">
          <AuroraBackdrop
            colors={['#f2b705', '#4a6096', '#d97b29']}
            background="#16181f"
            speed={0.8}
            grain={0.06}
          />
          <span class="b-beam b-beam-1"></span>
          <span class="b-beam b-beam-2"></span>
          <span class="b-blueprint"></span>
        </div>
        <div class="wrap b-hero-inner">
          <p class="b-hero-kicker">{t.hero.kicker}</p>
          <h1 class="b-hero-title">
            {t.hero.title.line1}<br />{t.hero.title.line2Before}<span class="b-jaune">{t.hero.title.line2Accent}</span>{t.hero.title.line2After}<br />{t.hero.title.line3}
          </h1>
          <p class="b-hero-lede">{t.hero.lede}</p>
          <div class="b-hero-actions">
            <a class="b-btn b-btn-plein" href="#devis">{t.hero.ctaDevis}</a>
            <a class="b-btn b-btn-ligne" href="#realisations">{t.hero.ctaChantiers}</a>
          </div>
          <ul class="b-badges" aria-label={t.hero.badgesAria}>
            {t.hero.badges.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </section>

      <!-- =========================== CHIFFRES ============================ -->
      <section class="b-chiffres" aria-label={t.chiffres.aria}>
        <div class="wrap b-chiffres-grid">
          {t.chiffres.items.map((c, i) => (
            <div class="b-chiffre reveal" style={`--reveal-delay: ${i * 0.08}s`}>
              <p class="b-chiffre-val"><span data-countup={c.valeur}>{c.valeur}</span><span class="b-unite">{c.unite}</span></p>
              <p class="b-chiffre-label">{c.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== SERVICES ============================ -->
      <section id="services" class="b-section">
        <div class="wrap">
          <p class="b-eyebrow reveal">{t.services.eyebrow}</p>
          <h2 class="b-title reveal">{t.services.title}</h2>
          <div class="b-services">
            {t.services.items.map((s, i) => (
              <article class="b-service reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <span class="b-service-icon" aria-hidden="true">{s.icon}</span>
                <h3>{s.name}</h3>
                <p>{s.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ========================== RÉALISATIONS ========================= -->
      <section id="realisations" class="b-section b-section-sombre">
        <div class="wrap">
          <p class="b-eyebrow reveal">{t.realisations.eyebrow}</p>
          <h2 class="b-title reveal">{t.realisations.title}</h2>
          <div class="b-realisations">
            {t.realisations.items.map((r, i) => (
              <article class="b-realisation reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <div class="b-realisation-visuel">
                  <img
                    src={withBase(`modeles/batiment/${PHOTOS[i]}`)}
                    alt=""
                    width="1600"
                    height="873"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="b-photo-tag">{r.tag}</span>
                </div>
                <div class="b-realisation-info">
                  <h3>{r.titre}</h3>
                  <p>📍 {r.lieu} · ⏱ {r.duree}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================= ZONE ============================== -->
      <section id="zone" class="b-section">
        <div class="wrap b-zone">
          <div class="reveal">
            <p class="b-eyebrow">{t.zone.eyebrow}</p>
            <h2 class="b-title">{t.zone.title}</h2>
            <p class="b-texte">{t.zone.texte}</p>
            <ul class="b-villes">
              {t.zone.villes.map((v) => <li>{v}</li>)}
            </ul>
          </div>
          <div class="b-radar reveal" aria-hidden="true">
            <span class="b-radar-cercle c-1"></span>
            <span class="b-radar-cercle c-2"></span>
            <span class="b-radar-cercle c-3"></span>
            <span class="b-radar-centre">🏠</span>
          </div>
        </div>
      </section>

      <!-- ============================= DEVIS ============================= -->
      <section id="devis" class="b-devis">
        <div class="wrap b-devis-inner reveal">
          <h2>{t.devis.title}</h2>
          <p>{t.devis.texte}</p>
          <div class="b-devis-actions">
            <a class="b-btn b-btn-sombre" href="tel:+33200000000">📞 {t.devis.phone}</a>
            <a class="b-btn b-btn-ligne-sombre" href="mailto:contact@moreau-renovation.example">✉️ {t.devis.email}</a>
          </div>
          <p class="b-devis-note">{t.devis.note}</p>
        </div>
      </section>
    </main>

    <footer class="b-footer">
      <div class="wrap b-footer-inner">
        <p>{t.footer.legal}</p>
        <p>{tc.demo.madeBy} <a href={localePath(lang, '')}>Studio Caducée</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Palette du modèle : charbon, jaune chantier, robustesse. */
  .bat {
    --b-ink: #22252e;
    --b-ink-deep: #16181f;
    --b-jaune: #f2b705;
    --b-jaune-deep: #d9a404;
    --b-paper: #f4f4f6;
    --b-muted: #666b78;
    font-family: var(--font-sans);
    color: var(--b-ink);
    background: var(--b-paper);
  }

  .wrap {
    width: min(70rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  .b-jaune {
    color: var(--b-jaune);
  }

  /* ------------------------------ En-tête ------------------------------- */

  .b-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(244 244 246 / 0.92);
    backdrop-filter: blur(10px);
  }

  .b-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.75rem;
  }

  .b-hazard {
    height: 6px;
    background: repeating-linear-gradient(
      -45deg,
      var(--b-jaune) 0 14px,
      var(--b-ink) 14px 28px
    );
  }

  .b-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.05;
    letter-spacing: 0.04em;
  }

  .b-logo small {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-muted);
  }

  .b-logo-mark {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    background: var(--b-ink);
    color: var(--b-jaune);
    font-size: 1.25rem;
    font-weight: 800;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    transition: transform 0.35s var(--ease-out);
  }

  .b-logo:hover .b-logo-mark {
    transform: rotate(14deg);
  }

  .b-header nav {
    margin-left: auto;
  }

  .b-nav {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .b-nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--b-ink);
    border-bottom: 3px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.25s;
  }

  .b-nav a:hover,
  .b-nav a[aria-current] {
    border-color: var(--b-jaune);
  }

  .b-nav a[aria-current] {
    font-weight: 800;
  }

  /* ------------------------------ Boutons ------------------------------- */

  .b-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.25s;
  }

  .b-btn:hover {
    transform: translateY(-2px);
  }

  .b-btn-plein {
    background: var(--b-jaune);
    color: var(--b-ink-deep);
    box-shadow: 0 6px 16px rgb(242 183 5 / 0.4);
  }

  .b-btn-plein:hover {
    background: var(--b-jaune-deep);
  }

  .b-btn-ligne {
    border: 2px solid rgb(255 255 255 / 0.4);
    color: #fff;
  }

  .b-btn-ligne:hover {
    border-color: var(--b-jaune);
    color: var(--b-jaune);
  }

  .b-btn-sombre {
    background: var(--b-ink-deep);
    color: #fff;
  }

  .b-btn-ligne-sombre {
    border: 2px solid var(--b-ink-deep);
    color: var(--b-ink-deep);
  }

  /* -------------------------------- Hero -------------------------------- */

  .b-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--b-ink-deep), var(--b-ink) 70%, #2c303c);
    color: #fff;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .b-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .b-beam {
    position: absolute;
    height: 10rem;
    width: 150%;
    left: -25%;
    background: linear-gradient(90deg, transparent, rgb(242 183 5 / 0.08), transparent);
    transform: rotate(-12deg);
  }

  .b-beam-1 {
    top: 12%;
    animation: b-slide 12s ease-in-out infinite alternate;
  }

  .b-beam-2 {
    bottom: 8%;
    animation: b-slide 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes b-slide {
    from {
      transform: rotate(-12deg) translateX(-6%);
    }
    to {
      transform: rotate(-12deg) translateX(6%);
    }
  }

  .b-blueprint {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 30%, black 20%, transparent 75%);
  }

  .b-hero-inner {
    position: relative;
    max-width: 46rem;
  }

  .b-hero-kicker {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-jaune);
    animation: b-in 0.7s var(--ease-out) both;
  }

  .b-hero-title {
    margin-top: 1.2rem;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    animation: b-in 0.7s var(--ease-out) 0.12s both;
  }

  .b-hero-lede {
    margin-top: 1.4rem;
    font-size: 1.12rem;
    color: rgb(255 255 255 / 0.82);
    max-width: 36rem;
    animation: b-in 0.7s var(--ease-out) 0.24s both;
  }

  .b-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
    animation: b-in 0.7s var(--ease-out) 0.36s both;
  }

  .b-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    animation: b-in 0.7s var(--ease-out) 0.48s both;
  }

  .b-badges li {
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 4px;
    padding: 0.35rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  @keyframes b-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------ Chiffres ------------------------------ */

  .b-chiffres {
    background: var(--b-jaune);
    padding-block: 2.2rem;
  }

  .b-chiffres-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    text-align: center;
  }

  .b-chiffre-val {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--b-ink-deep);
  }

  .b-chiffre-val .b-unite {
    font-size: 1.3rem;
    margin-left: 0.15rem;
  }

  .b-chiffre-label {
    margin-top: 0.3rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: rgb(22 24 31 / 0.75);
  }

  /* ------------------------------ Sections ------------------------------ */

  .b-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .b-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-jaune-deep);
  }

  .b-title {
    margin-top: 0.7rem;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .b-texte {
    margin-top: 1rem;
    color: var(--b-muted);
    max-width: 34rem;
  }

  /* Services */

  .b-services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.3rem;
    margin-top: 2.5rem;
  }

  .b-service {
    position: relative;
    background: #fff;
    border: 1px solid rgb(34 37 46 / 0.08);
    border-radius: 10px;
    padding: 1.8rem 1.5rem;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .b-service::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--b-jaune);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .b-service:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgb(34 37 46 / 0.12);
  }

  .b-service:hover::before {
    transform: scaleX(1);
  }

  .b-service-icon {
    font-size: 2rem;
  }

  .b-service h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .b-service p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--b-muted);
  }

  /* Réalisations */

  .b-section-sombre {
    background: var(--b-ink-deep);
    color: #fff;
  }

  .b-section-sombre .b-title {
    color: #fff;
  }

  .b-realisations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .b-realisation {
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.35s;
  }

  .b-realisation:hover {
    transform: translateY(-6px);
    border-color: var(--b-jaune);
  }

  /* Photo du chantier */

  .b-realisation-visuel {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--b-ink);
  }

  .b-realisation-visuel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Léger rapprochement au survol, comme sur les cartes de l'accueil. */
    transition: transform 0.55s var(--ease-out);
  }

  .b-realisation:hover .b-realisation-visuel img {
    transform: scale(1.05);
  }

  .b-photo-tag {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    z-index: 2;
    background: var(--b-jaune);
    color: var(--b-ink-deep);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
  }

  .b-realisation-info {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  .b-realisation-info h3 {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .b-realisation-info p {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.65);
  }

  /* Zone d'intervention */

  .b-zone {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .b-villes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .b-villes li {
    background: #fff;
    border: 1px solid rgb(34 37 46 / 0.12);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .b-radar {
    position: relative;
    aspect-ratio: 1;
    max-width: 22rem;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }

  .b-radar-cercle {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgb(242 183 5 / 0.5);
    animation: b-radar 4s ease-out infinite;
  }

  .b-radar-cercle.c-1 {
    width: 30%;
    height: 30%;
  }

  .b-radar-cercle.c-2 {
    width: 62%;
    height: 62%;
    animation-delay: 1.3s;
  }

  .b-radar-cercle.c-3 {
    width: 94%;
    height: 94%;
    animation-delay: 2.6s;
  }

  @keyframes b-radar {
    0% {
      transform: scale(0.9);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    100% {
      transform: scale(1.05);
      opacity: 0;
    }
  }

  .b-radar-centre {
    font-size: 3rem;
    filter: drop-shadow(0 8px 10px rgb(34 37 46 / 0.25));
  }

  /* Devis */

  .b-devis {
    background: var(--b-jaune);
    padding-block: clamp(3.5rem, 8vw, 5.5rem);
  }

  .b-devis-inner {
    text-align: center;
    max-width: 40rem;
  }

  .b-devis h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--b-ink-deep);
  }

  .b-devis p {
    margin-top: 0.9rem;
    font-size: 1.08rem;
    color: rgb(22 24 31 / 0.8);
  }

  .b-devis-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .b-devis-note {
    font-size: 0.9rem !important;
    margin-top: 1.4rem !important;
  }

  /* Footer */

  .b-footer {
    background: var(--b-ink-deep);
    color: rgb(255 255 255 / 0.65);
    font-size: 0.9rem;
  }

  .b-footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.4rem;
  }

  .b-footer a {
    color: var(--b-jaune);
    font-weight: 600;
  }

  /* Responsive */

  @media (max-width: 760px) {
    /* La navigation et son bouton cèdent la place au menu dépliable. */
    .b-header nav,
    .b-btn {
      display: none;
    }

    .b-header-inner {
      justify-content: space-between;
    }

    .b-zone {
      grid-template-columns: 1fr;
    }
  }
</style>
