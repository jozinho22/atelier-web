---
import Base from '../../layouts/Base.astro';
import DemoBar from '../DemoBar.astro';
import MenuMobile from '../MenuMobile.astro';
import AuroraBackdrop from '../AuroraBackdrop.astro';
import { splitPath, localePath } from '../../lib/i18n';
import { common } from '../../i18n/common';
import { association } from '../../i18n/association';

const { lang } = splitPath(Astro.url.pathname);
const t = association[lang];
const c = common[lang];

const liensMenu = [
  { href: '#activites', label: t.header.nav.activites },
  { href: '#actus', label: t.header.nav.actus },
  { href: '#infos', label: t.header.nav.infos },
];
---

<Base title={t.meta.title} description={t.meta.description}>
  <DemoBar label={t.demoLabel} />
  <div class="assoc">
    <!-- ============================ EN-TÊTE ============================ -->
    <header class="a-header">
      <div class="wrap a-header-inner">
        <a class="a-logo" href="#top" aria-label={t.header.logoAria}>
          <span class="a-logo-badge" aria-hidden="true">🦗</span>
          {t.header.logoPrefix} <strong>{t.header.logoName}</strong>
        </a>
        <nav aria-label={t.header.navAria}>
          <ul class="a-nav">
            <li><a href="#activites">{t.header.nav.activites}</a></li>
            <li><a href="#actus">{t.header.nav.actus}</a></li>
            <li><a href="#infos">{t.header.nav.infos}</a></li>
          </ul>
        </nav>
        <a class="a-btn a-btn-sun" href="#adhesion">{t.header.join}</a>
        <MenuMobile variante="association" lang={lang} liens={liensMenu} />
      </div>
    </header>

    <main id="top">
      <!-- ============================= HERO ============================= -->
      <section class="a-hero">
        <div class="a-hero-shapes" aria-hidden="true">
          <AuroraBackdrop
            colors={['#2ba05f', '#ffd166', '#4fc3a1', '#7fd8f7']}
            background="#15653e"
            speed={1.1}
            grain={0.06}
          />
          <span class="a-ball a-ball-1"></span>
          <span class="a-ball a-ball-2"></span>
          <span class="a-stripe"></span>
        </div>
        <div class="wrap a-hero-inner">
          <p class="a-hero-kicker">{t.hero.kicker}</p>
          <h1 class="a-hero-title">
            {t.hero.titleIntro} <span class="a-marker">{t.hero.titleWord1}</span>,<br />
            {t.hero.titleJoin1} <span class="a-marker a-marker-2">{t.hero.titleWord2}</span>, {t.hero.titleJoin2} <span class="a-marker a-marker-3">{t.hero.titleWord3}</span>.
          </h1>
          <p class="a-hero-lede">
            {t.hero.lede}
          </p>
          <div class="a-hero-actions">
            <a class="a-btn a-btn-sun" href="#adhesion">{t.hero.ctaPrimary}</a>
            <a class="a-btn a-btn-line" href="#activites">{t.hero.ctaSecondary}</a>
          </div>
        </div>
        <svg class="a-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0,60 C240,100 480,10 720,40 C960,70 1200,20 1440,50 L1440,90 L0,90 Z" fill="#f4faf6" />
        </svg>
      </section>

      <!-- =========================== ACTIVITÉS =========================== -->
      <section id="activites" class="a-section">
        <div class="wrap">
          <h2 class="a-title reveal">{t.activities.title}</h2>
          <p class="a-lede reveal">{t.activities.lede}</p>
          <div class="a-grid">
            {t.activities.items.map((s, i) => (
              <article class="a-card reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <span class="a-card-icon" aria-hidden="true">{s.icon}</span>
                <h3>{s.name}</h3>
                <p>{s.detail}</p>
                <ul class="a-creneaux">
                  {s.creneaux.map((c) => (
                    <li>
                      <span class="a-creneau-jour">{c.jour}</span>
                      <span class="a-creneau-heure">{c.heure}</span>
                      <span class="a-creneau-lieu">{c.lieu}</span>
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================ ACTUS ============================= -->
      <section id="actus" class="a-section a-section-tinted">
        <div class="wrap">
          <h2 class="a-title reveal">{t.news.title}</h2>
          <div class="a-actus">
            {t.news.items.map((a, i) => (
              <article class="a-actu reveal" style={`--reveal-delay: ${i * 0.08}s`} data-actu>
                <p class="a-actu-meta">
                  <span class="a-actu-tag">{a.tag}</span>
                  <time>{a.date}</time>
                </p>
                <h3 id={`actu-titre-${i}`}>{a.titre}</h3>
                <p class="a-actu-texte">{a.texte}</p>

                <!-- La suite est dans le HTML dès le départ : sans JavaScript
                     l'article reste entièrement lisible, et c'est le script
                     qui le replie au chargement. -->
                <div class="a-actu-suite" id={`actu-suite-${i}`} data-actu-suite>
                  <div>
                    {a.suite.map((par) => <p>{par}</p>)}
                  </div>
                </div>

                <button
                  class="a-actu-lien"
                  type="button"
                  data-actu-bouton
                  data-plus={t.news.readMore}
                  data-moins={t.news.readLess}
                  aria-expanded="true"
                  aria-controls={`actu-suite-${i}`}
                >
                  <span data-actu-libelle>{t.news.readMore}</span>
                  <span class="a-actu-chevron" aria-hidden="true">↓</span>
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ========================== ADHÉSION CTA ========================= -->
      <section id="adhesion" class="a-cta">
        <div class="wrap a-cta-inner reveal">
          <h2>{t.join.title}</h2>
          <p>
            {t.join.textBefore}<strong>{t.join.textStrong}</strong>{t.join.textAfter}
          </p>
          <a class="a-btn a-btn-dark" href="tel:+33400000000">📞 {t.join.phone}</a>
        </div>
      </section>

      <!-- ======================== INFOS PRATIQUES ======================== -->
      <section id="infos" class="a-section">
        <div class="wrap a-infos">
          <div class="reveal">
            <h2 class="a-title">{t.infos.title}</h2>
            <ul class="a-infos-list">
              <li>
                <strong>📍 {t.infos.address.label}</strong>
                {t.infos.address.line1}<br />{t.infos.address.line2}
              </li>
              <li>
                <strong>🕐 {t.infos.hours.label}</strong>
                {t.infos.hours.line1}<br />{t.infos.hours.line2}
              </li>
              <li>
                <strong>✉️ {t.infos.contact.label}</strong>
                <a href={`mailto:${t.infos.contact.email}`}>{t.infos.contact.email}</a>
              </li>
            </ul>
          </div>
          <div class="a-map reveal" aria-hidden="true">
            <span class="a-map-pin">📍</span>
            <span class="a-map-road a-road-1"></span>
            <span class="a-map-road a-road-2"></span>
            <span class="a-map-road a-road-3"></span>
          </div>
        </div>
      </section>
    </main>

    <footer class="a-footer">
      <div class="wrap a-footer-inner">
        <p>{t.footer.copyright}</p>
        <p>{c.demo.madeBy} <a href={localePath(lang, '')}>Atelier Web</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Palette du modèle : vert terrain, jaune soleil, énergie. */
  .assoc {
    --a-green: #1a7a4c;
    --a-green-deep: #115c38;
    --a-sun: #ffd166;
    --a-sun-deep: #eab63e;
    --a-ink: #133326;
    --a-paper: #f4faf6;
    --a-muted: #5b7367;
    font-family: var(--font-sans);
    color: var(--a-ink);
    background: var(--a-paper);
  }

  .wrap {
    width: min(70rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  /* ------------------------------ En-tête ------------------------------- */

  .a-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(244 250 246 / 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(19 51 38 / 0.08);
  }

  .a-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.8rem;
  }

  .a-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.15rem;
    text-decoration: none;
    font-weight: 500;
  }

  .a-logo strong {
    font-weight: 800;
    color: var(--a-green);
  }

  .a-logo-badge {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--a-sun);
    font-size: 1.1rem;
    transition: transform 0.4s var(--ease-out);
  }

  .a-logo:hover .a-logo-badge {
    transform: rotate(-14deg) scale(1.08);
  }

  .a-header nav {
    margin-left: auto;
  }

  .a-nav {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .a-nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--a-ink);
    border-bottom: 3px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.25s;
  }

  .a-nav a:hover {
    border-color: var(--a-sun);
  }

  /* ------------------------------ Boutons ------------------------------- */

  .a-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.25s;
  }

  .a-btn:hover {
    transform: translateY(-2px) rotate(-1deg);
  }

  .a-btn-sun {
    background: var(--a-sun);
    color: var(--a-ink);
    box-shadow: 0 6px 18px rgb(255 209 102 / 0.45);
  }

  .a-btn-sun:hover {
    background: var(--a-sun-deep);
  }

  .a-btn-line {
    border: 2px solid rgb(255 255 255 / 0.6);
    color: #fff;
  }

  .a-btn-line:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.1);
  }

  .a-btn-dark {
    background: var(--a-ink);
    color: #fff;
  }

  /* -------------------------------- Hero -------------------------------- */

  .a-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--a-green-deep), var(--a-green) 55%, #2ba05f);
    color: #fff;
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(5rem, 10vw, 8rem);
  }

  .a-hero-shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .a-ball {
    position: absolute;
    border-radius: 50%;
    border: 3px dashed rgb(255 255 255 / 0.25);
  }

  .a-ball-1 {
    width: 16rem;
    height: 16rem;
    top: -5rem;
    right: 8%;
    animation: a-spin 40s linear infinite;
  }

  .a-ball-2 {
    width: 9rem;
    height: 9rem;
    bottom: 18%;
    left: 4%;
    border-color: rgb(255 209 102 / 0.5);
    animation: a-spin 28s linear infinite reverse;
  }

  @keyframes a-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .a-stripe {
    position: absolute;
    width: 130%;
    height: 5rem;
    left: -15%;
    bottom: 28%;
    background: rgb(255 255 255 / 0.05);
    transform: rotate(-6deg);
  }

  .a-hero-inner {
    position: relative;
    max-width: 44rem;
  }

  .a-hero-kicker {
    display: inline-block;
    background: rgb(255 255 255 / 0.14);
    border-radius: 999px;
    padding: 0.4rem 1.1rem;
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    animation: a-pop 0.7s var(--ease-out) both;
  }

  .a-hero-title {
    margin-top: 1.4rem;
    font-size: clamp(2.3rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    animation: a-pop 0.7s var(--ease-out) 0.12s both;
  }

  .a-marker {
    position: relative;
    display: inline-block;
    padding: 0 0.15em;
  }

  .a-marker::before {
    content: '';
    position: absolute;
    inset: 0.55em -0.05em 0.02em;
    background: var(--a-sun);
    z-index: -1;
    transform: rotate(-1.5deg) scaleX(0);
    transform-origin: left;
    animation: a-highlight 0.5s var(--ease-out) 0.7s forwards;
  }

  .a-marker-2::before {
    background: #ff8a5c;
    animation-delay: 0.9s;
  }

  .a-marker-3::before {
    background: #7fd8f7;
    animation-delay: 1.1s;
  }

  @keyframes a-highlight {
    to {
      transform: rotate(-1.5deg) scaleX(1);
    }
  }

  @keyframes a-pop {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .a-hero-lede {
    margin-top: 1.3rem;
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.88);
    animation: a-pop 0.7s var(--ease-out) 0.24s both;
  }

  .a-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    animation: a-pop 0.7s var(--ease-out) 0.36s both;
  }

  .a-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: clamp(2.5rem, 6vw, 5rem);
  }

  /* ------------------------------ Sections ------------------------------ */

  .a-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .a-section-tinted {
    background: #e8f4ec;
  }

  .a-title {
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .a-lede {
    margin-top: 0.7rem;
    color: var(--a-muted);
    max-width: 36rem;
  }

  /* Cartes activités */

  .a-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.3rem;
    margin-top: 2.5rem;
  }

  .a-card {
    background: #fff;
    border-radius: 20px;
    padding: 1.7rem 1.5rem;
    border: 1px solid rgb(19 51 38 / 0.07);
    box-shadow: 0 2px 10px rgb(19 51 38 / 0.05);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .a-card:hover {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 0 14px 30px rgb(19 51 38 / 0.12);
  }

  .a-card-icon {
    font-size: 2.2rem;
    display: inline-block;
    transition: transform 0.35s var(--ease-out);
  }

  .a-card:hover .a-card-icon {
    transform: scale(1.2) rotate(8deg);
  }

  .a-card h3 {
    margin-top: 0.8rem;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .a-card p {
    margin-top: 0.3rem;
    color: var(--a-muted);
    font-size: 0.95rem;
  }

  /* Créneaux : jour, horaire et lieu, alignés en colonnes lisibles. */
  .a-creneaux {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid rgb(19 51 38 / 0.12);
    display: grid;
    gap: 0.6rem;
  }

  .a-creneaux li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.6rem;
    font-size: 0.85rem;
  }

  .a-creneau-jour {
    font-weight: 700;
  }

  .a-creneau-heure {
    justify-self: end;
    font-variant-numeric: tabular-nums;
    background: var(--a-sun);
    color: var(--a-ink);
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .a-creneau-lieu {
    grid-column: 1 / -1;
    font-size: 0.78rem;
    color: var(--a-muted);
  }


  /* Actualités */

  .a-actus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.4rem;
    margin-top: 2.5rem;
  }

  .a-actu {
    background: #fff;
    border-radius: 20px;
    padding: 1.7rem 1.5rem;
    border: 1px solid rgb(19 51 38 / 0.07);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .a-actu:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgb(19 51 38 / 0.12);
  }

  .a-actu-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.85rem;
    color: var(--a-muted);
  }

  .a-actu-tag {
    background: #dcefe2;
    color: var(--a-green-deep);
    font-weight: 700;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .a-actu h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .a-actu-texte {
    margin-top: 0.6rem;
    color: var(--a-muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .a-actu-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--a-green);
    cursor: pointer;
    align-self: flex-start;
  }

  .a-actu-lien:hover {
    text-decoration: underline;
  }

  .a-actu-chevron {
    transition: transform 0.4s var(--ease-out);
  }

  [data-actu-bouton][aria-expanded='true'] .a-actu-chevron {
    transform: rotate(180deg);
  }

  /* Repli animé. La hauteur est pilotée en JavaScript plutôt que par
     l'astuce `grid-template-rows: 0fr` : dans cette carte (boîte flex en
     colonne), la ligne refusait de descendre sous la hauteur du contenu.
     Mesurer puis animer une hauteur explicite est plus verbeux, mais donne
     un résultat vérifiable partout. */
  .a-actu-suite {
    overflow: hidden;
    transition: height 0.5s var(--ease-out);
  }

  .a-actu-suite p {
    margin-top: 0.9rem;
    font-size: 0.93rem;
    line-height: 1.65;
    color: var(--a-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .a-actu-suite {
      transition: none;
    }
  }

  /* CTA adhésion */

  .a-cta {
    background: var(--a-sun);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .a-cta-inner {
    text-align: center;
    max-width: 38rem;
  }

  .a-cta h2 {
    font-size: clamp(1.8rem, 4.5vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .a-cta p {
    margin-top: 0.9rem;
    font-size: 1.1rem;
  }

  .a-cta .a-btn {
    margin-top: 1.6rem;
    font-size: 1.05rem;
  }

  /* Infos pratiques */

  .a-infos {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .a-infos-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .a-infos-list strong {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 1.05rem;
  }

  .a-infos-list a {
    color: var(--a-green);
    font-weight: 600;
  }

  /* Fausse carte stylisée */

  .a-map {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    background:
      linear-gradient(rgb(19 51 38 / 0.04) 1px, transparent 1px) 0 0 / 100% 22px,
      linear-gradient(90deg, rgb(19 51 38 / 0.04) 1px, transparent 1px) 0 0 / 22px 100%,
      #dcefe2;
    overflow: hidden;
    border: 1px solid rgb(19 51 38 / 0.08);
  }

  .a-map-road {
    position: absolute;
    background: #fff;
    border-radius: 4px;
  }

  .a-road-1 {
    width: 140%;
    height: 14px;
    top: 40%;
    left: -20%;
    transform: rotate(-8deg);
  }

  .a-road-2 {
    width: 10px;
    height: 140%;
    left: 58%;
    top: -20%;
    transform: rotate(12deg);
  }

  .a-road-3 {
    width: 120%;
    height: 8px;
    top: 72%;
    left: -10%;
    transform: rotate(4deg);
  }

  .a-map-pin {
    position: absolute;
    top: 34%;
    left: 52%;
    font-size: 2.4rem;
    filter: drop-shadow(0 6px 8px rgb(19 51 38 / 0.3));
    animation: a-bounce 2.2s ease-in-out infinite;
  }

  @keyframes a-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* ------------------------------- Footer ------------------------------- */

  .a-footer {
    background: var(--a-ink);
    color: #cfe3d7;
    font-size: 0.9rem;
  }

  .a-footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.4rem;
  }

  .a-footer a {
    color: var(--a-sun);
    font-weight: 600;
  }

  /* ----------------------------- Responsive ----------------------------- */

  @media (max-width: 760px) {
    /* La navigation horizontale cède la place au menu dépliable. */
    .a-header nav {
      display: none;
    }

    .a-header-inner {
      justify-content: space-between;
    }

    .a-infos {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Articles dépliables. Le corps complet est présent dans le HTML dès le
  // départ : sans JavaScript l'article reste lisible en entier et le bouton,
  // inutile, n'apparaît pas. C'est le script qui replie et révèle le bouton.
  document.querySelectorAll<HTMLElement>('[data-actu]').forEach((actu) => {
    const suite = actu.querySelector<HTMLElement>('[data-actu-suite]');
    const bouton = actu.querySelector<HTMLButtonElement>('[data-actu-bouton]');
    const libelle = actu.querySelector<HTMLElement>('[data-actu-libelle]');
    if (!suite || !bouton || !libelle) return;

    const plus = bouton.dataset.plus ?? '';
    const moins = bouton.dataset.moins ?? '';

    let liberation = 0;

    /** Rend la hauteur libre pour que le contenu puisse se reflower ensuite. */
    const liberer = (): void => {
      window.clearTimeout(liberation);
      if (bouton.getAttribute('aria-expanded') === 'true') suite.style.height = 'auto';
    };

    const ouvrir = (): void => {
      suite.style.height = `${suite.scrollHeight}px`;
      suite.addEventListener('transitionend', liberer, { once: true });
      // Filet : en mouvement réduit la transition est désactivée, donc
      // `transitionend` ne se déclenche jamais et la hauteur resterait figée
      // en pixels — insensible à un redimensionnement.
      liberation = window.setTimeout(liberer, 700);
    };

    const fermer = (immediat = false): void => {
      window.clearTimeout(liberation);
      if (immediat) {
        suite.style.height = '0px';
        return;
      }
      // On fige la hauteur courante, on force un recalcul, puis on part à 0 :
      // sans cette étape, le navigateur n'a pas de valeur de départ à animer.
      suite.style.height = `${suite.scrollHeight}px`;
      void suite.offsetHeight;
      suite.style.height = '0px';
    };

    const appliquer = (ouvert: boolean, immediat = false): void => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      libelle.textContent = ouvert ? moins : plus;
      if (ouvert) ouvrir();
      else fermer(immediat);
    };

    appliquer(false, true);   // état initial : replié, sans animation
    bouton.hidden = false;

    bouton.addEventListener('click', () => {
      appliquer(bouton.getAttribute('aria-expanded') !== 'true');
    });
  });
</script>
