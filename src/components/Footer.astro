---
// Pied de page du site principal.
import { splitPath, localePath } from '../lib/i18n';
import { common } from '../i18n/common';

const { lang } = splitPath(Astro.url.pathname);
const t = common[lang].footer;
const year = new Date().getFullYear();

/**
 * La pastille ne dit pas quel modèle c'est, mais de quelle OFFRE il relève :
 * trois couleurs pour trois packs, et non dix pour dix modèles. Le pied de page
 * répète ainsi le code couleur des cartes tarifaires.
 *
 * Variante « sur encre » : les teintes de base sont taillées pour du texte sur
 * fond clair et ne tiennent pas le seuil de 3:1 sur le fond sombre d'ici.
 */
const PASTILLE = {
  essentiel: 'var(--pack-essentiel-sur-encre)',
  surmesure: 'var(--pack-surmesure-sur-encre)',
  signature: 'var(--pack-signature-sur-encre)',
} as const;

/**
 * Les huit vitrines, dans l'ordre de la page d'accueil, du plus récent au plus
 * ancien — le pied de page les listait à l'envers. Toutes illustrent le pack
 * Essentiel, elles portent donc la même pastille.
 */
const vitrines = [
  { chemin: 'boulangerie', label: t.models.boulangerie },
  { chemin: 'salon-de-the', label: t.models.salonDeThe },
  { chemin: 'restaurant', label: t.models.restaurant },
  { chemin: 'yoga', label: t.models.yoga },
  { chemin: 'artiste', label: t.models.artiste },
  { chemin: 'esthetique', label: t.models.esthetique },
  { chemin: 'batiment', label: t.models.batiment },
  { chemin: 'association', label: t.models.association },
];

const depot = (nom: string) => `https://jozinho22.github.io/${nom}/`;

const surMesure = [
  { url: depot('modele-hotel-de-luxe'), label: t.packs.hotel },
];

const signature = [
  { url: depot('modele-golf'), label: t.packs.golf },
  { url: depot('modele-centre-equestre'), label: t.packs.equestre },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">Atelier<strong>Web</strong></p>
      <p class="footer-tagline">{t.tagline}</p>
    </div>
    <nav class="footer-nav" aria-label={lang === 'fr' ? 'Pied de page' : 'Footer'}>
      <p class="footer-heading">{t.modelsHeading}</p>
      <ul>
        {vitrines.map((v) => (
          <li>
            <a href={localePath(lang, `modeles/${v.chemin}`)} style={`--pastille: ${PASTILLE.essentiel}`}>
              <span class="footer-pastille" aria-hidden="true"></span>{v.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Les deux packs supérieurs ne sont pas des pages d'ici : ce sont des
         sites complets, chacun sur son domaine. D'où l'ouverture dans un
         nouvel onglet, comme dans la section Modèles. -->
    <div class="footer-nav">
      <p class="footer-heading">{t.surMesureHeading}</p>
      <ul>
        {surMesure.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener noreferrer" style={`--pastille: ${PASTILLE.surmesure}`}>
              <span class="footer-pastille" aria-hidden="true"></span>{m.label}
              <span class="footer-ext" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="footer-heading footer-heading-2">{t.signatureHeading}</p>
      <ul>
        {signature.map((m) => (
          <li>
            <a href={m.url} target="_blank" rel="noopener noreferrer" style={`--pastille: ${PASTILLE.signature}`}>
              <span class="footer-pastille" aria-hidden="true"></span>{m.label}
              <span class="footer-ext" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="footer-contact">
      <p class="footer-heading">{t.contactHeading}</p>
      <ul>
        <li><a href="mailto:contact@atelier-web.example">contact@atelier-web.example</a></li>
        <li><a href="tel:+33600000000">06 00 00 00 00</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-legal">
    <p>© {year} Atelier Web — {t.rights}</p>
    <nav class="footer-legal-liens" aria-label={t.legal}>
      <a href={localePath(lang, 'mentions-legales')}>{t.legal}</a>
      <a href={localePath(lang, 'cgv')}>{t.cgv}</a>
      <a href={localePath(lang, 'qui-sommes-nous')}>{t.equipe}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #c9cadd;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 0.9fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-logo {
    font-size: 1.35rem;
    color: #fff;
  }

  .footer-logo strong {
    font-weight: 800;
    color: #8d8cf0;
  }

  .footer-tagline {
    margin-top: 0.6rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }

  /* Le second titre ouvre un nouveau groupe : son écart doit être nettement
     plus grand que les 14 px qui séparent un titre de sa propre liste, sinon
     les deux packs se lisent comme une seule colonne. */
  .footer-heading-2 {
    margin-top: 2.6rem;
  }

  .footer-ext {
    opacity: 0.55;
    font-size: 0.82em;
  }

  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f90ab;
    margin-bottom: 0.9rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: #fff;
  }

  /* Pastille du code couleur des trois offres. Purement indicative — le nom du
     modèle reste lisible sans elle —, d'où l'aria-hidden, et le titre de
     colonne nomme déjà le pack. Les trois variantes « sur encre » tiennent
     4,5:1 sur ce fond, bien au-dessus du seuil de 3:1. */
  .footer-pastille {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.55rem;
    border-radius: 50%;
    background: var(--pastille);
    /* `flex-shrink` inopérant ici (contexte en ligne) : la largeur fixe et
       `vertical-align` suffisent à la caler sur la ligne de base du texte. */
    vertical-align: 0.05em;
    transition: transform 0.2s var(--ease-out);
  }

  .site-footer a:hover .footer-pastille {
    transform: scale(1.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-pastille {
      transition: none;
    }

    .site-footer a:hover .footer-pastille {
      transform: none;
    }
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.85rem;
    color: #8f90ab;
  }

  /* Les trois liens de bas de page restent groupés à droite, séparés par des
     points médians — la barre garde ainsi ses deux blocs, copyright à gauche
     et liens à droite, au lieu de quatre éléments alignés au hasard. */
  .footer-legal-liens {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.9rem;
  }

  .footer-legal-liens a + a {
    position: relative;
  }

  .footer-legal-liens a + a::before {
    content: '·';
    position: absolute;
    left: -0.55rem;
    color: #8f90ab;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-legal {
      flex-direction: column;
      text-align: center;
    }
  }

  /* Les trois intitulés bout à bout mesurent 460 px : à 500 px de fenêtre ils
     occupaient déjà la largeur disponible au pixel près. Plutôt que de les
     laisser se rompre n'importe où — le point médian se retrouverait en tête de
     seconde ligne —, on les empile sous 620 px et on retire le séparateur, qui
     n'a plus rien à séparer. */
  @media (max-width: 620px) {
    .footer-legal-liens {
      flex-direction: column;
      gap: 0.5rem;
    }

    .footer-legal-liens a + a::before {
      display: none;
    }
  }
</style>
