---
// Pied de page du site principal.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">Atelier<strong>Web</strong></p>
      <p class="footer-tagline">
        Sites vitrines soignés pour artisans, indépendants et associations.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Pied de page">
      <p class="footer-heading">Modèles</p>
      <ul>
        <li><a href="/modeles/association">Association sportive &amp; culturelle</a></li>
        <li><a href="/modeles/batiment">Métiers du bâtiment</a></li>
        <li><a href="/modeles/esthetique">Beauté &amp; bien-être</a></li>
        <li><a href="/modeles/artiste">Blog d'artiste</a></li>
      </ul>
    </nav>
    <div class="footer-contact">
      <p class="footer-heading">Contact</p>
      <ul>
        <li><a href="mailto:contact@atelier-web.example">contact@atelier-web.example</a></li>
        <li><a href="tel:+33600000000">06 00 00 00 00</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-legal">
    <p>© {year} Atelier Web — Tous droits réservés.</p>
    <a href="/mentions-legales">Mentions légales</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #c9cadd;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-logo {
    font-size: 1.35rem;
    color: #fff;
  }

  .footer-logo strong {
    font-weight: 800;
    color: #8d8cf0;
  }

  .footer-tagline {
    margin-top: 0.6rem;
    max-width: 22rem;
    font-size: 0.95rem;
  }

  .footer-heading {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f90ab;
    margin-bottom: 0.9rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer a {
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: #fff;
  }

  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.875rem;
    color: #8f90ab;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-legal {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
