---
// Bascule FR/EN : pointe vers la même page dans l'autre langue.
// S'adapte à la couleur du texte environnant (currentColor).
import { splitPath, localePath } from '../lib/i18n';

const { lang, rest } = splitPath(Astro.url.pathname);

/**
 * Les drapeaux sont dessinés en SVG plutôt qu'en émojis 🇫🇷/🇬🇧 : sous Windows,
 * aucune police système ne rend les émojis de drapeau — le navigateur affiche
 * alors les deux lettres du code pays, ce qui casse l'alignement et le sens.
 *
 * Le code langue reste affiché à côté du drapeau. Un drapeau seul désigne un
 * pays, pas une langue : « EN » ne se réduit ni au Royaume-Uni ni aux
 * États-Unis, et un lecteur d'écran n'en tirerait rien.
 */
const DRAPEAUX = {
  fr: {
    titre: 'Français',
    bandes: [
      ['#002654', 0],
      ['#ffffff', 8],
      ['#ce1126', 16],
    ],
  },
  en: { titre: 'English' },
} as const;
---

<nav class="lang-switch" aria-label="Langue / Language">
  <a
    href={localePath('fr', rest)}
    class:list={['lang-link', { 'is-active': lang === 'fr' }]}
    aria-current={lang === 'fr' ? 'true' : undefined}
    lang="fr"
    hreflang="fr"
  >
    <svg class="drapeau" viewBox="0 0 24 16" role="img" aria-hidden="true">
      <rect width="24" height="16" rx="2" fill="#ffffff" />
      {DRAPEAUX.fr.bandes.map(([couleur, x]) => (
        <rect x={x} width="8" height="16" fill={couleur} />
      ))}
      <rect width="24" height="16" rx="2" class="drapeau-cadre" />
    </svg>
    <span class="lang-code">FR</span>
  </a>
  <span class="lang-sep" aria-hidden="true"></span>
  <a
    href={localePath('en', rest)}
    class:list={['lang-link', { 'is-active': lang === 'en' }]}
    aria-current={lang === 'en' ? 'true' : undefined}
    lang="en"
    hreflang="en"
  >
    <svg class="drapeau" viewBox="0 0 24 16" role="img" aria-hidden="true">
      <rect width="24" height="16" rx="2" fill="#012169" />
      <path d="M0 0 24 16M24 0 0 16" stroke="#ffffff" stroke-width="3.2" />
      <path d="M0 0 24 16M24 0 0 16" stroke="#c8102e" stroke-width="1.9" />
      <path d="M12 0v16M0 8h24" stroke="#ffffff" stroke-width="5.4" />
      <path d="M12 0v16M0 8h24" stroke="#c8102e" stroke-width="3.2" />
      <rect width="24" height="16" rx="2" class="drapeau-cadre" />
    </svg>
    <span class="lang-code">EN</span>
  </a>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .lang-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    color: currentColor;
    /* La langue inactive s'efface, sans descendre sous le seuil de lisibilité :
       0.45 rendait « EN » illisible sur le papier crème. */
    opacity: 0.62;
    padding: 0.2rem 0.35rem;
    border-radius: 6px;
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease-out);
  }

  .lang-link:hover {
    opacity: 1;
    transform: translateY(-1px);
  }

  /* La sélection se lit au drapeau qui retrouve ses couleurs et au texte à
     pleine opacité — le soulignement en plus alourdissait la barre. */
  .lang-link.is-active {
    opacity: 1;
  }

  .drapeau {
    display: block;
    width: 1.25rem;
    height: auto;
    /* Sans cela, la bascule étant le seul élément compressible de l'en-tête et
       du bandeau de démo, c'est le drapeau qui encaissait le manque de place :
       il tombait à 10 px sur un écran de 320. */
    flex: none;
    aspect-ratio: 3 / 2;
    border-radius: 2px;
    /* Le drapeau de la langue inactive perd ses couleurs : la sélection se lit
       d'un coup d'œil, sans dépendre du seul soulignement. */
    filter: saturate(0.25);
    transition:
      filter 0.25s,
      transform 0.25s var(--ease-out);
  }

  .lang-link.is-active .drapeau,
  .lang-link:hover .drapeau {
    filter: saturate(1);
  }

  /* Un liseré tiré de la couleur du texte : le drapeau blanc du côté français
     et le fond clair de l'en-tête se confondraient sans lui. */
  .drapeau-cadre {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.28;
  }

  .lang-sep {
    width: 1px;
    height: 0.85rem;
    background: currentColor;
    opacity: 0.22;
  }

  
  /**
   * Sous 760 px — là où la navigation cède la place au bouton de menu —, seul
   * le drapeau reste visible : la ligne d'en-tête y est disputée entre le logo,
   * la bascule et le burger, et les deux codes langue y coûtent une quarantaine
   * de pixels pour une information que le drapeau porte déjà.
   *
   * Le texte est masqué VISUELLEMENT, pas retiré. Un drapeau seul désigne un
   * pays et non une langue : en `display: none`, le lien n'aurait plus aucun
   * nom accessible et un lecteur d'écran annoncerait deux liens vides.
   *
   * La cible tactile est reprise en même temps : sans son texte, le lien
   * tomberait à une vingtaine de pixels de large.
   *
   * Ce bloc remplace une règle inverse, qui masquait le DRAPEAU sous 420 px et
   * gardait le code. Les deux ne pouvaient pas coexister : sous 420 px elles se
   * cumulaient et la bascule devenait vide. Le drapeau l'emporte désormais sur
   * toute la plage mobile.
   */
  @media (max-width: 760px) {
    .lang-code {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .lang-link {
      gap: 0;
      padding: 0.55rem 0.5rem;
    }

    .drapeau {
      width: 1.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-link,
    .drapeau {
      transition: none;
    }

    .lang-link:hover {
      transform: none;
    }
  }
</style>
