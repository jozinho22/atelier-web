---
// En-tête du site principal.
import { splitPath, localePath } from '../lib/i18n';
import { withBase } from '../lib/paths';
import { common } from '../i18n/common';
import LanguageSwitch from './LanguageSwitch.astro';
import MenuMobile from './MenuMobile.astro';

const { lang } = splitPath(Astro.url.pathname);
const t = common[lang];
const home = localePath(lang, '');

const links = [
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#deroule`, label: t.nav.methode },
  { href: `${home}#modeles`, label: t.nav.modeles },
  { href: `${home}#tarifs`, label: t.nav.tarifs },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label="Atelier Web">
      <img
        class="brand-mark"
        src={withBase('logo.webp')}
        alt=""
        width="96"
        height="96"
        decoding="async"
      />
      Atelier<strong>Web</strong>
    </a>
    <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul class="nav-list">
        {links.map((link) => (
          <li><a class="nav-link" href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <LanguageSwitch />
    <MenuMobile
      variante="principal"
      lang={lang}
      liens={links}
      cta={{ href: `${home}#contact`, label: t.nav.cta }}
    />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 246 242 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(18 19 31 / 0.07);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand strong {
    font-weight: 800;
    color: var(--accent);
  }

  /* Le logo réel du site, celui des icônes — pas une redite dessinée à la
     main. 96 px de source pour un affichage à 26 : net jusqu'à 3,5× de
     densité, pour 3,6 Ko. */
  .brand-mark {
    width: 1.65rem;
    height: 1.65rem;
    flex: none;
    transition: transform 0.4s var(--ease-out);
  }

  .brand:hover .brand-mark {
    transform: translateY(-2px);
  }

  nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink-soft);
    transition: color 0.2s;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--ink);
  }

  /* Section courante : le trait du survol, mais figé et en graisse pleine —
     c'est ce qui le distingue d'un simple survol de passage. */
  .nav-link[aria-current] {
    font-weight: 700;
  }

  .nav-link[aria-current]::after {
    transform: scaleX(1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }


  @media (max-width: 760px) {
    /* La navigation horizontale cède la place au menu dépliable. */
    nav {
      display: none;
    }

    .header-inner {
      justify-content: space-between;
    }
  }
</style>
