---
import '@fontsource-variable/outfit';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { withBase } from '../lib/paths';
import { splitPath, localePath } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** JSON-LD supplémentaire à injecter dans le <head> (schema.org). */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
const { lang, rest } = splitPath(Astro.url.pathname);
// Slash final systématique : c'est l'URL réellement servie (pages en
// dossiers) et celle listée dans le sitemap.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
// Versions linguistiques de la page courante (hreflang).
const frUrl = new URL(localePath('fr', rest).replace(/\/?$/, '/'), Astro.site);
const enUrl = new URL(localePath('en', rest).replace(/\/?$/, '/'), Astro.site);
// Vignette de partage. Absolue et non relative : les réseaux sociaux ne
// résolvent pas les chemins, ils exigent une URL complète.
const ogImage = new URL(
  withBase(lang === 'fr' ? 'og-image.jpg' : 'og-image-en.jpg'),
  Astro.site
).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={frUrl} />
    <!-- Le .ico embarque les tailles 16, 32 et 48 ; les PNG servent aux
         navigateurs qui les préfèrent. Plus de SVG : celui d'origine portait
         l'ancien monogramme et primait sur les nouvelles icônes. -->
    <link rel="icon" href={withBase('favicon-32x32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={withBase('favicon-16x16.png')} sizes="16x16" type="image/png" />
    <link rel="alternate icon" href={withBase('favicon.ico')} sizes="16x16 32x32 48x48" />
    <!-- iOS ignore et le SVG et le manifeste : sans cette ligne, un raccourci
         sur l'écran d'accueil affiche une capture de la page. -->
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} sizes="180x180" />
    <!-- Le libellé sous l'icône, à défaut duquel iOS reprend le <title> — soit
         72 caractères tronqués en « Atelier Web … ». C'est l'équivalent du
         `short_name` du manifeste, qu'Android utilise déjà. -->
    <meta name="apple-mobile-web-app-title" content="Atelier Web" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- `summary_large_image` et non `summary` : avec une vignette 1200×630,
         `summary` la rognerait en une petite carrée. -->
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#12131f" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />

    <script>
      /**
       * Décalage des ancres sous l'en-tête figé.
       *
       * Sans lui, un lien vers `#tarifs` amène la section pile en haut de la
       * fenêtre — donc sous l'en-tête collant, qui masque le titre. Le visiteur
       * atterrit au milieu du contenu sans savoir où il est.
       *
       * La valeur n'est pas la hauteur de l'en-tête mais celle de toute la pile
       * figée : sur les six modèles, la barre de démonstration reste elle aussi
       * à l'écran, et l'en-tête se cale 2,35 rem plus bas. `top` calculé donne
       * ce décalage, on lui ajoute la hauteur.
       */
      const enteteFixe = document.querySelector('header');
      if (enteteFixe) {
        const calerLesAncres = () => {
          const decalage = parseFloat(getComputedStyle(enteteFixe).top) || 0;
          document.documentElement.style.setProperty(
            '--entete-fixe',
            `${Math.round(decalage + enteteFixe.offsetHeight)}px`
          );
        };
        calerLesAncres();
        window.addEventListener('resize', calerLesAncres);
        if ('ResizeObserver' in window) new ResizeObserver(calerLesAncres).observe(enteteFixe);
      }

      /**
       * Boucles décoratives : en mouvement réduit, on rend la main à
       * l'utilisateur. La vidéo s'arrête sur son affiche et reçoit ses
       * commandes, plutôt que de tourner indéfiniment.
       */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('[data-boucle]').forEach((v) => {
          v.autoplay = false;
          v.loop = false;
          v.controls = true;
          v.removeAttribute('aria-hidden');
          v.pause();
        });
      }

      /**
       * Repère de position dans la navigation.
       *
       * Les sept sites tiennent sur une seule page : le visiteur navigue par
       * ancres, sans que l'en-tête ne lui dise jamais où il en est. On marque
       * donc le lien de la section réellement à l'écran.
       *
       * La ligne de lecture est le bas de la pile figée (`--entete-fixe`) : la
       * section courante est la dernière dont le haut soit passé au-dessus.
       * En bas de page, le dernier lien l'emporte — les dernières sections
       * sont souvent trop courtes pour atteindre la ligne.
       */
      const liensAncres = [
        ...document.querySelectorAll<HTMLAnchorElement>(
          'header nav a[href*="#"], [data-menu-panneau] a[href*="#"]'
        ),
      ].filter((a) => (a.getAttribute('href') ?? '').includes('#'));

      if (liensAncres.length > 0) {
        const ancres = liensAncres
          .map((a) => {
            const id = (a.getAttribute('href') ?? '').split('#')[1];
            return { lien: a, cible: id ? document.getElementById(id) : null };
          })
          .filter((x): x is { lien: HTMLAnchorElement; cible: HTMLElement } => x.cible !== null);

        if (ancres.length > 0) {
          const situer = () => {
            const ligne =
              parseFloat(
                getComputedStyle(document.documentElement).getPropertyValue('--entete-fixe')
              ) || 80;
            const fin =
              window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;

            let courante: HTMLElement | null = null;
            for (const { cible } of ancres) {
              if (cible.getBoundingClientRect().top <= ligne + 8) courante = cible;
            }
            if (fin) courante = ancres[ancres.length - 1].cible;

            for (const { lien, cible } of ancres) {
              if (cible === courante) lien.setAttribute('aria-current', 'location');
              else lien.removeAttribute('aria-current');
            }
          };

          situer();
          // Une poignée de `getBoundingClientRect` par événement : inutile
          // d'étrangler le calcul, et une indirection de moins à déboguer.
          window.addEventListener('scroll', situer, { passive: true });
          window.addEventListener('resize', situer);
        }
      }

      // Apparition des éléments .reveal au défilement.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('.reveal');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        /**
         * L'apparition joue dans les deux sens et sans fin : l'élément se
         * montre en entrant dans la fenêtre, se retire en la quittant, et
         * recommence. On ne se désabonne donc plus après le premier passage —
         * c'est ce `unobserve` qui figeait l'animation une fois pour toutes.
         */
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('is-visible', entry.isIntersecting);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }

      // Compteurs animés : tout élément [data-countup] s'incrémente de 0
      // jusqu'à sa valeur quand il apparaît à l'écran. La valeur finale est
      // déjà dans le HTML (SEO, absence de JavaScript, mouvement réduit).
      const counters = document.querySelectorAll<HTMLElement>('[data-countup]');

      if (counters.length > 0 && !prefersReduced && 'IntersectionObserver' in window) {
        const animateCount = (el: HTMLElement): void => {
          const target = parseFloat(el.dataset.countup ?? '0');
          const duration = 1600;
          const start = performance.now();
          const tick = (now: number): void => {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = String(Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const countObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animateCount(entry.target as HTMLElement);
                countObserver.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => countObserver.observe(el));
      }
    </script>
  </body>
</html>
