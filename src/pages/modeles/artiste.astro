---
import Base from '../../layouts/Base.astro';
import DemoBar from '../../components/DemoBar.astro';

const title = "Modèle blog d'artiste — Claire Aubry, peintre | Atelier Web";
const description =
  "Exemple de site blog-portfolio pour artiste : galerie d'œuvres, journal de création, expositions et contact. Un modèle Atelier Web mettant l'art en pleine lumière.";

const oeuvres = [
  { titre: 'Marée nº7', annee: '2026', technique: 'Huile sur toile — 90 × 120 cm', art: 'art-1' },
  { titre: 'La chambre jaune', annee: '2025', technique: 'Acrylique — 60 × 80 cm', art: 'art-2' },
  { titre: 'Verticales', annee: '2025', technique: 'Encre et pigments — 50 × 70 cm', art: 'art-3' },
  { titre: 'Ce qui reste', annee: '2024', technique: 'Technique mixte — 100 × 100 cm', art: 'art-4' },
];

const billets = [
  {
    date: '18 juillet 2026',
    titre: 'Ce que la mer efface',
    extrait: 'Trois semaines face à l’Atlantique pour préparer la série des Marées. Carnet de bord d’une résidence entre brume et lumière crue…',
    duree: '4 min',
  },
  {
    date: '2 juin 2026',
    titre: 'Pourquoi je peins en série',
    extrait: 'Une toile seule ment souvent. C’est la répétition qui révèle — retour sur une obsession de peintre et sur ce qu’elle m’apprend…',
    duree: '6 min',
  },
  {
    date: '14 avril 2026',
    titre: 'Dans l’atelier, à 6 h du matin',
    extrait: 'La lumière du petit matin change tout : les pigments, le silence, la patience. Visite guidée de mon rituel de travail…',
    duree: '3 min',
  },
];

const expos = [
  { dates: '12 sept. — 24 oct. 2026', lieu: 'Galerie du Passage, Nantes', nom: '« Marées », exposition personnelle' },
  { dates: '5 — 8 nov. 2026', lieu: 'Grand Palais éphémère, Paris', nom: 'Salon Art Contempo, stand C12' },
];
---

<Base title={title} description={description}>
  <DemoBar label="Blog & portfolio d'artiste" />
  <div class="art">
    <!-- ============================ EN-TÊTE ============================ -->
    <header class="r-header">
      <div class="wrap r-header-inner">
        <a class="r-logo" href="#top">Claire <em>Aubry</em></a>
        <nav aria-label="Navigation du site">
          <ul class="r-nav">
            <li><a href="#oeuvres">Œuvres</a></li>
            <li><a href="#journal">Journal</a></li>
            <li><a href="#expos">Expositions</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ============================= HERO ============================= -->
      <section class="r-hero">
        <div class="r-hero-bg" aria-hidden="true">
          <span class="r-brush r-brush-1"></span>
          <span class="r-brush r-brush-2"></span>
          <span class="r-grain"></span>
        </div>
        <div class="wrap r-hero-inner">
          <p class="r-kicker">Peinture — journal d'atelier</p>
          <h1 class="r-hero-title">
            Je peins ce que<br /><em>la lumière oublie.</em>
          </h1>
          <p class="r-hero-lede">
            Claire Aubry, peintre à Nantes. Ici, mes toiles, mes séries en cours et un
            journal d'atelier où j'écris ce que la peinture ne dit pas.
          </p>
          <div class="r-hero-actions">
            <a class="r-btn" href="#oeuvres">Voir les œuvres</a>
            <a class="r-lien" href="#journal">Lire le journal ↓</a>
          </div>
        </div>
      </section>

      <!-- ============================ ŒUVRES ============================= -->
      <section id="oeuvres" class="r-section">
        <div class="wrap">
          <div class="r-section-head reveal">
            <p class="r-kicker">Œuvres récentes</p>
            <h2 class="r-title">Séries 2024 — 2026</h2>
          </div>
          <div class="r-galerie">
            {oeuvres.map((o, i) => (
              <figure class={`r-oeuvre reveal ${o.art}`} style={`--reveal-delay: ${i * 0.1}s`}>
                <div class="r-toile" aria-hidden="true">
                  <span class="t-forme t-1"></span>
                  <span class="t-forme t-2"></span>
                  <span class="t-forme t-3"></span>
                </div>
                <figcaption>
                  <p class="r-oeuvre-titre">{o.titre} <span>· {o.annee}</span></p>
                  <p class="r-oeuvre-tech">{o.technique}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================ JOURNAL ============================ -->
      <section id="journal" class="r-section r-section-papier">
        <div class="wrap">
          <div class="r-section-head reveal">
            <p class="r-kicker r-kicker-sombre">Le journal</p>
            <h2 class="r-title r-title-sombre">Notes d'atelier</h2>
          </div>
          <div class="r-billets">
            {billets.map((b, i) => (
              <article class="r-billet reveal" style={`--reveal-delay: ${i * 0.1}s`}>
                <p class="r-billet-meta">
                  <time>{b.date}</time> · {b.duree} de lecture
                </p>
                <h3>{b.titre}</h3>
                <p class="r-billet-extrait">{b.extrait}</p>
                <span class="r-billet-lien">Lire le billet →</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================= EXPOS ============================= -->
      <section id="expos" class="r-section">
        <div class="wrap">
          <div class="r-section-head reveal">
            <p class="r-kicker">Agenda</p>
            <h2 class="r-title">Expositions à venir</h2>
          </div>
          <ul class="r-expos">
            {expos.map((e, i) => (
              <li class="r-expo reveal" style={`--reveal-delay: ${i * 0.1}s`}>
                <p class="r-expo-dates">{e.dates}</p>
                <div>
                  <h3>{e.nom}</h3>
                  <p>{e.lieu}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ============================ CONTACT ============================ -->
      <section id="contact" class="r-contact">
        <div class="wrap r-contact-inner reveal">
          <h2>Une toile vous parle&nbsp;?</h2>
          <p>
            Pour une acquisition, une commande ou une visite d'atelier, écrivez-moi —
            je réponds à chaque message.
          </p>
          <a class="r-btn r-btn-grand" href="mailto:atelier@claireaubry.example">✉️ atelier@claireaubry.example</a>
          <p class="r-contact-note">Atelier ouvert sur rendez-vous, quartier de la Création, Nantes.</p>
        </div>
      </section>
    </main>

    <footer class="r-footer">
      <div class="wrap r-footer-inner">
        <p>© 2026 Claire Aubry — Toutes les œuvres sont protégées</p>
        <p>Site réalisé par <a href="/">Atelier Web</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Palette du modèle : nuit de galerie, violet et magenta — l'art d'abord. */
  .art {
    --r-nuit: #131020;
    --r-nuit-2: #1c1830;
    --r-violet: #7c5cff;
    --r-magenta: #d84f9a;
    --r-ocre: #e8a33d;
    --r-blanc: #f3f1ea;
    --r-muted: #9b95b5;
    font-family: var(--font-sans);
    color: var(--r-blanc);
    background: var(--r-nuit);
  }

  .wrap {
    width: min(66rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  /* ------------------------------ En-tête ------------------------------- */

  .r-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(19 16 32 / 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(243 241 234 / 0.08);
  }

  .r-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .r-logo {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--r-blanc);
  }

  .r-logo em {
    background: linear-gradient(100deg, var(--r-violet), var(--r-magenta));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .r-nav {
    display: flex;
    gap: 1.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .r-nav a {
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--r-muted);
    transition: color 0.25s;
  }

  .r-nav a:hover {
    color: var(--r-blanc);
  }

  /* ------------------------------ Boutons ------------------------------- */

  .r-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: linear-gradient(100deg, var(--r-violet), var(--r-magenta));
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 24px rgb(124 92 255 / 0.35);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      filter 0.3s;
  }

  .r-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.12);
    box-shadow: 0 12px 30px rgb(124 92 255 / 0.45);
  }

  .r-btn-grand {
    font-size: 1.05rem;
    padding: 0.9rem 2rem;
  }

  .r-lien {
    color: var(--r-muted);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.25s;
  }

  .r-lien:hover {
    color: var(--r-blanc);
  }

  /* -------------------------------- Hero -------------------------------- */

  .r-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 9.5rem);
  }

  .r-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .r-brush {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .r-brush-1 {
    width: 30rem;
    height: 30rem;
    top: -10rem;
    right: -8rem;
    background: radial-gradient(circle, var(--r-violet), transparent 65%);
    animation: float 16s ease-in-out infinite;
  }

  .r-brush-2 {
    width: 24rem;
    height: 24rem;
    bottom: -8rem;
    left: -6rem;
    background: radial-gradient(circle, var(--r-magenta), transparent 65%);
    opacity: 0.35;
    animation: drift 20s ease-in-out infinite;
  }

  .r-grain {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    background-image: radial-gradient(rgb(243 241 234 / 0.06) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  .r-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--r-violet);
  }

  .r-hero-inner {
    position: relative;
    max-width: 44rem;
  }

  .r-hero-inner .r-kicker {
    animation: r-in 0.9s var(--ease-out) both;
  }

  .r-hero-title {
    margin-top: 1.3rem;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.01em;
    animation: r-in 0.9s var(--ease-out) 0.15s both;
  }

  .r-hero-title em {
    font-style: italic;
    background: linear-gradient(100deg, var(--r-violet), var(--r-magenta) 60%, var(--r-ocre));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .r-hero-lede {
    margin-top: 1.4rem;
    font-size: 1.12rem;
    color: var(--r-muted);
    max-width: 34rem;
    animation: r-in 0.9s var(--ease-out) 0.3s both;
  }

  .r-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2.2rem;
    animation: r-in 0.9s var(--ease-out) 0.45s both;
  }

  @keyframes r-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------ Sections ------------------------------ */

  .r-section {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .r-section-head {
    margin-bottom: 2.8rem;
  }

  .r-title {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 500;
  }

  /* Galerie d'œuvres — toiles abstraites en CSS */

  .r-galerie {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.8rem;
  }

  .r-oeuvre {
    margin: 0;
  }

  .r-toile {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
    background: var(--t-fond, #333);
    box-shadow:
      0 0 0 6px var(--r-nuit-2),
      0 0 0 7px rgb(243 241 234 / 0.12),
      0 24px 40px rgb(0 0 0 / 0.5);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }

  .r-oeuvre:hover .r-toile {
    transform: scale(1.03) rotate(-0.5deg);
    box-shadow:
      0 0 0 6px var(--r-nuit-2),
      0 0 0 7px rgb(243 241 234 / 0.25),
      0 30px 50px rgb(0 0 0 / 0.6);
  }

  .t-forme {
    position: absolute;
    transition: transform 0.6s var(--ease-out);
  }

  .r-oeuvre:hover .t-forme {
    transform: scale(1.06);
  }

  /* Quatre compositions abstraites distinctes */

  .art-1 .r-toile {
    --t-fond: linear-gradient(170deg, #16324a 40%, #0d1f2e);
  }

  .art-1 .t-1 {
    inset: 55% -10% -10%;
    background: linear-gradient(180deg, #2e6f8e, #1b4258);
    border-radius: 50% 50% 0 0 / 30% 30% 0 0;
  }

  .art-1 .t-2 {
    top: 18%;
    left: 12%;
    width: 30%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #f3e9c8, #e8a33d);
  }

  .art-1 .t-3 {
    inset: 70% -5% -5%;
    background: rgb(243 241 234 / 0.12);
    border-radius: 60% 40% 0 0 / 40% 60% 0 0;
  }

  .art-2 .r-toile {
    --t-fond: linear-gradient(160deg, #e8b33d 55%, #d99a26);
  }

  .art-2 .t-1 {
    inset: 10% 55% 40% 10%;
    background: #b3402e;
    border-radius: 4px;
    transform: rotate(-4deg);
  }

  .art-2 .t-2 {
    inset: 45% 15% 12% 40%;
    background: #274f8e;
    border-radius: 60% 40% 55% 45% / 55% 45% 60% 40%;
  }

  .art-2 .t-3 {
    top: 20%;
    right: 14%;
    width: 18%;
    height: 18%;
    background: #f3f1ea;
    border-radius: 50%;
  }

  .art-3 .r-toile {
    --t-fond: linear-gradient(180deg, #f3f1ea, #ddd8ca);
  }

  .art-3 .t-1 {
    inset: -5% 44% -5% 42%;
    background: #131020;
    transform: rotate(2deg);
  }

  .art-3 .t-2 {
    inset: -5% 20% -5% 70%;
    background: var(--r-magenta);
    opacity: 0.85;
    transform: rotate(-1.5deg);
  }

  .art-3 .t-3 {
    inset: -5% 68% -5% 18%;
    background: var(--r-violet);
    opacity: 0.7;
    transform: rotate(1deg);
  }

  .art-4 .r-toile {
    --t-fond: linear-gradient(150deg, #2a2438, #131020);
  }

  .art-4 .t-1 {
    inset: 30% 30% 30% 30%;
    border: 3px solid var(--r-ocre);
    border-radius: 50%;
  }

  .art-4 .t-2 {
    inset: 42% 42% 42% 42%;
    background: var(--r-magenta);
    border-radius: 50%;
    filter: blur(6px);
  }

  .art-4 .t-3 {
    inset: 12% 12% 12% 12%;
    border: 1px solid rgb(243 241 234 / 0.2);
    border-radius: 50%;
  }

  .r-oeuvre figcaption {
    margin-top: 1.1rem;
  }

  .r-oeuvre-titre {
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }

  .r-oeuvre-titre span {
    color: var(--r-muted);
    font-size: 0.95rem;
  }

  .r-oeuvre-tech {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--r-muted);
  }

  /* Journal — fond papier clair pour contraster */

  .r-section-papier {
    background: var(--r-blanc);
    color: #22203a;
  }

  .r-kicker-sombre {
    color: var(--r-magenta);
  }

  .r-title-sombre {
    color: #22203a;
  }

  .r-billets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.5rem;
  }

  .r-billet {
    background: #fff;
    border: 1px solid rgb(34 32 58 / 0.1);
    border-radius: 14px;
    padding: 1.8rem 1.6rem;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .r-billet:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 36px rgb(34 32 58 / 0.12);
  }

  .r-billet-meta {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a86a8;
  }

  .r-billet h3 {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .r-billet-extrait {
    margin-top: 0.7rem;
    color: #5d5a78;
    font-size: 0.97rem;
    line-height: 1.65;
    flex-grow: 1;
  }

  .r-billet-lien {
    margin-top: 1.2rem;
    font-weight: 600;
    color: var(--r-magenta);
    font-size: 0.95rem;
  }

  /* Expositions */

  .r-expos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .r-expo {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.4rem 1.6rem;
    border: 1px solid rgb(243 241 234 / 0.12);
    border-radius: 14px;
    background: var(--r-nuit-2);
    transition: border-color 0.3s, transform 0.3s var(--ease-out);
  }

  .r-expo:hover {
    border-color: var(--r-violet);
    transform: translateX(6px);
  }

  .r-expo-dates {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--r-ocre);
  }

  .r-expo h3 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .r-expo p {
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--r-muted);
  }

  /* Contact */

  .r-contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 9vw, 7rem);
    background:
      radial-gradient(50% 90% at 20% 10%, rgb(124 92 255 / 0.18), transparent 60%),
      radial-gradient(50% 90% at 85% 90%, rgb(216 79 154 / 0.15), transparent 60%),
      var(--r-nuit-2);
  }

  .r-contact-inner {
    text-align: center;
    max-width: 40rem;
  }

  .r-contact h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
  }

  .r-contact p {
    margin-top: 1rem;
    color: var(--r-muted);
    font-size: 1.08rem;
  }

  .r-contact .r-btn {
    margin-top: 1.8rem;
  }

  .r-contact-note {
    font-size: 0.9rem !important;
    margin-top: 1.5rem !important;
  }

  /* Footer */

  .r-footer {
    background: #0d0b18;
    color: var(--r-muted);
    font-size: 0.9rem;
  }

  .r-footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.4rem;
  }

  .r-footer a {
    color: var(--r-violet);
    font-weight: 600;
  }

  /* Responsive */

  @media (max-width: 760px) {
    .r-nav {
      display: none;
    }

    .r-expo {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
