---
import Base from '../../layouts/Base.astro';
import DemoBar from '../../components/DemoBar.astro';
import AuroraBackdrop from '../../components/AuroraBackdrop.astro';
import { withBase } from '../../lib/paths';

const title = 'Modèle métiers du bâtiment — Moreau Rénovation | Atelier Web';
const description =
  "Exemple de site vitrine pour artisan du bâtiment : services, réalisations, zone d'intervention et demande de devis. Un modèle Atelier Web robuste et efficace.";

const services = [
  { icon: '🧱', name: 'Maçonnerie', desc: 'Murs, extensions, ouvertures : le gros œuvre dans les règles de l’art.' },
  { icon: '🛠️', name: 'Rénovation complète', desc: 'De la démolition aux finitions, un seul interlocuteur pour tout le chantier.' },
  { icon: '🎨', name: 'Plâtrerie & peinture', desc: 'Cloisons, enduits, peintures : des finitions nettes qui durent.' },
  { icon: '◼️', name: 'Carrelage', desc: 'Pose de carrelage et faïence, intérieur comme extérieur.' },
];

const chiffres = [
  { valeur: '22', unite: 'ans', label: 'd’expérience' },
  { valeur: '340', unite: '+', label: 'chantiers livrés' },
  { valeur: '30', unite: 'km', label: 'zone d’intervention' },
  { valeur: '10', unite: 'ans', label: 'garantie décennale' },
];

const realisations = [
  { tag: 'Rénovation', titre: 'Longère rénovée de A à Z', lieu: 'Cholet', duree: '4 mois' },
  { tag: 'Extension', titre: 'Extension de 35 m² avec baie vitrée', lieu: 'Beaupréau', duree: '9 semaines' },
  { tag: 'Salle de bain', titre: 'Salle de bain clé en main', lieu: 'Chemillé', duree: '3 semaines' },
];
---

<Base title={title} description={description}>
  <DemoBar label="Métiers du bâtiment" />
  <div class="bat">
    <!-- ============================ EN-TÊTE ============================ -->
    <header class="b-header">
      <div class="wrap b-header-inner">
        <a class="b-logo" href="#top" aria-label="Moreau Rénovation — accueil">
          <span class="b-logo-mark" aria-hidden="true">M</span>
          <span>MOREAU<br /><small>Rénovation</small></span>
        </a>
        <nav aria-label="Navigation du site">
          <ul class="b-nav">
            <li><a href="#services">Services</a></li>
            <li><a href="#realisations">Réalisations</a></li>
            <li><a href="#zone">Zone d'intervention</a></li>
          </ul>
        </nav>
        <a class="b-btn b-btn-plein" href="#devis">Devis gratuit</a>
      </div>
      <div class="b-hazard" aria-hidden="true"></div>
    </header>

    <main id="top">
      <!-- ============================= HERO ============================= -->
      <section class="b-hero">
        <div class="b-hero-bg" aria-hidden="true">
          <AuroraBackdrop
            colors={['#f2b705', '#4a6096', '#d97b29']}
            background="#16181f"
            speed={0.8}
            grain={0.06}
          />
          <span class="b-beam b-beam-1"></span>
          <span class="b-beam b-beam-2"></span>
          <span class="b-blueprint"></span>
        </div>
        <div class="wrap b-hero-inner">
          <p class="b-hero-kicker">Maçonnerie — Rénovation — Finitions · Maine-et-Loire</p>
          <h1 class="b-hero-title">
            Du solide,<br />du <span class="b-jaune">propre</span>,<br />dans les délais.
          </h1>
          <p class="b-hero-lede">
            Artisan maçon depuis 2004, j'interviens autour de Cholet pour vos travaux de
            rénovation, d'extension et de gros œuvre. Devis clair, chantier suivi,
            travail garanti.
          </p>
          <div class="b-hero-actions">
            <a class="b-btn b-btn-plein" href="#devis">Demander un devis</a>
            <a class="b-btn b-btn-ligne" href="#realisations">Voir les chantiers</a>
          </div>
          <ul class="b-badges" aria-label="Garanties">
            <li>Garantie décennale</li>
            <li>Assurance Pro BTP</li>
            <li>RGE Qualibat</li>
          </ul>
        </div>
      </section>

      <!-- =========================== CHIFFRES ============================ -->
      <section class="b-chiffres" aria-label="Chiffres clés">
        <div class="wrap b-chiffres-grid">
          {chiffres.map((c, i) => (
            <div class="b-chiffre reveal" style={`--reveal-delay: ${i * 0.08}s`}>
              <p class="b-chiffre-val"><span data-countup={c.valeur}>{c.valeur}</span><span class="b-unite">{c.unite}</span></p>
              <p class="b-chiffre-label">{c.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- =========================== SERVICES ============================ -->
      <section id="services" class="b-section">
        <div class="wrap">
          <p class="b-eyebrow reveal">Savoir-faire</p>
          <h2 class="b-title reveal">Quatre métiers, un seul artisan</h2>
          <div class="b-services">
            {services.map((s, i) => (
              <article class="b-service reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <span class="b-service-icon" aria-hidden="true">{s.icon}</span>
                <h3>{s.name}</h3>
                <p>{s.desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ========================== RÉALISATIONS ========================= -->
      <section id="realisations" class="b-section b-section-sombre">
        <div class="wrap">
          <p class="b-eyebrow reveal">Réalisations</p>
          <h2 class="b-title reveal">Des chantiers qui parlent pour nous</h2>
          <div class="b-realisations">
            {realisations.map((r, i) => (
              <article class="b-realisation reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <div class="b-realisation-visuel" aria-hidden="true">
                  <span class="b-photo-tag">{r.tag}</span>
                  <span class="b-toit"></span>
                  <span class="b-mur"></span>
                  <span class="b-fenetre f-1"></span>
                  <span class="b-fenetre f-2"></span>
                  <span class="b-porte"></span>
                </div>
                <div class="b-realisation-info">
                  <h3>{r.titre}</h3>
                  <p>📍 {r.lieu} · ⏱ {r.duree}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================= ZONE ============================== -->
      <section id="zone" class="b-section">
        <div class="wrap b-zone">
          <div class="reveal">
            <p class="b-eyebrow">Zone d'intervention</p>
            <h2 class="b-title">Autour de Cholet, dans un rayon de 30 km</h2>
            <p class="b-texte">
              Cholet, Beaupréau-en-Mauges, Chemillé-en-Anjou, Sèvremoine, Les Herbiers…
              Vous êtes plus loin&nbsp;? Appelez quand même, on trouve toujours une
              solution.
            </p>
            <ul class="b-villes">
              <li>Cholet</li>
              <li>Beaupréau</li>
              <li>Chemillé</li>
              <li>Sèvremoine</li>
              <li>Les Herbiers</li>
              <li>Mortagne</li>
            </ul>
          </div>
          <div class="b-radar reveal" aria-hidden="true">
            <span class="b-radar-cercle c-1"></span>
            <span class="b-radar-cercle c-2"></span>
            <span class="b-radar-cercle c-3"></span>
            <span class="b-radar-centre">🏠</span>
          </div>
        </div>
      </section>

      <!-- ============================= DEVIS ============================= -->
      <section id="devis" class="b-devis">
        <div class="wrap b-devis-inner reveal">
          <h2>Un projet&nbsp;? Parlons-en sur place.</h2>
          <p>
            Je me déplace gratuitement pour évaluer vos travaux. Devis détaillé sous
            5&nbsp;jours, sans engagement.
          </p>
          <div class="b-devis-actions">
            <a class="b-btn b-btn-sombre" href="tel:+33200000000">📞 02 00 00 00 00</a>
            <a class="b-btn b-btn-ligne-sombre" href="mailto:contact@moreau-renovation.example">✉️ Écrire un e-mail</a>
          </div>
          <p class="b-devis-note">Du lundi au vendredi, 7 h 30 – 18 h. Réponse sous 24 h.</p>
        </div>
      </section>
    </main>

    <footer class="b-footer">
      <div class="wrap b-footer-inner">
        <p>© 2026 Moreau Rénovation — SIRET 000 000 000 00000</p>
        <p>Site réalisé par <a href={withBase()}>Atelier Web</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Palette du modèle : charbon, jaune chantier, robustesse. */
  .bat {
    --b-ink: #22252e;
    --b-ink-deep: #16181f;
    --b-jaune: #f2b705;
    --b-jaune-deep: #d9a404;
    --b-paper: #f4f4f6;
    --b-muted: #666b78;
    font-family: var(--font-sans);
    color: var(--b-ink);
    background: var(--b-paper);
  }

  .wrap {
    width: min(70rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  .b-jaune {
    color: var(--b-jaune);
  }

  /* ------------------------------ En-tête ------------------------------- */

  .b-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(244 244 246 / 0.92);
    backdrop-filter: blur(10px);
  }

  .b-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.75rem;
  }

  .b-hazard {
    height: 6px;
    background: repeating-linear-gradient(
      -45deg,
      var(--b-jaune) 0 14px,
      var(--b-ink) 14px 28px
    );
  }

  .b-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    line-height: 1.05;
    letter-spacing: 0.04em;
  }

  .b-logo small {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-muted);
  }

  .b-logo-mark {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    background: var(--b-ink);
    color: var(--b-jaune);
    font-size: 1.25rem;
    font-weight: 800;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    transition: transform 0.35s var(--ease-out);
  }

  .b-logo:hover .b-logo-mark {
    transform: rotate(14deg);
  }

  .b-header nav {
    margin-left: auto;
  }

  .b-nav {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .b-nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--b-ink);
    border-bottom: 3px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.25s;
  }

  .b-nav a:hover {
    border-color: var(--b-jaune);
  }

  /* ------------------------------ Boutons ------------------------------- */

  .b-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.6rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition:
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out),
      background-color 0.25s;
  }

  .b-btn:hover {
    transform: translateY(-2px);
  }

  .b-btn-plein {
    background: var(--b-jaune);
    color: var(--b-ink-deep);
    box-shadow: 0 6px 16px rgb(242 183 5 / 0.4);
  }

  .b-btn-plein:hover {
    background: var(--b-jaune-deep);
  }

  .b-btn-ligne {
    border: 2px solid rgb(255 255 255 / 0.4);
    color: #fff;
  }

  .b-btn-ligne:hover {
    border-color: var(--b-jaune);
    color: var(--b-jaune);
  }

  .b-btn-sombre {
    background: var(--b-ink-deep);
    color: #fff;
  }

  .b-btn-ligne-sombre {
    border: 2px solid var(--b-ink-deep);
    color: var(--b-ink-deep);
  }

  /* -------------------------------- Hero -------------------------------- */

  .b-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, var(--b-ink-deep), var(--b-ink) 70%, #2c303c);
    color: #fff;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .b-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .b-beam {
    position: absolute;
    height: 10rem;
    width: 150%;
    left: -25%;
    background: linear-gradient(90deg, transparent, rgb(242 183 5 / 0.08), transparent);
    transform: rotate(-12deg);
  }

  .b-beam-1 {
    top: 12%;
    animation: b-slide 12s ease-in-out infinite alternate;
  }

  .b-beam-2 {
    bottom: 8%;
    animation: b-slide 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes b-slide {
    from {
      transform: rotate(-12deg) translateX(-6%);
    }
    to {
      transform: rotate(-12deg) translateX(6%);
    }
  }

  .b-blueprint {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse 90% 80% at 70% 30%, black 20%, transparent 75%);
  }

  .b-hero-inner {
    position: relative;
    max-width: 46rem;
  }

  .b-hero-kicker {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-jaune);
    animation: b-in 0.7s var(--ease-out) both;
  }

  .b-hero-title {
    margin-top: 1.2rem;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    animation: b-in 0.7s var(--ease-out) 0.12s both;
  }

  .b-hero-lede {
    margin-top: 1.4rem;
    font-size: 1.12rem;
    color: rgb(255 255 255 / 0.82);
    max-width: 36rem;
    animation: b-in 0.7s var(--ease-out) 0.24s both;
  }

  .b-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
    animation: b-in 0.7s var(--ease-out) 0.36s both;
  }

  .b-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    margin: 2.4rem 0 0;
    padding: 0;
    animation: b-in 0.7s var(--ease-out) 0.48s both;
  }

  .b-badges li {
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 4px;
    padding: 0.35rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }

  @keyframes b-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------ Chiffres ------------------------------ */

  .b-chiffres {
    background: var(--b-jaune);
    padding-block: 2.2rem;
  }

  .b-chiffres-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    text-align: center;
  }

  .b-chiffre-val {
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--b-ink-deep);
  }

  .b-chiffre-val .b-unite {
    font-size: 1.3rem;
    margin-left: 0.15rem;
  }

  .b-chiffre-label {
    margin-top: 0.3rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: rgb(22 24 31 / 0.75);
  }

  /* ------------------------------ Sections ------------------------------ */

  .b-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .b-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--b-jaune-deep);
  }

  .b-title {
    margin-top: 0.7rem;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .b-texte {
    margin-top: 1rem;
    color: var(--b-muted);
    max-width: 34rem;
  }

  /* Services */

  .b-services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.3rem;
    margin-top: 2.5rem;
  }

  .b-service {
    position: relative;
    background: #fff;
    border: 1px solid rgb(34 37 46 / 0.08);
    border-radius: 10px;
    padding: 1.8rem 1.5rem;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .b-service::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--b-jaune);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out);
  }

  .b-service:hover {
    transform: translateY(-6px);
    box-shadow: 0 14px 30px rgb(34 37 46 / 0.12);
  }

  .b-service:hover::before {
    transform: scaleX(1);
  }

  .b-service-icon {
    font-size: 2rem;
  }

  .b-service h3 {
    margin-top: 0.9rem;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .b-service p {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--b-muted);
  }

  /* Réalisations */

  .b-section-sombre {
    background: var(--b-ink-deep);
    color: #fff;
  }

  .b-section-sombre .b-title {
    color: #fff;
  }

  .b-realisations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .b-realisation {
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition:
      transform 0.35s var(--ease-out),
      border-color 0.35s;
  }

  .b-realisation:hover {
    transform: translateY(-6px);
    border-color: var(--b-jaune);
  }

  /* Illustration maison en CSS */

  .b-realisation-visuel {
    position: relative;
    aspect-ratio: 16 / 10;
    background: linear-gradient(#3d4352, #2c303c 70%, #23262f 70%);
    overflow: hidden;
  }

  .b-photo-tag {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    z-index: 2;
    background: var(--b-jaune);
    color: var(--b-ink-deep);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.7rem;
    border-radius: 4px;
  }

  .b-mur {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 55%;
    height: 46%;
    background: #e8e2d5;
  }

  .b-toit {
    position: absolute;
    bottom: 46%;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 6.5rem solid transparent;
    border-right: 6.5rem solid transparent;
    border-bottom: 3rem solid var(--b-jaune);
    transition: border-bottom-color 0.35s;
  }

  .b-realisation:hover .b-toit {
    border-bottom-color: #ffca1a;
  }

  .b-fenetre {
    position: absolute;
    bottom: 22%;
    width: 12%;
    aspect-ratio: 1;
    background: #9fd8f5;
    border: 3px solid #fff;
  }

  .b-fenetre.f-1 {
    left: 28%;
  }

  .b-fenetre.f-2 {
    right: 28%;
  }

  .b-porte {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 10%;
    height: 24%;
    background: var(--b-ink);
    border-radius: 4px 4px 0 0;
  }

  .b-realisation-info {
    padding: 1.2rem 1.3rem 1.4rem;
  }

  .b-realisation-info h3 {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .b-realisation-info p {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.65);
  }

  /* Zone d'intervention */

  .b-zone {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .b-villes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
  }

  .b-villes li {
    background: #fff;
    border: 1px solid rgb(34 37 46 / 0.12);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .b-radar {
    position: relative;
    aspect-ratio: 1;
    max-width: 22rem;
    margin-inline: auto;
    display: grid;
    place-items: center;
  }

  .b-radar-cercle {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgb(242 183 5 / 0.5);
    animation: b-radar 4s ease-out infinite;
  }

  .b-radar-cercle.c-1 {
    width: 30%;
    height: 30%;
  }

  .b-radar-cercle.c-2 {
    width: 62%;
    height: 62%;
    animation-delay: 1.3s;
  }

  .b-radar-cercle.c-3 {
    width: 94%;
    height: 94%;
    animation-delay: 2.6s;
  }

  @keyframes b-radar {
    0% {
      transform: scale(0.9);
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    100% {
      transform: scale(1.05);
      opacity: 0;
    }
  }

  .b-radar-centre {
    font-size: 3rem;
    filter: drop-shadow(0 8px 10px rgb(34 37 46 / 0.25));
