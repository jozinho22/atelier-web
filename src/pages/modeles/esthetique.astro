---
import Base from '../../layouts/Base.astro';
import DemoBar from '../../components/DemoBar.astro';
import { withBase } from '../../lib/paths';

const title = "Modèle beauté & bien-être — L'Écrin de Soi | Atelier Web";
const description =
  "Exemple de site vitrine pour institut de beauté : soins, tarifs, horaires et réservation par téléphone. Un modèle Atelier Web doux et raffiné.";

const soins = [
  { name: 'Soin visage signature', duree: '1 h 15', prix: '68 €', desc: 'Nettoyage, gommage, modelage et masque adaptés à votre peau.' },
  { name: 'Modelage relaxant', duree: '1 h', prix: '75 €', desc: 'Un moment suspendu, aux huiles chaudes, pour tout relâcher.' },
  { name: 'Beauté du regard', duree: '45 min', prix: '42 €', desc: 'Teinture, rehaussement de cils et restructuration des sourcils.' },
  { name: 'Manucure douceur', duree: '45 min', prix: '39 €', desc: 'Soin des mains complet, pose de vernis classique ou semi-permanent.' },
];

const temoignages = [
  { texte: 'Une parenthèse hors du temps. Aurélie a des mains en or et l’institut est d’une douceur rare.', nom: 'Camille R.' },
  { texte: 'Enfin un institut où l’on se sent écoutée. Le soin visage signature est une merveille.', nom: 'Nadia B.' },
];
---

<Base title={title} description={description}>
  <DemoBar label="Beauté & bien-être" />
  <div class="esth">
    <!-- ============================ EN-TÊTE ============================ -->
    <header class="e-header">
      <div class="wrap e-header-inner">
        <a class="e-logo" href="#top" aria-label="L'Écrin de Soi — accueil">
          L'Écrin <em>de Soi</em>
        </a>
        <nav aria-label="Navigation du site">
          <ul class="e-nav">
            <li><a href="#soins">Les soins</a></li>
            <li><a href="#institut">L'institut</a></li>
            <li><a href="#infos">Horaires</a></li>
          </ul>
        </nav>
        <a class="e-btn" href="tel:+33500000000">Réserver</a>
      </div>
    </header>

    <main id="top">
      <!-- ============================= HERO ============================= -->
      <section class="e-hero">
        <div class="e-hero-deco" aria-hidden="true">
          <span class="e-petale p-1"></span>
          <span class="e-petale p-2"></span>
          <span class="e-petale p-3"></span>
          <span class="e-cercle"></span>
        </div>
        <div class="wrap e-hero-inner">
          <p class="e-kicker">Institut de beauté — Annecy</p>
          <h1 class="e-hero-title">Prendre soin de soi<br /><em>est un art délicat.</em></h1>
          <p class="e-hero-lede">
            Dans un écrin de douceur au cœur d'Annecy, Aurélie vous accueille pour des
            soins sur mesure, aux gestes précis et aux produits naturels.
          </p>
          <div class="e-hero-actions">
            <a class="e-btn" href="tel:+33500000000">☎ Réserver un soin</a>
            <a class="e-lien" href="#soins">Découvrir la carte des soins</a>
          </div>
        </div>
      </section>

      <!-- ============================= SOINS ============================= -->
      <section id="soins" class="e-section">
        <div class="wrap">
          <div class="e-section-head reveal">
            <p class="e-kicker">La carte des soins</p>
            <h2 class="e-title">Des rituels pensés pour vous</h2>
          </div>
          <div class="e-soins">
            {soins.map((s, i) => (
              <article class="e-soin reveal" style={`--reveal-delay: ${i * 0.08}s`}>
                <div class="e-soin-head">
                  <h3>{s.name}</h3>
                  <span class="e-soin-prix">{s.prix}</span>
                </div>
                <p class="e-soin-duree">{s.duree}</p>
                <p class="e-soin-desc">{s.desc}</p>
              </article>
            ))}
          </div>
          <p class="e-soins-note reveal">
            Carte complète disponible à l'institut — chèques cadeaux sur demande.
          </p>
        </div>
      </section>

      <!-- =========================== L'INSTITUT ========================== -->
      <section id="institut" class="e-section e-section-rose">
        <div class="wrap e-institut">
          <div class="e-portrait reveal" aria-hidden="true">
            <span class="e-portrait-arc"></span>
            <span class="e-portrait-visage">🌸</span>
          </div>
          <div class="reveal" style="--reveal-delay: 0.15s">
            <p class="e-kicker">L'institut</p>
            <h2 class="e-title">Un lieu pensé comme une parenthèse</h2>
            <p class="e-texte">
              Diplômée en esthétique et cosmétique depuis douze ans, j'ai imaginé
              L'Écrin de Soi comme un refuge : lumière tamisée, matières naturelles,
              silence feutré. Ici, chaque soin commence par une écoute et se termine
              par un thé.
            </p>
            <p class="e-signature">Aurélie</p>
          </div>
        </div>
      </section>

      <!-- ========================== TÉMOIGNAGES ========================== -->
      <section class="e-section">
        <div class="wrap">
          <div class="e-section-head reveal">
            <p class="e-kicker">Elles en parlent</p>
            <h2 class="e-title">Des instants qui laissent une trace</h2>
          </div>
          <div class="e-temoignages">
            {temoignages.map((t, i) => (
              <blockquote class="e-temoignage reveal" style={`--reveal-delay: ${i * 0.12}s`}>
                <p>« {t.texte} »</p>
                <footer>— {t.nom}</footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <!-- ============================= INFOS ============================= -->
      <section id="infos" class="e-section e-section-creme">
        <div class="wrap e-infos">
          <div class="reveal">
            <p class="e-kicker">Horaires</p>
            <h2 class="e-title">Sur rendez-vous</h2>
            <table class="e-horaires">
              <tbody>
                <tr><th scope="row">Mardi – Vendredi</th><td>9 h 30 – 19 h</td></tr>
                <tr><th scope="row">Samedi</th><td>9 h – 17 h</td></tr>
                <tr><th scope="row">Dimanche – Lundi</th><td>Fermé</td></tr>
              </tbody>
            </table>
          </div>
          <div class="e-reservation reveal" style="--reveal-delay: 0.15s">
            <h3>Réservez votre moment</h3>
            <p>Par téléphone, tout simplement — je vous conseille le soin qui vous ira.</p>
            <a class="e-btn e-btn-grand" href="tel:+33500000000">☎ 05 00 00 00 00</a>
            <p class="e-adresse">
              📍 8 rue du Lac, 74000 Annecy<br />
              ✉️ <a href="mailto:bonjour@ecrindesoi.example">bonjour@ecrindesoi.example</a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="e-footer">
      <div class="wrap e-footer-inner">
        <p>© 2026 L'Écrin de Soi — Institut de beauté</p>
        <p>Site réalisé par <a href={withBase()}>Atelier Web</a></p>
      </div>
    </footer>
  </div>
</Base>

<style>
  /* Palette du modèle : crème, blush, terracotta — élégance feutrée. */
  .esth {
    --e-creme: #fdf8f5;
    --e-rose: #f6e8e2;
    --e-terra: #c98a7d;
    --e-terra-deep: #a96a5d;
    --e-ink: #43312c;
    --e-muted: #8d7a74;
    font-family: var(--font-sans);
    color: var(--e-ink);
    background: var(--e-creme);
    letter-spacing: 0.01em;
  }

  .wrap {
    width: min(66rem, 100% - 2.5rem);
    margin-inline: auto;
  }

  /* ------------------------------ En-tête ------------------------------- */

  .e-header {
    position: sticky;
    top: 2.35rem;
    z-index: 40;
    background: rgb(253 248 245 / 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgb(67 49 44 / 0.07);
  }

  .e-header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .e-logo {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .e-logo em {
    color: var(--e-terra);
  }

  .e-header nav {
    margin-left: auto;
  }

  .e-nav {
    display: flex;
    gap: 1.7rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .e-nav a {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--e-ink);
    position: relative;
    transition: color 0.25s;
  }

  .e-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--e-terra);
    opacity: 0;
    transform: translateX(-50%) scale(0);
    transition:
      opacity 0.25s,
      transform 0.25s var(--ease-out);
  }

  .e-nav a:hover {
    color: var(--e-terra-deep);
  }

  .e-nav a:hover::after {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  /* ------------------------------ Boutons ------------------------------- */

  .e-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    background: var(--e-terra);
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 6px 18px rgb(201 138 125 / 0.35);
    transition:
      transform 0.3s var(--ease-out),
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .e-btn:hover {
    transform: translateY(-2px);
    background: var(--e-terra-deep);
    box-shadow: 0 10px 24px rgb(201 138 125 / 0.45);
  }

  .e-btn-grand {
    font-size: 1.15rem;
    padding: 0.9rem 2rem;
  }

  .e-lien {
    color: var(--e-terra-deep);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.25s;
  }

  .e-lien:hover {
    opacity: 0.7;
  }

  /* -------------------------------- Hero -------------------------------- */

  .e-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 9rem);
    text-align: center;
  }

  .e-hero-deco {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .e-petale {
    position: absolute;
    width: 14rem;
    height: 14rem;
    border-radius: 60% 40% 55% 45% / 55% 45% 60% 40%;
    opacity: 0.5;
    filter: blur(2px);
  }

  .p-1 {
    background: var(--e-rose);
    top: -4rem;
    left: -3rem;
    animation: drift 16s ease-in-out infinite;
  }

  .p-2 {
    background: #f3ded4;
    bottom: -5rem;
    right: -3rem;
    width: 18rem;
    height: 18rem;
    animation: drift 20s ease-in-out infinite reverse;
  }

  .p-3 {
    background: #f9ede4;
    top: 30%;
    right: 12%;
    width: 8rem;
    height: 8rem;
    animation: float 14s ease-in-out infinite;
  }

  .e-cercle {
    position: absolute;
    top: 12%;
    left: 14%;
    width: 10rem;
    height: 10rem;
    border-radius: 50%;
    border: 1px solid rgb(201 138 125 / 0.4);
    animation: float 18s ease-in-out infinite reverse;
  }

  .e-kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--e-terra);
  }

  .e-hero-inner {
    position: relative;
    max-width: 42rem;
  }

  .e-hero-inner .e-kicker {
    animation: e-in 0.9s var(--ease-out) both;
  }

  .e-hero-title {
    margin-top: 1.3rem;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.01em;
    animation: e-in 0.9s var(--ease-out) 0.15s both;
  }

  .e-hero-title em {
    color: var(--e-terra);
  }

  .e-hero-lede {
    margin-top: 1.4rem;
    font-size: 1.12rem;
    color: var(--e-muted);
    animation: e-in 0.9s var(--ease-out) 0.3s both;
  }

  .e-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2.2rem;
    animation: e-in 0.9s var(--ease-out) 0.45s both;
  }

  @keyframes e-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ------------------------------ Sections ------------------------------ */

  .e-section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .e-section-head {
    text-align: center;
    max-width: 38rem;
    margin-inline: auto;
    margin-bottom: 2.8rem;
  }

  .e-title {
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .e-texte {
    margin-top: 1.1rem;
    color: var(--e-muted);
    line-height: 1.75;
  }

  /* Soins */

  .e-soins {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.4rem;
  }

  .e-soin {
    background: #fff;
    border: 1px solid rgb(67 49 44 / 0.08);
    border-radius: 18px;
    padding: 1.8rem 1.7rem;
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .e-soin:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 34px rgb(67 49 44 / 0.1);
  }

  .e-soin-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .e-soin h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .e-soin-prix {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--e-terra-deep);
    white-space: nowrap;
  }

  .e-soin-duree {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--e-muted);
  }

  .e-soin-desc {
    margin-top: 0.8rem;
    color: var(--e-muted);
    font-size: 0.97rem;
    line-height: 1.65;
  }

  .e-soins-note {
    margin-top: 1.8rem;
    text-align: center;
    font-size: 0.92rem;
    color: var(--e-muted);
    font-style: italic;
  }

  /* Institut */

  .e-section-rose {
    background: var(--e-rose);
  }

  .e-institut {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .e-portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    max-width: 20rem;
    margin-inline: auto;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #f9ede4, #f3d8cd);
    border-radius: 50% 50% 18px 18px / 42% 42% 18px 18px;
    overflow: hidden;
  }

  .e-portrait-arc {
    position: absolute;
    inset: 1rem;
    border: 1px solid rgb(201 138 125 / 0.5);
    border-radius: inherit;
  }

  .e-portrait-visage {
    font-size: 4.5rem;
    animation: float 10s ease-in-out infinite;
  }

  .e-signature {
    margin-top: 1.4rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--e-terra-deep);
  }

  /* Témoignages */

  .e-temoignages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .e-temoignage {
    margin: 0;
    background: #fff;
    border: 1px solid rgb(67 49 44 / 0.08);
    border-radius: 18px;
    padding: 1.8rem 1.7rem;
  }

  .e-temoignage p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    font-style: italic;
  }

  .e-temoignage footer {
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--e-terra-deep);
  }

  /* Infos */

  .e-section-creme {
    background: linear-gradient(var(--e-creme), #f9ede4);
  }

  .e-infos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .e-horaires {
    margin-top: 1.6rem;
    border-collapse: collapse;
    width: 100%;
    max-width: 24rem;
  }

  .e-horaires th,
  .e-horaires td {
    text-align: left;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgb(67 49 44 / 0.1);
    font-weight: 500;
  }

  .e-horaires td {
    text-align: right;
    color: var(--e-muted);
  }

  .e-reservation {
    background: #fff;
    border: 1px solid rgb(67 49 44 / 0.08);
    border-radius: 22px;
    padding: 2.2rem 2rem;
    text-align: center;
    box-shadow: 0 14px 34px rgb(67 49 44 / 0.08);
  }

  .e-reservation h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .e-reservation > p {
    margin-top: 0.6rem;
    color: var(--e-muted);
    font-size: 0.97rem;
  }

  .e-reservation .e-btn {
    margin-top: 1.4rem;
  }

  .e-adresse {
    margin-top: 1.6rem;
    font-size: 0.95rem;
    color: var(--e-muted);
    line-height: 1.8;
  }

  .e-adresse a {
    color: var(--e-terra-deep);
  }

  /* Footer */

  .e-footer {
    background: var(--e-ink);
    color: #e8d8d2;
    font-size: 0.9rem;
  }

  .e-footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-block: 1.4rem;
  }

  .e-footer a {
    color: #f3c9bd;
    font-weight: 600;
  }

  /* Responsive */

  @media (max-width: 760px) {
    .e-header nav {
      display: none;
    }

    .e-header-inner {
      justify-content: space-between;
    }

    .e-institut,
    .e-infos {
      grid-template-columns: 1fr;
    }
  }
</style>
