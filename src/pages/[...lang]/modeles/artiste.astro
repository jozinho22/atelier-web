---
import ArtisteDemo from '../../../components/pages/ArtisteDemo.astro';

// Une seule route pour les deux langues : `lang` vaut undefined en français
// (URL à la racine) et 'en' en anglais (URL préfixée par /en/).
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}
