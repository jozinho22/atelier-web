---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Mentions légales — Atelier Web';
const description =
  "Mentions légales du site Atelier Web : éditeur, hébergement et données personnelles.";
---

<Base title={title} description={description}>
  <Header />
  <main class="section">
    <div class="container legal">
      <p class="eyebrow">Informations légales</p>
      <h1 class="section-title">Mentions légales</h1>

      <!-- TODO : compléter avec les informations réelles avant la mise en ligne. -->
      <section>
        <h2>Éditeur du site</h2>
        <p>
          Atelier Web — [Nom Prénom]<br />
          Entrepreneur individuel<br />
          [Adresse]<br />
          SIRET : [à compléter]<br />
          Contact : <a href="mailto:contact@atelier-web.example">contact@atelier-web.example</a> —
          <a href="tel:+33600000000">06 00 00 00 00</a>
        </p>
        <p>Directeur de la publication : [Nom Prénom]</p>
      </section>

      <section>
        <h2>Hébergement</h2>
        <p>
          Ce site est hébergé par :<br />
          [Nom de l'hébergeur]<br />
          [Adresse de l'hébergeur]<br />
          [Téléphone / site web de l'hébergeur]
        </p>
      </section>

      <section>
        <h2>Propriété intellectuelle</h2>
        <p>
          L'ensemble du contenu de ce site (textes, visuels, mise en page) est la
          propriété d'Atelier Web, sauf mention contraire. Toute reproduction, même
          partielle, est soumise à autorisation préalable.
        </p>
      </section>

      <section>
        <h2>Données personnelles</h2>
        <p>
          Ce site ne collecte aucune donnée personnelle : pas de formulaire, pas de
          cookie de suivi, pas d'outil de mesure d'audience. Les échanges se font
          uniquement par e-mail ou téléphone, à votre initiative.
        </p>
        <p>
          Conformément au RGPD, vous pouvez exercer vos droits (accès, rectification,
          suppression) sur les données échangées par e-mail en écrivant à
          <a href="mailto:contact@atelier-web.example">contact@atelier-web.example</a>.
        </p>
      </section>

      <section>
        <h2>Crédits</h2>
        <p>Conception et réalisation : Atelier Web.</p>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 46rem;
  }

  .legal h1 {
    margin-bottom: 1rem;
  }

  .legal section {
    margin-top: 2.4rem;
  }

  .legal h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
  }

  .legal p {
    color: var(--ink-soft);
    line-height: 1.75;
  }

  .legal p + p {
    margin-top: 0.8rem;
  }

  .legal a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
